---
layout: layouts/base.njk
title: ToolsBuilt - Free Online Calculators and Tools
description: Free online calculators and web tools to solve everyday date, time, math, text, and security tasks instantly. No signup required, fast and mobile-friendly.
permalink: /index.html
canonical: https://toolsbuilt.com/
---
{% import "partials/icon.njk" as icons %}
{% import "partials/cards.njk" as cards %}

{% block jsonLd %}
  <!-- JSON-LD Schema 1: Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "ToolsBuilt",
    "url": "https://toolsbuilt.com/",
    "logo": "https://toolsbuilt.com/assets/img/favicon.svg",
    "sameAs": {{ site.social | presentValues | jsonStr }}
  }
  </script>

  <!-- JSON-LD Schema 2: WebSite with SearchAction -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ToolsBuilt",
    "url": "https://toolsbuilt.com/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://toolsbuilt.com/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>

  <!-- JSON-LD Schema 3: FAQPage -->
  <script type="application/ld+json">
  {{ homepageFaq | faqPageSchema | safe }}
  </script>
{% endblock %}

  <!-- Main Content -->
  <main class="container page-container home-page" id="main-content">

    <!-- 1. Hero -->
    <section class="hero-section" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="section-label hero-badge"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg> {{ tools | length | roundDownTo(5) }}+ Free Online Tools</p>
        <h1 id="hero-title" class="hero-title">Free Online Tools.<br><span class="text-accent">Simple</span> Solutions.</h1>
        <p class="hero-subtitle">Fast, private calculators and everyday tools that run in your browser.</p>

        <!-- Search: works as a form; with JavaScript it opens the Ctrl+K palette with the query -->
        <form class="hero-search-box" id="hero-search-form" action="/" method="get" role="search">
          <svg class="hero-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <label for="hero-search-input" class="visually-hidden">Search tools</label>
          <input type="search" id="hero-search-input" name="q" class="hero-search-input" placeholder="Search for a tool, e.g. percentage" autocomplete="off" spellcheck="false">
          <button type="submit" class="hero-search-submit">Search {{ cards.arrow("") }}</button>
        </form>

        <p class="hero-popular">
          <span>Popular:</span>
          {% for tool in tools | filterPopular(4) %}
          <a href="/tools/{{ tool.slug }}/">{{ tool.shortName or tool.name }}</a>
          {% endfor %}
        </p>
      </div>
      <div class="hero-visual">
        {% include "partials/hero-illustration.njk" %}
      </div>
    </section>

    <!-- 2. Categories -->
    <section class="home-section" id="categories" aria-labelledby="categories-title">
      <div class="section-head">
        <div>
          <p class="section-label">Browse Categories</p>
          <h2 id="categories-title" class="section-title">Explore by Category</h2>
          <p class="section-intro">Every tool, grouped by what you need to get done.</p>
        </div>
        <a href="/tools/" class="section-link">View all categories {{ cards.arrow("") }}</a>
      </div>
      <ul class="category-grid">
        {% for cat in categories %}
        <li>{{ cards.categoryCard(cat, (tools | filterByCategory(cat.slug)) | length) }}</li>
        {% endfor %}
      </ul>
    </section>

    <!-- 3. Popular tools -->
    <section class="home-section" id="popular-tools" aria-labelledby="popular-tools-title">
      <div class="section-head">
        <div>
          <p class="section-label">Most Popular</p>
          <h2 id="popular-tools-title" class="section-title">Popular Tools</h2>
          <p class="section-intro">Tools people use every day.</p>
        </div>
        <a href="/tools/" class="section-link">View all tools {{ cards.arrow("") }}</a>
      </div>
      <ul class="tool-grid">
        {% for tool in tools | filterPopular(8) %}
        <li>{{ cards.toolCard(tool, categories | findCategory(tool.category)) }}</li>
        {% endfor %}
      </ul>
    </section>

    <!-- 4. All tools, grouped by category (every tool one click from the homepage) -->
    <section class="home-section" id="all-tools" aria-labelledby="all-tools-title">
      <h2 id="all-tools-title" class="section-title">All Tools</h2>
      <div class="all-tools-groups">
        {% for cat in categories %}
        <div class="all-tools-group" id="cat-{{ cat.slug }}">
          <h3 class="all-tools-group-title"><a href="{{ cat.slug | categoryUrl }}">{{ cat.name }}</a></h3>
          <ul class="all-tools-list">
            {% for tool in tools | filterByCategory(cat.slug) %}
            <li><a href="/tools/{{ tool.slug }}/">{{ tool.name }}</a></li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- 5. Trust strip -->
    <section class="home-section" aria-label="Why ToolsBuilt">
      <ul class="trust-row">
        <li>
          <span class="icon-tile trust-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg></span>
          <span class="trust-text"><strong>Lightning fast</strong><span>Runs in your browser</span></span>
        </li>
        <li>
          <span class="icon-tile trust-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg></span>
          <span class="trust-text"><strong>100% free</strong><span>No hidden charges</span></span>
        </li>
        <li>
          <span class="icon-tile trust-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="17" y1="8" x2="23" y2="8"></line></svg></span>
          <span class="trust-text"><strong>No sign-up required</strong><span>Use any tool instantly</span></span>
        </li>
      </ul>
    </section>

    <!-- 6. FAQ -->
    <section class="home-section faq-section" id="faq" aria-labelledby="faq-title">
      <h2 id="faq-title" class="section-title">Frequently Asked Questions</h2>
      <div class="faq-list">
        {% for item in homepageFaq %}
        <details class="faq-item">
          <summary class="faq-question">
            <span>{{ item.question }}</span>
          </summary>
          <div class="faq-answer">
            <p>{{ item.answer }}</p>
          </div>
        </details>
        {% endfor %}
      </div>
    </section>

  </main>
