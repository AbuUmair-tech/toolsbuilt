    </section>

    <div id="no-results-msg" class="text-center hidden" style="padding: 3rem 1rem;">
      <p style="font-size: 1.1rem; color: var(--text-muted);">No tools found matching your search term.</p>
    </div>

    <!-- Why ToolsBuilt Section -->
    <section class="why-section">
      <h2>Why Use ToolsBuilt?</h2>
      <div class="features-grid">
        <div class="feature-item">
          <div class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <h3>100% Free Always</h3>
          <p>All calculators and web utilities are completely free to use with no hidden fees or limitations.</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <h3>No Signup Required</h3>
          <p>Instant access without accounts, passwords, or personal data collection. Your privacy comes first.</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
