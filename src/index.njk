---
layout: layouts/base.njk
title: ToolsBuilt - Free Online Calculators and Tools
description: Free online calculators and web tools to solve everyday date, time, math, text, and security tasks instantly. No signup required, fast and mobile-friendly.
permalink: /index.html
canonical: https://toolsbuilt.com/
---

{% block jsonLd %}
  <!-- JSON-LD Schema 1: Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "ToolsBuilt",
    "url": "https://toolsbuilt.com/",
    "logo": "https://toolsbuilt.com/assets/img/favicon.svg"
  }
  </script>

  <!-- JSON-LD Schema 2: WebSite with SearchAction -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ToolsBuilt",
    "url": "https://toolsbuilt.com/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://toolsbuilt.com/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>

  <!-- JSON-LD Schema 3: FAQPage -->
  <script type="application/ld+json">
  {{ homepageFaq | faqPageSchema | safe }}
  </script>
{% endblock %}

  <!-- Main Content -->
  <main class="container page-container home-page" id="main-content">

    <!-- 1. Hero -->
    <section class="hero-section" aria-labelledby="hero-title">
      <h1 id="hero-title" class="hero-title">Free Online Calculators &amp; Tools</h1>
      <p class="hero-subtitle">Fast, private calculators and everyday tools that run entirely in your browser.</p>

      <!-- 2. Search: opens the Ctrl+K command palette -->
      <button type="button" class="hero-search-box" id="hero-search-trigger" aria-label="Search {{ tools | length }} calculators and tools">
        <svg class="hero-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="hero-search-placeholder">Search {{ tools | length }} calculators and tools</span>
        <kbd class="hero-search-kbd search-kbd">Ctrl K</kbd>
      </button>
    </section>

    <!-- 3. Categories -->
    <section class="home-section" aria-labelledby="categories-title">
      <h2 id="categories-title" class="section-title">Browse by category</h2>
      <ul class="category-grid">
        {% for cat in categories %}
        {% set catCount = (tools | filterByCategory(cat.slug)) | length %}
        <li>
          <a href="{{ cat.slug | categoryUrl }}" class="category-card">
            <span class="category-card-title">{{ cat.name }}</span>
            <span class="category-card-desc">{{ cat.description }}</span>
            <span class="category-card-count">{{ catCount }} {{ catCount | pluralize('tool') }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </section>

    <!-- 4. Popular tools -->
    <section class="home-section" id="popular-tools" aria-labelledby="popular-tools-title">
      <h2 id="popular-tools-title" class="section-title">Popular tools</h2>
      <ul class="link-list link-list-2col">
        {% for tool in tools | filterPopular(8) %}
        <li>
          <a href="/tools/{{ tool.slug }}/" class="link-list-name">{{ tool.name }}</a>
          <p class="link-list-desc">{{ tool.shortDescription or tool.description }}</p>
        </li>
        {% endfor %}
      </ul>
    </section>

    <!-- 5. All tools, grouped by category (every tool one click from the homepage) -->
    <section class="home-section" id="all-tools" aria-labelledby="all-tools-title">
      <h2 id="all-tools-title" class="section-title">All tools</h2>
      <div class="all-tools-groups">
        {% for cat in categories %}
        <div class="all-tools-group" id="cat-{{ cat.slug }}">
          <h3 class="all-tools-group-title"><a href="{{ cat.slug | categoryUrl }}">{{ cat.name }}</a></h3>
          <ul class="all-tools-list">
            {% for tool in tools | filterByCategory(cat.slug) %}
            <li><a href="/tools/{{ tool.slug }}/">{{ tool.name }}</a></li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- 6. Trust points -->
    <section class="home-section" aria-label="Why ToolsBuilt">
      <ul class="trust-row">
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          <span>Runs in your browser</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>Free with no sign-up</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="5" x2="5" y2="19"></line><circle cx="6.5" cy="6.5" r="2.5"></circle><circle cx="17.5" cy="17.5" r="2.5"></circle></svg>
          <span>Formulas shown on every page</span>
        </li>
      </ul>
    </section>

    <!-- 7. FAQ -->
    <section class="home-section faq-section" id="faq" aria-labelledby="faq-title">
      <h2 id="faq-title" class="section-title">Frequently Asked Questions</h2>
      <div class="faq-list">
        {% for item in homepageFaq %}
        <details class="faq-item">
          <summary class="faq-question">
            <span>{{ item.question }}</span>
          </summary>
          <div class="faq-answer">
            <p>{{ item.answer }}</p>
          </div>
        </details>
        {% endfor %}
      </div>
    </section>

  </main>
