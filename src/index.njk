---
layout: layouts/base.njk
title: ToolsBuilt - Free Online Calculators and Tools
description: Free online calculators and web tools to solve everyday date, time, math, text, and security tasks instantly. No signup required, fast and mobile-friendly.
permalink: /index.html
canonical: https://toolsbuilt.com/
includeToolsData: true
---

{% block jsonLd %}
  <!-- JSON-LD Schema 1: Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "ToolsBuilt",
    "url": "https://toolsbuilt.com/",
    "logo": "https://toolsbuilt.com/assets/img/favicon.svg"
  }
  </script>

  <!-- JSON-LD Schema 2: WebSite with SearchAction -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ToolsBuilt",
    "url": "https://toolsbuilt.com/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://toolsbuilt.com/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
{% endblock %}

  <!-- Main Content -->
  <main class="container" id="main-content">
    
    <!-- Hero Section -->
    <section class="hero">
      <h1>Free Online Calculators &amp; Tools</h1>
      <p>Fast, simple, and privacy-focused web tools designed to make your daily calculations effortless.</p>
      
      <div class="search-box">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" id="tool-search" class="search-input" placeholder="Search tools (e.g. Password Generator, Age Calculator...)" aria-label="Search calculators and tools">
      </div>
    </section>

    <!-- AdSense Placement -->
    <!-- <div class="ad-placement">AdSense Banner Placeholder</div> -->

    <!-- Category 1: Date & Time Tools -->
    <section aria-labelledby="cat-date-time" style="margin-bottom: 3rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
        <div class="tool-icon-tile" data-cat="date-time" style="width: 36px; height: 36px; margin-bottom: 0; border-radius: 10px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <h2 id="cat-date-time" style="margin: 0; font-size: 1.5rem;">Date &amp; Time Tools</h2>
      </div>

      <div class="tools-grid">
        {% set dateTools = tools | filterByCategory("date-time") %}
        {% for tool in dateTools %}
        <a href="/tools/{{ tool.slug }}/" class="tool-card">
          <div class="tool-icon-tile" data-cat="{{ tool.category }}">
            {{ tool.icon | safe }}
          </div>
          <h2>{{ tool.name }}</h2>
          <p>{{ tool.description }}</p>
          <div class="tool-card-action">
            <span>Use Tool</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </div>
        </a>
        {% endfor %}
      </div>
    </section>

    <!-- Category 2: Math & Percentage Tools -->
    <section aria-labelledby="cat-math" style="margin-bottom: 3rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
