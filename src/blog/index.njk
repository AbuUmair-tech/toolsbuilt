---
layout: layouts/base.njk
title: Blog - Guides & Web Tool Tutorials | ToolsBuilt
description: Read practical guides, tutorials, and engineering articles about online calculators, date calculations, text utilities, and client-side privacy.
pagination:
  data: collections.post
  size: 9
  alias: posts
  reverse: true
permalink: "/blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
tags: []
eleventyExcludeFromCollections: true
eleventyComputed:
  canonical: "https://toolsbuilt.com/blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---

{% block jsonLd %}
  <!-- JSON-LD BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://toolsbuilt.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "https://toolsbuilt.com/blog/"
      }
    ]
  }
  </script>

  <!-- JSON-LD Blog / CollectionPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "ToolsBuilt Blog",
    "description": "Guides, tutorials, and insights on calculators, web tools, date arithmetic, and browser privacy.",
    "url": "https://toolsbuilt.com/blog/",
    "publisher": {
      "@type": "Organization",
      "name": "ToolsBuilt",
      "url": "https://toolsbuilt.com/",
      "logo": "https://toolsbuilt.com/assets/img/favicon.svg"
    },
    "hasPart": [
      {% for post in posts %}
      {
        "@type": "BlogPosting",
        "headline": {{ post.data.title | jsonStr | safe }},
        "url": "https://toolsbuilt.com{{ post.url }}",
        "datePublished": "{{ post.date | isoDate }}"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
{% endblock %}

  <!-- Main Content -->
  <main class="container page-container" id="main-content">
    
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">Blog</li>
      </ol>
    </nav>

    <!-- Blog Hero Header -->
    <div class="category-hero-header">
      <div class="category-hero-meta">
        <span class="tool-category-chip" data-cat="tech">Guides &amp; Articles</span>
        <span class="category-count-badge">{{ collections.post | length }} {{ collections.post | length | pluralize('article') }}</span>
      </div>
      <h1 class="category-hero-title">ToolsBuilt Blog</h1>
      <p class="category-hero-intro">In-depth guides, mathematical methodologies, security practices, and engineering insights into building fast, private client-side calculators.</p>
    </div>

    <!-- Blog Posts Grid -->
    <section class="category-tools-section" aria-labelledby="blog-list-heading">
      <div class="section-title-row" style="margin-bottom: var(--space-4);">
        <h2 id="blog-list-heading" class="section-title">Latest Articles</h2>
        <span class="section-badge">{{ collections.post | length }} {{ collections.post | length | pluralize('article') }}</span>
      </div>

      <div class="tools-grid">
        {% for post in posts %}
        <a href="{{ post.url }}" class="tool-card blog-card">
          <div class="tool-card-header">
            <div class="tool-icon-tile" style="background: var(--accent-1); color: var(--accent-primary);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            </div>
            <span class="tool-category-chip" data-cat="tech">{{ post.data.category or "Guides" }}</span>
          </div>
          <h3 class="tool-title" style="font-size: var(--font-size-lg);">{{ post.data.title }}</h3>
          <p class="tool-desc">{{ post.data.description }}</p>
          <div class="blog-card-meta" style="display: flex; gap: var(--space-3); font-size: var(--font-size-xs); color: var(--text-tertiary); margin-top: auto; padding-top: var(--space-3);">
            <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
            <span>&bull;</span>
            <span>{{ post.templateContent | readingTime }}</span>
          </div>
          <div class="tool-card-action">
            <span>Read Guide</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </div>
        </a>
        {% endfor %}
      </div>

      <!-- Pagination Navigation -->
      {% if pagination.pages.length > 1 %}
      <nav class="pagination-nav" aria-label="Blog pagination" style="margin-top: var(--space-10); display: flex; justify-content: center; gap: var(--space-2); align-items: center;">
        {% if pagination.href.previous %}
        <a href="{{ pagination.href.previous }}" class="btn btn-secondary btn-sm" aria-label="Previous page">&larr; Previous</a>
        {% endif %}
        
        <span style="font-size: var(--font-size-sm); color: var(--text-secondary); padding: 0 var(--space-3);">
          Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}
        </span>

        {% if pagination.href.next %}
        <a href="{{ pagination.href.next }}" class="btn btn-secondary btn-sm" aria-label="Next page">Next &rarr;</a>
        {% endif %}
      </nav>
      {% endif %}
    </section>
  </main>
