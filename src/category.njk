---
layout: layouts/base.njk
pagination:
  data: categories
  size: 1
  alias: category
permalink: "/category/{{ category.slug }}/index.html"
eleventyComputed:
  title: "{{ category.seoTitle }}"
  description: "{{ category.seoDescription }}"
  canonical: "https://toolsbuilt.com/category/{{ category.slug }}/"
  breadcrumbTitle: "{{ category.name }}"
---

{% set catTools = tools | filterByCategory(category.slug) %}

{% block jsonLd %}
  <!-- JSON-LD Schema 1: BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://toolsbuilt.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ category.name }}",
        "item": "https://toolsbuilt.com/category/{{ category.slug }}/"
      }
    ]
  }
  </script>

  <!-- JSON-LD Schema 2: CollectionPage + ItemList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "{{ category.name }}",
    "description": "{{ category.seoDescription }}",
    "url": "https://toolsbuilt.com/category/{{ category.slug }}/",
    "mainEntity": {
      "@type": "ItemList",
      "name": "{{ category.name }}",
      "numberOfItems": {{ catTools | length }},
      "itemListElement": [
        {% for t in catTools %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": "{{ t.name }}",
          "description": "{{ t.description }}",
          "url": "https://toolsbuilt.com/tools/{{ t.slug }}/"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  }
  </script>

  {% if category.faqs and category.faqs.length > 0 %}
  <!-- JSON-LD Schema 3: FAQPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for faq in category.faqs %}
      {
        "@type": "Question",
        "name": "{{ faq.question }}",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ faq.answer }}"
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}
{% endblock %}

  <!-- Main Content -->
  <main class="container page-container" id="main-content">
    
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">{{ category.name }}</li>
      </ol>
    </nav>

    <!-- Category Header Hero -->
    <div class="category-hero-header">
      <div class="category-hero-meta">
        <span class="tool-category-chip" data-cat="{{ category.slug }}">{{ category.name }}</span>
        <span class="category-count-badge">{{ catTools | length }} free tools</span>
      </div>
      <h1 class="category-hero-title">Free {{ category.name }}</h1>
      <p class="category-hero-intro">{{ category.intro }}</p>
    </div>

    <!-- Tools Grid -->
    <section class="category-tools-section" aria-labelledby="tools-list-heading">
      <div class="section-title-row" style="margin-bottom: var(--space-4);">
        <h2 id="tools-list-heading" class="section-title">Available {{ category.name }}</h2>
        <span class="section-badge">{{ catTools | length }} tools</span>
      </div>

      <div class="tools-grid">
        {% for tool in catTools %}
        <a href="/tools/{{ tool.slug }}/" class="tool-card" data-slug="{{ tool.slug }}">
          <div class="tool-card-header">
            <div class="tool-icon-tile" data-cat="{{ tool.category }}">
              {{ tool.icon | safe }}
            </div>
            <span class="tool-category-chip" data-cat="{{ tool.category }}">{{ category.name }}</span>
          </div>
          <h3 class="tool-title">{{ tool.name }}</h3>
          <p class="tool-desc">{{ tool.description }}</p>
          <div class="tool-card-action">
            <span>Use Tool</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </div>
        </a>
        {% endfor %}
      </div>
    </section>

    <!-- How to Choose the Right Tool Section -->
    {% if category.howToChoose and category.howToChoose.length > 0 %}
    <section class="category-guide-section" aria-labelledby="guide-title">
      <div class="section-heading">
        <h2 id="guide-title" class="section-title">How to Choose the Right Tool</h2>
        <p class="section-subtitle">Practical advice to quickly match your specific task with the right calculator.</p>
      </div>
      <div class="guide-grid">
        {% for guide in category.howToChoose %}
        <div class="guide-card">
          <h3 class="guide-card-title">{{ guide.title }}</h3>
          <p class="guide-card-desc">{{ guide.description }}</p>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- Frequently Asked Questions -->
    {% if category.faqs and category.faqs.length > 0 %}
    <section class="category-faq-section" aria-labelledby="cat-faq-title">
      <div class="section-heading">
        <h2 id="cat-faq-title" class="section-title">Frequently Asked Questions</h2>
        <p class="section-subtitle">Common questions about accuracy, privacy, and mathematical methodologies.</p>
      </div>
      <div class="faq-list">
        {% for faq in category.faqs %}
        <details class="faq-item">
          <summary class="faq-question">
            <span>{{ faq.question }}</span>
          </summary>
          <div class="faq-answer">
            <p>{{ faq.answer }}</p>
          </div>
        </details>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- Other Categories -->
    <section class="other-categories-section" aria-labelledby="other-cats-title">
      <div class="section-heading">
        <h2 id="other-cats-title" class="section-title">Explore Other Tool Categories</h2>
        <p class="section-subtitle">Discover more free calculators and web utilities across ToolsBuilt.</p>
      </div>
      <div class="other-categories-grid">
        {% for otherCat in categories %}
        {% if otherCat.slug != category.slug %}
        <a href="{{ otherCat.slug | categoryUrl }}" class="category-card other-cat-card" data-cat="{{ otherCat.slug }}">
          <div class="category-card-header">
            <div class="tool-icon-tile" data-cat="{{ otherCat.slug }}">
              {% if otherCat.slug == 'date-time' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              {% elif otherCat.slug == 'math-finance' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line><path d="M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M8 18h.01M12 18h.01"></path></svg>
              {% elif otherCat.slug == 'text' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line></svg>
              {% elif otherCat.slug == 'security' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              {% elif otherCat.slug == 'fun' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3"></circle><line x1="12" y1="2" x2="12" y2="9"></line><line x1="12" y1="15" x2="12" y2="22"></line><line x1="2" y1="12" x2="9" y2="12"></line><line x1="15" y1="12" x2="22" y2="12"></line></svg>
              {% endif %}
            </div>
            <span class="category-count-badge">{{ (tools | filterByCategory(otherCat.slug)) | length }} tools</span>
          </div>
          <h3 class="category-card-title">{{ otherCat.name }}</h3>
          <p class="category-card-desc">{{ otherCat.description }}</p>
        </a>
        {% endif %}
        {% endfor %}
      </div>
    </section>

  </main>
