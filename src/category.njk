---
layout: layouts/base.njk
pagination:
  data: categories
  size: 1
  alias: category
permalink: "/category/{{ category.slug }}/index.html"
eleventyComputed:
  title: "{{ (category | localizeCategory).seoTitle | safe }}"
  description: "{{ (category | localizeCategory).seoDescription | safe }}"
  canonical: "https://toolsbuilt.com/category/{{ category.slug }}/"
  breadcrumbTitle: "{{ (category | localizeCategory).name | safe }}"
---
{% import "partials/cards.njk" as cards with context %}{% set category = category | localizeCategory %}

{% set catTools = tools | filterByCategory(category.slug) %}

{% block jsonLd %}
  <!-- JSON-LD Schema 1: BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://toolsbuilt.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ category.name }}",
        "item": "https://toolsbuilt.com/category/{{ category.slug }}/"
      }
    ]
  }
  </script>

  <!-- JSON-LD Schema 2: CollectionPage + ItemList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "{{ category.name }}",
    "description": "{{ category.seoDescription }}",
    "url": "https://toolsbuilt.com/category/{{ category.slug }}/",
    "mainEntity": {
      "@type": "ItemList",
      "name": "{{ category.name }}",
      "numberOfItems": {{ catTools | length }},
      "itemListElement": [
        {% for t in catTools %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": "{{ t.name }}",
          "description": "{{ t.description }}",
          "url": "https://toolsbuilt.com/tools/{{ t.slug }}/"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  }
  </script>

  {% if category.faqs and category.faqs.length > 0 %}
  <!-- JSON-LD Schema 3: FAQPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for faq in category.faqs %}
      {
        "@type": "Question",
        "name": "{{ faq.question }}",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ faq.answer }}"
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}
{% endblock %}

  <!-- Main Content -->
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        
        <!-- Breadcrumb Navigation -->
        <nav class="breadcrumb" aria-label="{{ 'ariaLabel.tool-nav1' | pt }}">
          <ol>
            <li>{{ 'content.tool.li1' | pt }}</li>
            <li aria-current="page">{{ category.name }}</li>
          </ol>
        </nav>
    
        <!-- Category Header -->
        <div class="category-hero-header">
          <p class="section-label">{{ 'common.tools' | tp(catTools | length) }}</p>
          <div class="page-title-row">
            {{ cards.categoryTile(category, 28, "icon-tile-lg") }}
            <h1 class="category-hero-title">{{ 'title.free' | pt({ name: category.name }) }}</h1>
          </div>
          <p class="category-hero-intro">{{ category.intro }}</p>
        </div>
      </div>
    </section>

    <div class="container page-container">

    <!-- Tool List -->
    <section class="category-tools-section" aria-labelledby="tools-list-heading">
      <p class="section-label">{{ 'content.tool.p1' | pt }}</p>
      <h2 id="tools-list-heading" class="section-title">{{ 'title.available' | pt({ name: category.name }) }}</h2>
      <ul class="tool-grid">
        {% for tool in catTools %}
        <li>{{ cards.toolCard(tool, category) }}</li>
        {% endfor %}
      </ul>
    </section>

    <!-- How to Choose the Right Tool -->
    {% if category.howToChoose and category.howToChoose.length > 0 %}
    <section class="category-guide-section" aria-labelledby="guide-title">
      <p class="section-label">{{ 'content.tool.p2' | pt }}</p>
      <h2 id="guide-title" class="section-title">{{ 'text.guide-title' | pt }}</h2>
      <ul class="guide-list">
        {% for guide in category.howToChoose %}
        <li><strong>{{ guide.title }}:</strong> {{ guide.description }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <!-- Frequently Asked Questions -->
    {% if category.faqs and category.faqs.length > 0 %}
    <section class="category-faq-section" aria-labelledby="cat-faq-title">
      <p class="section-label">{{ 'content.how-to-choose-the-right-tool.p1' | pt }}</p>
      <h2 id="cat-faq-title" class="section-title">{{ 'text.cat-faq-title' | pt }}</h2>
      <div class="faq-list">
        {% for faq in category.faqs %}
        <details class="faq-item">
          <summary class="faq-question">
            <span>{{ faq.question }}</span>
          </summary>
          <div class="faq-answer">
            <p>{{ faq.answer }}</p>
          </div>
        </details>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    </div>
  </main>
