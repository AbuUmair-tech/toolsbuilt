---
layout: layouts/base.njk
---
{% block jsonLd %}
  <!-- JSON-LD BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://toolsbuilt.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ breadcrumbTitle or title }}",
        "item": "{{ canonical or ('https://toolsbuilt.com' + page.url) }}"
      }
    ]
  }
  </script>
  {% if page.url == '/about/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "ToolsBuilt",
    "url": "https://toolsbuilt.com/",
    "logo": "https://toolsbuilt.com/assets/img/favicon.svg"
  }
  </script>
  {% endif %}
{% endblock %}

  <!-- Main Content -->
  <main id="main-content" class="container page-container">
    {% include "partials/breadcrumbs.njk" %}

    <div class="page-header">
      <h1>{{ h1 or title }}</h1>
      {% if subtitle %}<p>{{ subtitle }}</p>{% endif %}
    </div>

    <article class="content-article">
      {{ content | safe }}
    </article>
  </main>
