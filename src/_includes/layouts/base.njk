<!DOCTYPE html>
{% set currentLanguage = lang | languageInfo %}<html lang="{{ currentLanguage.hreflang }}" dir="{{ dir }}"{% if currentLanguage.prefix %} data-locale-prefix="/{{ currentLanguage.prefix }}"{% endif %}{% if currentLanguage.intlLocale %} data-intl-locale="{{ currentLanguage.intlLocale }}"{% endif %}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ canonical or ('https://toolsbuilt.com' + page.url) }}">
  {% if pagination and not noPageLinks and pagination.href.previous %}
  <link rel="prev" href="https://toolsbuilt.com{{ pagination.href.previous }}">
  {% endif %}
  {% if pagination and not noPageLinks and pagination.href.next %}
  <link rel="next" href="https://toolsbuilt.com{{ pagination.href.next }}">
  {% endif %}
  {% if alternates and alternates.length %}
  {% for alt in alternates %}
  <link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.url }}">
  {% endfor %}
  {% endif %}
  {%- for alt in page.url | localeAlternates %}
  <link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ alt.url }}">
  {%- endfor %}
  {% block extraHead %}{% endblock %}
  {% if (not env.isProduction) or noindex or draft %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#090a0f">

  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="alternate" type="application/atom+xml" title="{{ 'base.title.tool-link1' | t }}" href="/feed.xml">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  
  <!-- Open Graph & Social Cards -->
  {% set computedOgImage = ogImage %}{% set ogDir = '' if lang == 'en' else (currentLanguage.prefix + '/') %}
  {% if not computedOgImage %}
    {% if toolSlug %}
      {% set computedOgImage = "https://toolsbuilt.com/assets/og/" + ogDir + toolSlug + ".png" %}
    {% elif category and category.slug %}
      {% set computedOgImage = "https://toolsbuilt.com/assets/og/category-" + category.slug + ".png" %}
    {% elif page.url == "/tools/" %}
      {% set computedOgImage = "https://toolsbuilt.com/assets/og/tools.png" %}
    {% else %}
      {% set computedOgImage = "https://toolsbuilt.com/assets/og/home.png" %}
    {% endif %}
  {% endif %}
  <meta property="og:site_name" content="ToolsBuilt">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ canonical or ('https://toolsbuilt.com' + page.url) }}">
  <meta property="og:image" content="{{ computedOgImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ ogImageAlt or (title + ' - ToolsBuilt') }}">
  <meta property="og:locale" content="{{ currentLanguage.ogLocale }}">
  {%- for alt in page.url | localeAlternates %}{% if alt.ogLocale and alt.ogLocale != currentLanguage.ogLocale %}
  <meta property="og:locale:alternate" content="{{ alt.ogLocale }}">{% endif %}{% endfor %}
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="{{ twitterCard or 'summary_large_image' }}">
  <meta name="twitter:title" content="{{ twitterTitle or ogTitle or title }}">
  <meta name="twitter:description" content="{{ twitterDescription or ogDescription or description }}">
  <meta name="twitter:image" content="{{ computedOgImage }}">
  <meta name="twitter:image:alt" content="{{ ogImageAlt or (title + ' - ToolsBuilt') }}">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg">
  <link rel="alternate icon" href="/assets/img/favicon.ico">
  
  <!-- Preload Critical Font -->
  <link rel="preload" href="/assets/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{% mainCss %}">
  {% if extraCss %}<link rel="stylesheet" href="{{ extraCss }}">{% endif %}

  <!-- Theme restoration script to prevent FOUC -->
  <script>
    (function() {
      try {
        var theme = localStorage.getItem('theme');
        if (theme) {
          document.documentElement.setAttribute('data-theme', theme);
        }
      } catch (e) {}
    })();
  </script>

  {% if lang != 'en' %}<script>window.I18N = {{ [toolSlug, toolScript | toolDir, toolLogic | toolDir, 'salary-tax-calculator' if taxEngine] | clientStrings }};</script>
  {% endif %}{% block jsonLd %}{% endblock %}

  <!-- Google Analytics & Cookie Consent initialization -->
  <script>
    (function () {
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;

      window.initAnalyticsIfConsented = function() {
        if (navigator.doNotTrack === '1' || window.doNotTrack === '1') return;
        try {
          if (localStorage.getItem('tb_cookie_consent') !== 'accepted') return;
        } catch (e) { return; }
        if (window.__ga_loaded) return;
        window.__ga_loaded = true;
        gtag('js', new Date());
        gtag('config', 'G-QR15X9WS1J');
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-QR15X9WS1J';
        document.head.appendChild(s);
      };

      // Try early init if user has previously granted consent
      window.initAnalyticsIfConsented();
    })();
  </script>
</head>
<body{% if toolSlug or slug %} data-tool-id="{{ toolSlug or slug }}"{% endif %}>
  <a href="#main-content" class="skip-link">{{ 'base.content.tool.a1' | t }}</a>

  {% include "partials/header.njk" %}
  {%- include "partials/language-banner.njk" %}

  {{ content | safe }}

  {% include "partials/footer.njk" %}

  <!-- Lightweight Privacy Cookie Consent Banner -->
  <aside id="cookie-consent-banner" class="cookie-banner" role="region" aria-label="{{ 'base.ariaLabel.cookie-consent-banner' | t }}" hidden>
    <div class="cookie-banner-content">
      <div class="cookie-banner-text">
        {{ 'base.content.tool.div1' | t }}
      </div>
      <div class="cookie-banner-actions">
        <button type="button" class="btn btn-sm btn-secondary" id="cookie-reject-btn">{{ 'base.text.cookie-reject-btn' | t }}</button>
        <button type="button" class="btn btn-sm btn-primary" id="cookie-accept-btn">{{ 'base.text.cookie-accept-btn' | t }}</button>
      </div>
    </div>
  </aside>

  <script>
    (function () {
      var banner = document.getElementById('cookie-consent-banner');
      var acceptBtn = document.getElementById('cookie-accept-btn');
      var rejectBtn = document.getElementById('cookie-reject-btn');
      var settingsBtn = document.getElementById('open-cookie-settings');

      function showBanner() {
        if (banner) banner.hidden = false;
      }

      function hideBanner() {
        if (banner) banner.hidden = true;
      }

      try {
        var consent = localStorage.getItem('tb_cookie_consent');
        if (!consent) {
          // If no previous choice, show banner
          showBanner();
        }
      } catch (e) {
        showBanner();
      }

      if (acceptBtn) {
        acceptBtn.addEventListener('click', function () {
          try { localStorage.setItem('tb_cookie_consent', 'accepted'); } catch (e) {}
          hideBanner();
          if (window.initAnalyticsIfConsented) window.initAnalyticsIfConsented();
        });
      }

      if (rejectBtn) {
        rejectBtn.addEventListener('click', function () {
          try { localStorage.setItem('tb_cookie_consent', 'rejected'); } catch (e) {}
          hideBanner();
        });
      }

      if (settingsBtn) {
        settingsBtn.addEventListener('click', function (e) {
          e.preventDefault();
          showBanner();
          if (banner) banner.scrollIntoView({ behavior: 'smooth' });
        });
      }
    })();
  </script>

  <script src="/assets/js/icons.js"></script>
  <script src="/assets/js/ui.js"></script>
  {% if includeToolsData %}<script src="/assets/js/tools-data.js"></script>{% endif %}
  <script src="/assets/js/common.js"></script>
  <script src="/assets/js/layout.js" defer></script>
  <script src="/assets/js/language-menu.js" defer></script>
  {% if toolSlug == "password-generator" %}<script src="/tools/password-generator/eff-words.js"></script>{% endif %}
  {% if taxEngine %}<script src="/tools/salary-tax-calculator/logic.js"></script>{% endif %}
  {% if toolLogic %}<script src="{{ toolLogic }}"></script>{% elif toolSlug %}<script src="/tools/{{ toolSlug }}/logic.js"></script>{% endif %}
  {% if toolScript %}<script src="{{ toolScript }}"></script>{% elif toolSlug %}<script src="/tools/{{ toolSlug }}/script.js"></script>{% endif %}
</body>
</html>
