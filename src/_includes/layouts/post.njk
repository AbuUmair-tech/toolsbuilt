---
layout: layouts/base.njk
---
{% set renderedContent = content | withHeadingIds %}
{% set toc = renderedContent | extractToc %}

{% block jsonLd %}
  <!-- JSON-LD BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'common.home' | t | jsonStr }},
        "item": "https://toolsbuilt.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ 'common.blog' | t | jsonStr }},
        "item": "https://toolsbuilt.com/blog/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ title | jsonStr | safe }},
        "item": "https://toolsbuilt.com{{ page.url }}"
      }
    ]
  }
  </script>

  <!-- JSON-LD BlogPosting -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | jsonStr | safe }},
    "description": {{ description | jsonStr | safe }},
    "url": "https://toolsbuilt.com{{ page.url }}",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://toolsbuilt.com{{ page.url }}"
    },
    "datePublished": "{{ date | isoDate }}",
    "dateModified": "{{ (updated or date) | isoDate }}",
    "image": {{ (ogImage or computedOgImage or "https://toolsbuilt.com/assets/og/home.png") | jsonStr | safe }},
    "author": {
      "@type": "Person",
      "name": {{ (site.authorName or "Abu Umair") | jsonStr | safe }},
      "url": {{ (site.authorUrl or "https://toolsbuilt.com/about/") | jsonStr | safe }}
    },
    "publisher": {
      "@type": "Organization",
      "name": "ToolsBuilt",
      "url": "https://toolsbuilt.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://toolsbuilt.com/assets/img/favicon.svg"
      }
    }
  }
  </script>

  {% if faqs and faqs.length > 0 %}
  <!-- JSON-LD FAQPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for faq in faqs %}
      {
        "@type": "Question",
        "name": {{ (faq.q or faq.question) | jsonStr | safe }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ (faq.a or faq.answer) | jsonStr | safe }}
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}
{% endblock %}

  <!-- Main Content -->
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <!-- Breadcrumb Navigation -->
        <nav class="breadcrumb" aria-label="{{ 'post.ariaLabel.tool-nav1' | t }}">
          <ol>
            <li>{{ 'post.content.tool.li1' | t }}</li>
            <li>{{ 'post.content.tool.li2' | t }}</li>
            <li aria-current="page">{{ shortTitle or title }}</li>
          </ol>
        </nav>

        {% if draft %}
        <!-- Visible DRAFT Banner for Dev / Staging -->
        <div class="alert alert-warning draft-banner" role="alert">
          {{ 'post.content.tool.div1' | t }}
        </div>
        {% endif %}

        <!-- Post Hero Header -->
        <div class="post-hero-header mb-8">
          <div class="category-hero-meta mb-3 flex items-center gap-2">
            <span class="tool-category-chip" data-cat="tech">{{ category or ('post.guide' | t) }}</span>
            <span class="category-count-badge">{{ renderedContent | readingTime }}</span>
          </div>
          <h1 class="tool-hero-title mb-4">{{ title }}</h1>
          {% if description %}
          <p class="tool-hero-description text-md text-secondary mb-4 leading-normal">{{ description }}</p>
          {% endif %}
          <div class="tool-byline flex flex-wrap items-center gap-2 text-tertiary text-sm">
            <span>{{ 'post.content.tool.text1' | t }} <strong>{{ site.authorName or "Abu Umair" }}</strong></span>
            <span>&bull;</span>
            <span>{{ 'post.content.tool.text2' | t }} <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time></span>
            {% if updated and (updated | isoDate) != (date | isoDate) %}
            <span>&bull;</span>
            <span>{{ 'post.content.tool.text3' | t }} <time datetime="{{ updated | isoDate }}">{{ updated | readableDate }}</time></span>
            {% endif %}
            <span>&bull;</span>
            <span>{{ renderedContent | readingTime }}</span>
          </div>
        </div>
      </div>
    </section>

  <div class="container page-container tool-page-layout">
    <div class="tool-page-grid">
      <div class="tool-main-col">

        <!-- Try the tool CTA Box (driven by front matter `tool: <slug>`) -->
        {% if tool %}
          {% set matchedTool = tools | findTool(tool) %}
          {% if matchedTool %}
          <div class="tool-cta-box panel-card mb-8 flex flex-col gap-4">
            <div class="flex items-center gap-4">
              {% set matchedCat = categories | findCategory(matchedTool.category) %}
              <div class="icon-tile" data-color="{{ matchedCat.color if matchedCat else 'blue' }}" aria-hidden="true">
                {{ matchedTool.icon | safe }}
              </div>
              <div>
                <span class="tool-category-chip text-sm mb-1 inline-block" data-cat="{{ matchedTool.category }}">{{ matchedTool.category }}</span>
                <h2 class="text-md m-0 text-primary">{{ 'post.tryTool' | t({ name: matchedTool.name }) }}</h2>
              </div>
            </div>
            <p class="m-0 text-secondary text-sm leading-normal">{{ matchedTool.description }}</p>
            <div>
              <a href="/tools/{{ matchedTool.slug }}/" class="btn btn-primary btn-md">
                <span>{{ 'post.openTool' | t({ name: matchedTool.shortName or matchedTool.name }) }}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </div>
          {% endif %}
        {% endif %}

        <!-- Post Content Body -->
        <article class="content-article post-article">
          {{ renderedContent | safe }}
        </article>

        <!-- FAQs Section (if present) -->
        {% if faqs and faqs.length > 0 %}
        <section class="faq-section mt-12" aria-labelledby="faq-heading">
          <h2 id="faq-heading" class="section-title">{{ 'post.text.faq-heading' | t }}</h2>
          <div class="accordion-group">
            {% for faq in faqs %}
            <details class="faq-item">
              <summary class="faq-question">
                <span>{{ faq.q or faq.question }}</span>
              </summary>
              <div class="faq-answer">
                <p>{{ faq.a or faq.answer }}</p>
              </div>
            </details>
            {% endfor %}
          </div>
        </section>
        {% endif %}

        <!-- Related Posts Section -->
        {% set otherPosts = collections.post | filterOtherPosts(page.url, 2) %}
        {% if otherPosts and otherPosts.length > 0 %}
        <section class="related-posts-section mt-12 pt-8 border-t" aria-labelledby="related-posts-heading">
          <h2 id="related-posts-heading" class="section-title">{{ 'post.text.related-posts-heading' | t }}</h2>
          <div class="tools-grid">
            {% for p in otherPosts %}
            <a href="{{ p.url }}" class="tool-card">
              <div class="tool-card-header">
                <span class="tool-category-chip" data-cat="tech">{{ p.data.category or ('post.guide' | t) }}</span>
                <span class="text-sm text-tertiary">{{ p.templateContent | readingTime }}</span>
              </div>
              <h3 class="tool-title">{{ p.data.title }}</h3>
              <p class="tool-desc">{{ p.data.description }}</p>
              <div class="tool-card-action">
                {{ 'post.content.more-guides-articles.div1' | t }}
              </div>
            </a>
            {% endfor %}
          </div>
        </section>
        {% endif %}

        <!-- Existing Related Tools Partial -->
        {% set toolSlug = tool or "password-generator" %}
        {% include "partials/related-tools.njk" %}
      </div>

      <!-- Desktop Sticky Table of Contents (hidden < 1100px) -->
      {% if toc and toc.length > 0 %}
      <aside class="tool-toc-aside" aria-label="{{ 'post.ariaLabel.more-guides-articles-aside1' | t }}">
        <div class="tool-toc-sticky">
          <div class="sidebar-card">
          <span class="toc-heading">{{ 'post.content.more-guides-articles.span1' | t }}</span>
          <nav class="toc-nav" aria-label="{{ 'post.ariaLabel.more-guides-articles-nav1' | t }}">
            <ul class="toc-list">
              {% for item in toc %}
              <li class="toc-item toc-level-{{ item.level }}">
                <a href="#{{ item.id }}">{{ item.text }}</a>
              </li>
              {% endfor %}
              {% if faqs and faqs.length > 0 %}
              <li>{{ 'post.content.more-guides-articles.li1' | t }}</li>
              {% endif %}
              <li>{{ 'post.content.more-guides-articles.li2' | t }}</li>
            </ul>
          </nav>
          </div>
        </div>
      </aside>
      {% endif %}
    </div>
  </div>
  </main>
