---
layout: layouts/base.njk
---
{% import "partials/cards.njk" as cards with context %}
{% set currentTool = tools | findTool(toolSlug or slug) %}
{% set currentCategory = categories | findCategory(currentTool.category) %}
{# A country page (listed: false) sits under its parent tool: Home > Category > Parent > Country #}
{% set parentTool = (tools | findTool(currentTool.parent)) if currentTool and currentTool.parent else null %}
{% set crumbName = (countryCode | regionName) if countryCode else (currentTool.shortName or currentTool.name or title) %}

{% set authorName = site.authorName or "Abu Umair" %}
{% if site.authorName and site.authorName.includes("TODO_") %}
  {% set authorName = "Abu Umair" %}
{% endif %}

{% set reviewerName = "" %}
{% if site.reviewerName and not site.reviewerName.includes("TODO_") %}
  {% set reviewerName = site.reviewerName %}
{% endif %}

{% block jsonLd %}
  <!-- JSON-LD Schema 1: BreadcrumbList (Home > Category > Tool) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'common.home' | t | jsonStr }},
        "item": "https://toolsbuilt.com/"
      },
      {% if currentCategory %}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ currentCategory.name | jsonStr }},
        "item": "https://toolsbuilt.com/category/{{ currentCategory.slug }}/"
      },
      {% if parentTool %}
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ parentTool.name | jsonStr }},
        "item": "https://toolsbuilt.com/tools/{{ parentTool.slug }}/"
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": {{ crumbName | jsonStr }},
        "item": "https://toolsbuilt.com/tools/{{ currentTool.slug }}/"
      }
      {% else %}
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ (currentTool.name if currentTool else title) | jsonStr }},
        "item": "https://toolsbuilt.com/tools/{{ currentTool.slug if currentTool else (toolSlug or slug) }}/"
      }
      {% endif %}
      {% else %}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ (currentTool.name if currentTool else title) | jsonStr }},
        "item": "https://toolsbuilt.com/tools/{{ currentTool.slug if currentTool else (toolSlug or slug) }}/"
      }
      {% endif %}
    ]
  }
  </script>

  <!-- JSON-LD Schema 2: WebApplication -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": {{ (currentTool.name if currentTool else title) | jsonStr }},
    "url": "https://toolsbuilt.com/tools/{{ currentTool.slug if currentTool else (toolSlug or slug) }}/",
    "applicationCategory": {{ (applicationCategory or 'UtilitiesApplication') | jsonStr }},
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript. Requires HTML5.",
    "description": {{ description | jsonStr }},
    "inLanguage": "en-US",
    "dateModified": {{ ((currentTool.updated if currentTool else '') or '2026-10-15') | jsonStr }},
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "isAccessibleForFree": true,
    {% if areaServed %}"areaServed": { "@type": "Country", "name": {{ areaServed | jsonStr }} },
    {% endif %}    "author": {
      "@type": "Person",
      "name": {{ authorName | jsonStr }},
      "url": {{ site.authorUrl | jsonStr }},
      "sameAs": {{ (site.authorSameAs or []) | jsonStr }}
    },
    "publisher": {
      "@type": "Organization",
      "name": "ToolsBuilt",
      "url": "https://toolsbuilt.com/",
      "logo": "https://toolsbuilt.com/assets/img/favicon.svg"
    }
  }
  </script>

  {% if howto %}
  <!-- JSON-LD Schema 3: HowTo -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": {{ howto.name | jsonStr }},
    "description": {{ howto.description | jsonStr }},
    "step": [
      {% for step in howto.steps %}
      {
        "@type": "HowToStep",
        "position": {{ loop.index }},
        "name": {{ step.name | jsonStr }},
        "text": {{ step.text | jsonStr }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}

  {% if faqs and faqs.length > 0 %}
  <!-- JSON-LD Schema 4: FAQPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for faq in faqs %}
      {
        "@type": "Question",
        "name": {{ (faq.q or faq.question) | jsonStr }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ (faq.a or faq.answer) | jsonStr }}
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}
{% endblock %}

  <!-- Main Content -->
  {% set toolParts = content | splitToolContent %}
  {% set relatedMini = currentTool | getCuratedRelatedTools(tools, 4) %}
  {% set wideTool = currentTool and currentTool.category == "code" %}
  {% set workspace %}
          <!-- The Tool and its Result -->
          <div class="tool-workspace" id="tool">
            <div class="tool-workspace-head">
              <span class="tool-workspace-name">{{ currentTool.shortName or currentTool.name or title }}</span>
              <span class="tool-workspace-tools" id="tool-workspace-tools"></span>
            </div>
            {{ toolParts[0] | safe }}

            <!-- Result Actions Bar (Progressive Enhancement) -->
            <div class="result-actions-bar" id="result-actions-bar" hidden aria-label="{{ 'toolPage.ariaLabel.result-actions-bar' | t }}">
              <button type="button" class="btn btn-sm btn-secondary action-copy-btn" id="action-copy-btn" title="{{ 'toolPage.title.action-copy-btn' | t }}">
                {{ 'toolPage.text.action-copy-btn' | t }}
              </button>
              <button type="button" class="btn btn-sm btn-secondary" id="action-copy-link-btn" title="{{ 'toolPage.title.action-copy-link-btn' | t }}" hidden>
                {{ 'toolPage.text.action-copy-link-btn' | t }}
              </button>
              <button type="button" class="btn btn-sm btn-secondary" id="action-share-btn" title="{{ 'toolPage.title.action-share-btn' | t }}">
                {{ 'toolPage.text.action-share-btn' | t }}
              </button>
              <button type="button" class="btn btn-sm btn-secondary" id="action-print-btn" title="{{ 'toolPage.title.action-print-btn' | t }}">
                {{ 'toolPage.text.action-print-btn' | t }}
              </button>
              <button type="button" class="btn btn-sm btn-secondary action-reset-btn" id="action-reset-btn" title="{{ 'toolPage.title.action-reset-btn' | t }}">
                {{ 'toolPage.text.action-reset-btn' | t }}
              </button>
              <div class="action-toast" id="action-toast" role="status" aria-live="polite" hidden>{{ 'toolPage.text.action-toast' | t }}</div>
            </div>

            <p class="tool-privacy-note">{{ 'toolPage.content.tool.p1' | t }}</p>
          </div>

  {% endset %}
  <main id="main-content" class="tool-page">

    <!-- Hero band: the homepage hero, shortened -->
    <section class="page-hero tool-hero" aria-label="{{ currentTool.name if currentTool else title }}">
      <div class="container">
        <nav class="breadcrumb" aria-label="{{ 'toolPage.ariaLabel.tool-nav1' | t }}">
          <ol>
            <li>{{ 'toolPage.content.tool.li1' | t }}</li>
            {% if currentCategory %}
            <li><a href="{{ currentCategory.slug | categoryUrl }}">{{ currentCategory.name }}</a></li>
            {% endif %}
            {% if parentTool %}
            <li><a href="/tools/{{ parentTool.slug }}/">{{ parentTool.name }}</a></li>
            <li aria-current="page">{{ crumbName }}</li>
            {% else %}
            <li aria-current="page">{{ currentTool.shortName or currentTool.name or title }}</li>
            {% endif %}
          </ol>
        </nav>

        <div class="tool-hero-header">
          {% if currentCategory %}
          <a href="{{ currentCategory.slug | categoryUrl }}" class="category-pill" data-color="{{ currentCategory.color }}">{{ currentCategory.name }}</a>
          {% endif %}
          <div class="page-title-row">
            {% if currentCategory %}<span class="icon-tile icon-tile-lg" data-color="{{ currentCategory.color }}" aria-hidden="true">{{ (currentTool.icon if currentTool and currentTool.icon else '') | safe }}</span>{% endif %}
            <h1 class="tool-hero-title">{{ h1 or (currentTool.name if currentTool else title) }}</h1>
          </div>
          <p class="tool-hero-description">{{ currentTool.description if currentTool else description }}</p>
          <p class="tool-byline">
            {% set updatedTime %}<time datetime="{{ currentTool.updated or '2026-10-15' }}">{{ (currentTool.updated or '2026-10-15') | humanDate }}</time>{% endset %}{{ 'toolPage.byline' | t({ author: authorName, date: updatedTime | safe }) }}
          </p>
          <ul class="hero-chips" aria-label="{{ 'toolPage.ariaLabel.tool-ul1' | t }}">
            <li>{{ 'toolPage.content.tool.li2' | t }}</li>
            <li>{{ 'toolPage.content.tool.li3' | t }}</li>
            <li>{{ 'toolPage.content.tool.li4' | t }}</li>
          </ul>
        </div>
      </div>
    </section>

    <div class="container page-container tool-page-layout">
      {% if wideTool %}<div class="tool-workspace-wide">{{ workspace | safe }}</div>{% endif %}
      <div class="tool-page-grid">
        <div class="tool-main-col">

          {% if not wideTool %}{{ workspace | safe }}{% endif %}

          {% if quickAnswer %}
          <section class="tool-section tool-quick-answer-section" aria-labelledby="quick-answer-heading">
            <p class="section-label">{{ 'toolPage.content.tool.p2' | t }}</p>
            <h2 id="quick-answer-heading">{{ 'toolPage.text.quick-answer-heading' | t }}</h2>
            <div class="quick-answer-card">
              <span class="icon-tile" data-color="blue" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="/assets/icons.svg#icon-sparkles"></use></svg></span>
              <p class="quick-answer-text">{{ quickAnswer }}</p>
            </div>
          </section>
          {% endif %}

          {% if howto and howto.steps and howto.steps.length > 0 %}
          <section class="tool-section tool-howto-section" aria-labelledby="how-to-steps-heading">
            <p class="section-label">{{ 'toolPage.content.quick-answer.p1' | t }}</p>
            <h2 id="how-to-steps-heading">{{ 'toolPage.text.how-to-steps-heading' | t }}</h2>
            <ol class="howto-steps">
              {% for step in howto.steps %}
              <li><strong>{{ step.name }}.</strong> {{ step.text }}</li>
              {% endfor %}
            </ol>
          </section>
          {% endif %}

          {{ toolParts[1] | safe }}

          {% if formula %}
          <section class="tool-section tool-formula-section" aria-labelledby="formula-heading">
            <p class="section-label">{{ 'toolPage.content.how-to-use.p1' | t }}</p>
            <h2 id="formula-heading">{{ formula.title or "Formula & Method" }}</h2>
            <div class="formula-card">
              {% if formula.expression %}
              <div class="formula-expression" role="region" aria-label="{{ 'toolPage.ariaLabel.how-to-use-div1' | t }}" tabindex="0">
                <code>{{ formula.expression }}</code>
              </div>
              {% endif %}
              {% if formula.explanation %}
              <p class="formula-explanation">{{ formula.explanation }}</p>
              {% elif formula is string %}
              <p class="formula-explanation">{{ formula }}</p>
              {% endif %}
              {% if formula.variables and formula.variables.length > 0 %}
              <ul class="formula-variables">
                {% for v in formula.variables %}
                <li><strong>{{ v.name }}:</strong> {{ v.description }}</li>
                {% endfor %}
              </ul>
              {% endif %}
            </div>
          </section>
          {% endif %}

          {% macro workedExample(ex, index) %}
            <div class="worked-example">
              <h3 class="worked-example-title">{{ ex.title or ex.label or ('toolPage.exampleN' | t({ n: index })) }}</h3>
              {% if ex.inputs and ex.inputs.length > 0 %}
              <p class="worked-example-inputs">{{ ex.inputs | join(" · ") }}</p>
              {% endif %}
              {% if ex.before %}
              <p class="worked-example-label">{{ 'toolPage.content.how-to-use.p2' | t }}</p>
              <pre class="code-block" tabindex="0"><code>{{ ex.before }}</code></pre>
              {% endif %}
              {% if ex.after %}
              <p class="worked-example-label">{{ 'toolPage.content.how-to-use.p3' | t }}</p>
              <pre class="code-block" tabindex="0"><code>{{ ex.after }}</code></pre>
              {% endif %}
              {% if ex.steps and ex.steps.length > 0 %}
              <ol class="worked-example-steps">
                {% for step in ex.steps %}
                <li>{{ step }}</li>
                {% endfor %}
              </ol>
              {% endif %}
              {% if ex.result %}
              <p class="worked-example-result"><strong>{{ 'toolPage.content.how-to-use.strong1' | t }}</strong> {{ ex.result }}</p>
              {% endif %}
              {% if ex.link %}
              <p class="worked-example-link"><a href="{{ ex.link }}">{{ ex.linkText or ('toolPage.openExample' | t) }}</a></p>
              {% endif %}
            </div>
          {% endmacro %}

          {% if workedExamples and workedExamples.length > 0 %}
          <section class="tool-section tool-worked-examples" aria-labelledby="worked-examples-heading">
            <p class="section-label">{{ 'toolPage.content.how-to-use.p4' | t }}</p>
            <h2 id="worked-examples-heading">{{ 'toolPage.text.worked-examples-heading' | t }}</h2>
            <div class="worked-example-grid">
              {% for ex in workedExamples %}{{ workedExample(ex, loop.index) }}{% endfor %}
            </div>
          </section>
          {% endif %}

          {% for group in exampleSections %}
          <section class="tool-section tool-worked-examples" aria-labelledby="{{ group.id }}">
            <p class="section-label">{{ 'toolPage.content.worked-examples.p1' | t }}</p>
            <h2 id="{{ group.id }}">{{ group.title }}</h2>
            {% if group.intro %}<p>{{ group.intro }}</p>{% endif %}
            <div class="worked-example-grid">
              {% for ex in group.examples %}{{ workedExample(ex, loop.index) }}{% endfor %}
            </div>
          </section>
          {% endfor %}

          {% if commonMistakes and commonMistakes.length > 0 %}
          <section class="tool-section tool-common-mistakes-section" aria-labelledby="common-mistakes-heading">
            <p class="section-label">{{ 'toolPage.content.worked-examples.p2' | t }}</p>
            <h2 id="common-mistakes-heading">{{ 'toolPage.text.common-mistakes-heading' | t }}</h2>
            <ul class="common-mistakes-list">
              {% for mistake in commonMistakes %}
              <li>
                <span class="icon-tile icon-tile-sm" data-color="orange" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="/assets/icons.svg#icon-warning"></use></svg></span>
                <span class="mistake-text">
                {% if mistake.title %}
                <strong>{{ mistake.title }}:</strong> {{ mistake.description | safe }}
                {% else %}
                {{ mistake }}
                {% endif %}
                </span>
              </li>
              {% endfor %}
            </ul>
          </section>
          {% endif %}

          {% if faqs and faqs.length > 0 %}
          <section class="tool-section faq-section" aria-labelledby="faq-heading">
            <p class="section-label">{{ 'toolPage.content.common-mistakes-to-avoid.p1' | t }}</p>
            <h2 id="faq-heading">{{ 'toolPage.text.faq-heading' | t }}</h2>
            <div class="faq-list">
              {% for faq in faqs %}
              <details class="faq-item">
                <summary class="faq-question">
                  <span>{{ faq.q or faq.question }}</span>
                </summary>
                <div class="faq-answer">
                  <p>{{ faq.a or faq.answer }}</p>
                </div>
              </details>
              {% endfor %}
            </div>
          </section>
          {% endif %}

          {% if sources and sources.length > 0 %}
          <section class="tool-section tool-sources-section" aria-labelledby="sources-heading">
            <p class="section-label">{{ 'toolPage.content.frequently-asked-questions.p1' | t }}</p>
            <h2 id="sources-heading">{{ 'toolPage.text.sources-heading' | t }}</h2>
            <ul class="sources-list">
              {% for src in sources %}
              <li><a href="{{ src.url }}" target="_blank" rel="noopener noreferrer">{{ src.name or src.label }}</a></li>
              {% endfor %}
            </ul>
            {% if lastReviewed %}
            {% set reviewedTime %}<time datetime="{{ lastReviewed }}">{{ lastReviewed | humanDate }}</time>{% endset %}<p class="tool-last-reviewed">{{ 'toolPage.lastReviewed' | t({ date: reviewedTime | safe, author: authorName }) }}</p>
            {% endif %}
          </section>
          {% elif lastReviewed %}
          {% set reviewedTime %}<time datetime="{{ lastReviewed }}">{{ lastReviewed | humanDate }}</time>{% endset %}<p class="tool-last-reviewed">{{ 'toolPage.lastReviewed' | t({ date: reviewedTime | safe, author: authorName }) }}</p>
          {% endif %}

          {% set relatedGuides = collections.post | filterGuidesByTool(slug) %}
          {% if relatedGuides and relatedGuides.length > 0 %}
          <section class="tool-section related-guides-section" aria-labelledby="related-guides-heading">
            <p class="section-label">{{ 'toolPage.content.sources-references.p1' | t }}</p>
            <h2 id="related-guides-heading">{{ 'toolPage.text.related-guides-heading' | t }}</h2>
            <ul class="related-guides-list">
              {% for guide in relatedGuides %}
              <li class="related-guide-item">
                <a href="{{ guide.url }}" class="related-guide-link">
                  <span class="related-guide-title">{{ guide.data.title }}</span>
                  {% if guide.data.description %}
                  <span class="related-guide-desc">{{ guide.data.description }}</span>
                  {% endif %}
                </a>
              </li>
              {% endfor %}
            </ul>
          </section>
          {% endif %}

          {% include "partials/related-tools.njk" %}

        </div>

        <!-- Sidebar (>= 1100px): table of contents, related tools, share -->
        <aside class="tool-toc-aside" aria-label="{{ 'toolPage.ariaLabel.related-guides-aside1' | t }}">
          <div class="tool-toc-sticky">
            <div class="sidebar-card">
              <span class="toc-heading">{{ 'toolPage.content.related-guides.span1' | t }}</span>
              <nav class="toc-nav" aria-label="{{ 'toolPage.ariaLabel.related-guides-nav1' | t }}">
                <ul class="toc-list">
                  <li><a href="#tool">{{ currentTool.shortName or ('toolPage.calculator' | t) }}</a></li>
                  {% if quickAnswer %}<li>{{ 'toolPage.content.related-guides.li1' | t }}</li>{% endif %}
                  {% if howto and howto.steps and howto.steps.length > 0 %}<li>{{ 'toolPage.content.related-guides.li2' | t }}</li>{% endif %}
                  {% if formula %}<li>{{ 'toolPage.content.related-guides.li3' | t }}</li>{% endif %}
                  {% if workedExamples and workedExamples.length > 0 %}<li>{{ 'toolPage.content.related-guides.li4' | t }}</li>{% endif %}
                  {% for group in exampleSections %}<li><a href="#{{ group.id }}">{{ group.title }}</a></li>{% endfor %}
                  {% if commonMistakes and commonMistakes.length > 0 %}<li>{{ 'toolPage.content.related-guides.li5' | t }}</li>{% endif %}
                  {% if faqs and faqs.length > 0 %}<li>{{ 'toolPage.content.related-guides.li6' | t }}</li>{% endif %}
                  {% if sources and sources.length > 0 %}<li>{{ 'toolPage.content.related-guides.li7' | t }}</li>{% endif %}
                  {% if relatedGuides and relatedGuides.length > 0 %}<li>{{ 'toolPage.content.related-guides.li8' | t }}</li>{% endif %}
                  <li>{{ 'toolPage.content.related-guides.li9' | t }}</li>
                </ul>
              </nav>
            </div>

            {% if relatedMini and relatedMini.length > 0 %}
            <div class="sidebar-card">
              <span class="toc-heading">{{ 'toolPage.content.related-guides.span2' | t }}</span>
              <ul class="mini-tool-list">
                {% for rel in relatedMini %}
                {% set relCat = categories | findCategory(rel.category) %}
                <li>
                  <a href="/tools/{{ rel.slug }}/" class="mini-tool-link">
                    <span class="icon-tile icon-tile-sm" data-color="{{ relCat.color if relCat else 'blue' }}" aria-hidden="true">{{ rel.icon | safe }}</span>
                    <span>{{ rel.shortName or rel.name }}</span>
                  </a>
                </li>
                {% endfor %}
              </ul>
            </div>
            {% endif %}

            <div class="sidebar-card">
              <span class="toc-heading">{{ 'toolPage.content.related-guides.span3' | t }}</span>
              <button type="button" class="btn btn-sm btn-secondary sidebar-share-btn" data-copy-page-link>
                {{ 'toolPage.content.related-guides.button1' | t }}
              </button>
            </div>
          </div>
        </aside>
      </div>
    </div>

    {% include "partials/explore-band.njk" %}
  </main>

  <script src="/assets/js/tool-actions.js" defer></script>
