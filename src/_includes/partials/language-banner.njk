{%- if lang == 'en' and (languages | selectattr('enabled') | length) > 1 %}
  <!-- language-banner -->
  <div class="language-banner" id="language-banner" role="region" aria-label="Language suggestion" hidden>
    <div class="container language-banner-inner">
      <svg class="language-menu-globe" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      <p class="language-banner-text">This page is available in <a href="/" class="language-banner-link" dir="auto"></a></p>
      <button type="button" class="icon-btn language-banner-close" id="language-banner-close" aria-label="Dismiss language suggestion">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </div>
  <!-- /language-banner -->
{%- endif %}
