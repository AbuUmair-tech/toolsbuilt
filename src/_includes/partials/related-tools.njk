{% set currentTool = tools | findTool(toolSlug or slug) %}
{% set currentCategory = categories | findCategory(currentTool.category) %}
{% set relTools = currentTool | getCuratedRelatedTools(tools, 4) %}
{% if relTools and relTools.length > 0 %}
<section class="related-tools-section" aria-labelledby="related-tools-heading" style="margin-top: var(--space-12);">
  <div class="section-title-row" style="margin-bottom: var(--space-4); display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: var(--space-2);">
    <h2 id="related-tools-heading" class="section-title" style="margin: 0;">Related Tools</h2>
    {% if currentCategory %}
    <a href="{{ currentCategory.slug | categoryUrl }}" class="view-all-cat-link">View all {{ currentCategory.name }} &rarr;</a>
    {% endif %}
  </div>

  <div class="grid-tools" id="related-tools-grid">
    {% for rel in relTools %}
    <a href="/tools/{{ rel.slug }}/" class="tool-card" data-slug="{{ rel.slug }}">
      <div class="tool-card-header">
        <div class="tool-icon-tile" data-cat="{{ rel.category }}">
          {{ rel.icon | safe }}
        </div>
        <span class="tool-category-chip" data-cat="{{ rel.category }}">{{ (categories | findCategory(rel.category)).name }}</span>
      </div>
      <h3 class="tool-title">{{ rel.name }}</h3>
      <p class="tool-desc">{{ rel.description }}</p>
      <div class="tool-card-action">
        <span>Use Tool</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}
