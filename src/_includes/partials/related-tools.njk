{% import "partials/cards.njk" as cards with context %}
{% set currentTool = tools | findTool(toolSlug or slug) %}
{% set currentCategory = categories | findCategory(currentTool.category) %}
{# Tool pages already list the curated related tools in the sidebar (relatedMini): show others here #}
{% set relTools = (currentTool | moreFromCategory(tools, relatedMini, 4)) if relatedMini else (currentTool | getCuratedRelatedTools(tools, 4)) %}
{% if relTools and relTools.length > 0 %}
<section class="related-tools-section" aria-labelledby="related-tools-heading">
  <div class="section-head">
    <div>
      <p class="section-label">{{ 'relatedTools.content.tool.p1' | t }}</p>
      <h2 id="related-tools-heading" class="section-title">{{ 'relatedTools.text.related-tools-heading' | t }}</h2>
    </div>
    {% if currentCategory %}
    <a href="{{ currentCategory.slug | categoryUrl }}" class="section-link view-all-cat-link">{{ 'relatedTools.viewAll' | t({ name: currentCategory.name }) }} {{ cards.arrow("") }}</a>
    {% endif %}
  </div>

  <ul class="tool-grid" id="related-tools-grid">
    {% for rel in relTools %}
    <li>{{ cards.toolCard(rel, categories | findCategory(rel.category)) }}</li>
    {% endfor %}
  </ul>
</section>
{% endif %}
