{% import "partials/cards.njk" as cards %}
{% set currentTool = tools | findTool(toolSlug or slug) %}
{% set currentCategory = categories | findCategory(currentTool.category) %}
{% set relTools = currentTool | getCuratedRelatedTools(tools, 4) %}
{% if relTools and relTools.length > 0 %}
<section class="related-tools-section" aria-labelledby="related-tools-heading">
  <div class="section-head">
    <div>
      <p class="section-label">More tools</p>
      <h2 id="related-tools-heading" class="section-title">Tools people also use</h2>
    </div>
    {% if currentCategory %}
    <a href="{{ currentCategory.slug | categoryUrl }}" class="section-link view-all-cat-link">View all {{ currentCategory.name }} {{ cards.arrow("") }}</a>
    {% endif %}
  </div>

  <ul class="tool-grid" id="related-tools-grid">
    {% for rel in relTools %}
    <li>{{ cards.toolCard(rel, categories | findCategory(rel.category)) }}</li>
    {% endfor %}
  </ul>
</section>
{% endif %}
