{#- The blog list page, shared by /blog/ (English, paginated) and /<lang>/blog/.
    Expects `posts` (this page's posts) and `allPosts` (every post in the language). -#}
  <!-- JSON-LD BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'common.home' | t | jsonStr }},
        "item": "https://toolsbuilt.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ 'common.blog' | t | jsonStr }},
        "item": "https://toolsbuilt.com/blog/"
      }
    ]
  }
  </script>

  <!-- JSON-LD Blog / CollectionPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ 'blog.index.schemaName' | t | jsonStr }},
    "description": {{ 'blog.index.schemaDescription' | t | jsonStr }},
    "url": "https://toolsbuilt.com/blog/",
    "publisher": {
      "@type": "Organization",
      "name": "ToolsBuilt",
      "url": "https://toolsbuilt.com/",
      "logo": "https://toolsbuilt.com/assets/img/favicon.svg"
    },
    "hasPart": [
      {% for post in posts %}
      {
        "@type": "BlogPosting",
        "headline": {{ post.data.title | jsonStr | safe }},
        "url": "https://toolsbuilt.com{{ post.url }}",
        "datePublished": "{{ post.date | isoDate }}"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>

  <!-- Main Content -->
  <main id="main-content">
    <section class="page-hero">
      <div class="container">

        <!-- Breadcrumb Navigation -->
        <nav class="breadcrumb" aria-label="{{ 'post.ariaLabel.tool-nav1' | t }}">
          <ol>
            <li><a href="/">{{ 'common.home' | t }}</a></li>
            <li aria-current="page">{{ 'common.blog' | t }}</li>
          </ol>
        </nav>

        <!-- Blog Hero Header -->
        <div class="category-hero-header">
          <div class="category-hero-meta section-label">
            <span class="tool-category-chip" data-cat="tech">{{ 'blog.index.chip' | t }}</span>
            <span class="category-count-badge">{{ 'blog.articles' | tp(allPosts | length) }}</span>
          </div>
          <h1 class="category-hero-title">{{ 'blog.index.h1' | t }}</h1>
          <p class="category-hero-intro">{{ 'blog.index.intro' | t }}</p>
        </div>
      </div>
    </section>

    <div class="container page-container">

    <!-- Blog Posts Grid -->
    <section class="category-tools-section" aria-labelledby="blog-list-heading">
      <div class="section-title-row mb-4">
        <h2 id="blog-list-heading" class="section-title">{{ 'blog.index.latest' | t }}</h2>
        <span class="section-badge">{{ 'blog.articles' | tp(allPosts | length) }}</span>
      </div>

      <div class="tools-grid">
        {% for post in posts %}
        <a href="{{ post.url }}" class="tool-card blog-card">
          <div class="tool-card-header">
            <div class="tool-icon-tile blog-card-tile">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            </div>
            <div class="flex gap-2 items-center">
              {% if post.data.draft %}
              <span class="badge badge-draft">{{ 'blog.draft' | t }}</span>
              {% endif %}
              <span class="tool-category-chip" data-cat="tech">{{ post.data.category or ('post.guide' | t) }}</span>
            </div>
          </div>
          <h3 class="tool-title text-md">{{ post.data.title }}</h3>
          <p class="tool-desc">{{ post.data.description }}</p>
          <div class="blog-card-meta">
            <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
            <span>&bull;</span>
            <span>{{ post.templateContent | readingTime }}</span>
          </div>
          <div class="tool-card-action">
            <span>{{ 'blog.index.readGuide' | t }}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </div>
        </a>
        {% endfor %}
      </div>

      <!-- Pagination Navigation -->
      {% if pagination and pagination.pages and pagination.pages.length > 1 %}
      <nav class="pagination-nav mt-12 flex justify-center gap-2 items-center" aria-label="{{ 'blog.index.paginationLabel' | t }}">
        {% if pagination.href.previous %}
        <a href="{{ pagination.href.previous }}" class="btn btn-secondary btn-sm" aria-label="{{ 'blog.index.previousLabel' | t }}">{{ 'blog.index.previous' | t }}</a>
        {% endif %}
        
        <span class="text-sm text-secondary py-0 px-3">
          {{ 'blog.index.page' | t({ current: pagination.pageNumber + 1, total: pagination.pages.length }) }}
        </span>

        {% if pagination.href.next %}
        <a href="{{ pagination.href.next }}" class="btn btn-secondary btn-sm" aria-label="{{ 'blog.index.nextLabel' | t }}">{{ 'blog.index.next' | t }}</a>
        {% endif %}
      </nav>
      {% endif %}
    </section>
    </div>
  </main>
