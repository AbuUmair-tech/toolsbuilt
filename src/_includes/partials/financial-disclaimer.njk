<!-- Reusable Not Financial Advice Disclaimer -->
<div class="financial-disclaimer-callout" role="note" aria-label="{{ 'financialDisclaimer.ariaLabel.tool-div1' | t }}">
  <div class="disclaimer-icon" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
  </div>
  <div class="disclaimer-content">
    <strong class="disclaimer-title">{{ 'financialDisclaimer.content.tool.strong1' | t }}</strong>
    <p class="disclaimer-text">
      {{ 'financialDisclaimer.content.tool.p1' | t }}
    </p>
  </div>
</div>
