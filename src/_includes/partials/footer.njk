  <!-- Site Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <!-- Brand Column -->
        <div class="footer-brand">
          <a href="/" class="site-logo" aria-label="ToolsBuilt Homepage">
            <svg width="28" height="28" viewBox="0 0 100 100" aria-hidden="true" style="width:28px;height:28px;flex-shrink:0;display:block;">
              <rect width="100" height="100" rx="24" fill="#4f46e5"/>
              <path d="M30 30h40v12H56v28H44V42H30V30z" fill="#ffffff"/>
              <circle cx="50" cy="64" r="3" fill="#4f46e5"/>
            </svg>
            <span>Tools<span class="accent">Built</span></span>
          </a>
          <p class="footer-promise">Free online tools and web calculators engineered for simplicity, speed, and precision.</p>
          <div class="footer-privacy-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>Runs in your browser. Your data never leaves your device.</span>
          </div>
        </div>

        <!-- Categories Column -->
        <div class="footer-col">
          <h3 class="footer-heading">Categories</h3>
          <ul class="footer-links">
            {% for cat in categories %}
              <li><a href="{{ cat.slug | categoryUrl }}">{{ cat.name }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <!-- Popular Tools Column -->
        <div class="footer-col">
          <h3 class="footer-heading">Popular Tools</h3>
          <ul class="footer-links">
            {% for t in tools %}
              {% if t.popular %}
                <li><a href="/tools/{{ t.slug }}/">{{ t.shortName or t.name }}</a></li>
              {% endif %}
            {% endfor %}
            <li><a href="/tools/" style="font-weight: 600; color: var(--accent-primary);">View All Tools &rarr;</a></li>
          </ul>
        </div>

        <!-- Company Column -->
        <div class="footer-col">
          <h3 class="footer-heading">Company</h3>
          <ul class="footer-links">
            <li><a href="/tools/">All Tools Directory</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/about/">About Us</a></li>
            <li><a href="/contact/">Contact Us</a></li>
            <li><a href="/contact/">Suggest a Tool</a></li>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/terms/">Terms of Service</a></li>
            <li><a href="/disclaimer/">Disclaimer</a></li>
            <li><a href="/sitemap/">Sitemap</a></li>
            <li><button type="button" class="footer-link-btn" id="open-cookie-settings" style="background:none;border:none;padding:0;font:inherit;color:inherit;cursor:pointer;text-decoration:none;">Cookie Settings</button></li>
          </ul>
        </div>
      </div>

      <!-- Footer Bottom Bar -->
      <div class="footer-bottom">
        <div class="footer-copyright">
          <p>&copy; 2026 ToolsBuilt. All rights reserved. Fast, client-side, privacy-focused calculators.</p>
        </div>

        <div class="footer-actions">
          <button type="button" class="theme-toggle-btn footer-theme-btn" id="footer-theme-toggle" aria-label="Toggle dark mode">
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="5" />
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke-linecap="round"/>
            </svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <span class="footer-theme-text">Theme</span>
          </button>

          <a href="#main-content" class="back-to-top" id="back-to-top" aria-label="Back to top">
            <span>Back to top</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </footer>
