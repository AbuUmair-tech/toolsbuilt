  <!-- Site Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <h3 class="footer-heading">Categories</h3>
          <ul class="footer-links">
            {% for cat in categories %}
              <li><a href="{{ cat.slug | categoryUrl }}">{{ cat.name }}</a></li>
            {% endfor %}
            <li><a href="/tools/">All tools</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="footer-heading">Popular tools</h3>
          <ul class="footer-links">
            {% for t in tools | filterPopular(8) %}
              <li><a href="/tools/{{ t.slug }}/">{{ t.shortName or t.name }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="footer-heading">Company</h3>
          <ul class="footer-links">
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/privacy-policy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
            <li><a href="/disclaimer/">Disclaimer</a></li>
            <li><a href="/sitemap/">Sitemap</a></li>
            <li><button type="button" class="footer-link-btn" id="open-cookie-settings">Cookie Settings</button></li>
          </ul>
        </div>
      </div>

      <p class="footer-copyright">&copy; 2026 ToolsBuilt. All rights reserved. Fast, client-side, privacy-focused calculators.</p>
    </div>
  </footer>
