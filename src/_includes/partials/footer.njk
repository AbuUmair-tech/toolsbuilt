  <!-- Site Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="site-logo" aria-label="{{ 'footer.ariaLabel.tool-a1' | t }}">
            {{ 'footer.content.tool.a1' | t }}
          </a>
          <p class="footer-tagline">{{ 'footer.content.tool.p1' | t }}</p>
          <p class="footer-text">{{ 'footer.content.tool.p2' | t }}</p>
          {% set socialLinks = site.social or {} %}
          {% if socialLinks.github %}
          <ul class="footer-social" aria-label="{{ 'footer.ariaLabel.tool-ul1' | t }}">
            <li>
              <a href="{{ socialLinks.github }}" class="footer-social-link" rel="me noopener" target="_blank" aria-label="{{ 'footer.ariaLabel.tool-a1-2' | t }}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              </a>
            </li>
          </ul>
          {% endif %}
        </div>

        <div class="footer-col">
          <h3 class="footer-heading">{{ 'footer.content.quick-links.heading' | t }}</h3>
          <ul class="footer-links">
            <li>{{ 'footer.content.quick-links.li1' | t }}</li>
            <li>{{ 'footer.content.quick-links.li2' | t }}</li>
            <li>{{ 'footer.content.quick-links.li3' | t }}</li>
            <li>{{ 'footer.content.quick-links.li4' | t }}</li>
            <li>{{ 'footer.content.quick-links.li5' | t }}</li>
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="footer-heading">{{ 'footer.content.resources.heading' | t }}</h3>
          <ul class="footer-links">
            <li>{{ 'footer.content.resources.li1' | t }}</li>
            <li>{{ 'footer.content.resources.li2' | t }}</li>
            <li>{{ 'footer.content.resources.li3' | t }}</li>
            <li>{{ 'footer.content.resources.li4' | t }}</li>
            <li>{{ 'footer.content.resources.li5' | t }}</li>
            <li><button type="button" class="footer-link-btn" id="open-cookie-settings">{{ 'footer.text.open-cookie-settings' | t }}</button></li>
          </ul>
        </div>

        <div class="footer-col">
          <div class="footer-suggest">
            <h3 class="footer-heading">{{ 'footer.content.suggest-a-tool.heading' | t }}</h3>
            <p>{{ 'footer.content.suggest-a-tool.p1' | t }}</p>
            <a href="/contact/" class="btn btn-primary btn-sm">{{ 'footer.content.suggest-a-tool.a1' | t }}</a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="footer-copyright">{{ 'footer.copyright' | t({ year: currentYear }) }}</p>
        <ul class="footer-legal">
          <li>{{ 'footer.content.suggest-a-tool.li1' | t }}</li>
          <li>{{ 'footer.content.suggest-a-tool.li2' | t }}</li>
          <li>{{ 'footer.content.suggest-a-tool.li3' | t }}</li>
        </ul>
      </div>
    </div>
  </footer>
