{#
  "Explore more tools": compact category cards at the bottom of tool and content pages.
#}
{% import "partials/cards.njk" as cards with context %}
<section class="explore-band" aria-labelledby="explore-heading">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="section-label">{{ 'exploreBand.content.tool.p1' | t }}</p>
        <h2 id="explore-heading" class="section-title">{{ 'exploreBand.text.explore-heading' | t }}</h2>
      </div>
      <a href="/tools/" class="section-link">{{ 'common.viewAllTools' | t }} {{ cards.arrow("") }}</a>
    </div>
    <ul class="category-compact-grid">
      {% for cat in categories %}
      {% set count = (tools | filterByCategory(cat.slug)) | length %}
      <li>
        <a href="{{ cat.slug | categoryUrl }}" class="category-compact">
          {{ cards.categoryTile(cat) }}
          <span class="category-compact-body">
            <span class="category-compact-name">{{ cat.name }}</span>
            <span class="category-compact-count">{{ 'common.tools' | tp(count) }}</span>
          </span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
