{% set current = lang | languageInfo %}
        <!-- language-menu -->
        <div class="language-menu" data-language-menu data-current-locale="{{ current.code }}">
          <button type="button" class="language-menu-trigger" id="language-menu-trigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="language-menu-panel" aria-label="{{ 'languageMenu.label' | t }}: {{ current.nativeName }}">
            <svg class="language-menu-globe" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <span class="language-menu-current" dir="auto">{{ current.nativeName }}</span>
            <svg class="nav-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="language-menu-backdrop" data-language-menu-backdrop hidden></div>
          <div class="language-menu-panel" id="language-menu-panel" hidden>
            <div class="language-menu-sheet-header">
              <span class="language-menu-title" id="language-menu-title">{{ 'languageMenu.label' | t }}</span>
              <button type="button" class="icon-btn language-menu-close" data-language-menu-close aria-label="{{ 'languageMenu.close' | t }}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </button>
            </div>
            <div class="language-menu-search">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input type="search" class="language-menu-search-input" id="language-menu-search" placeholder="{{ 'languageMenu.search' | t }}" aria-label="{{ 'languageMenu.search' | t }}" aria-controls="language-options" autocomplete="off" spellcheck="false">
            </div>
            <div id="language-options" class="language-menu-options" role="listbox" tabindex="-1" aria-label="{{ 'languageMenu.label' | t }}">
              {% for l in enabledLanguages %}
              {% set isActive = l.code == current.code %}
              {% set label = l.nativeName if l.nativeName == l.englishName else l.nativeName + ' (' + l.englishName + ')' %}
              <button type="button" class="language-menu-option{% if isActive %} is-active{% endif %}" role="option" aria-selected="{{ 'true' if isActive else 'false' }}" data-locale="{{ l.code }}" data-href="{{ page.url | localeUrl(l.code) }}"{% if not (page.url | hasLocalePage(l.code)) %} data-fallback{% endif %} data-native="{{ l.nativeName }}" data-english="{{ l.englishName }}" lang="{{ l.hreflang }}" tabindex="-1">
                <span class="language-menu-option-label" dir="auto">{{ label }}</span>
                {% if isActive %}<span class="language-menu-check" aria-hidden="true">✓</span>{% endif %}
              </button>
              {% endfor %}
            </div>
            <p class="language-menu-empty" hidden>{{ 'languageMenu.noResults' | t }}</p>
          </div>
          <noscript>
            <ul class="language-menu-links visually-hidden" aria-label="{{ 'languageMenu.label' | t }}">
              {% for l in enabledLanguages %}
              <li><a href="{{ page.url | localeUrl(l.code) }}" hreflang="{{ l.hreflang }}" lang="{{ l.hreflang }}"{% if l.code == current.code %} aria-current="true"{% endif %}>{{ l.nativeName }}</a></li>
              {% endfor %}
            </ul>
          </noscript>
        </div>
        <!-- /language-menu -->
