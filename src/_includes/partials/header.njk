{% import "partials/cards.njk" as cards %}
{% set onTools = page.url and page.url.startsWith('/tools/') %}
{% set onCategory = page.url and page.url.startsWith('/category/') %}
  <!-- Site Header -->
  <header class="site-header" id="site-header">
    <div class="container header-container">
      <a href="/" class="site-logo" aria-label="ToolsBuilt Homepage">
        <svg width="32" height="32" viewBox="0 0 100 100" aria-hidden="true">
          <rect width="100" height="100" rx="26" fill="#2563eb"/>
          <path d="M30 30h40v12H56v28H44V42H30V30z" fill="#ffffff"/>
          <circle cx="50" cy="64" r="3" fill="#2563eb"/>
        </svg>
        <span>ToolsBuilt</span>
      </a>

      <!-- Desktop navigation: dropdowns are <details>, so they work without JavaScript -->
      <nav class="main-nav" id="main-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          <li><a href="/" class="nav-link"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a></li>
          <li>
            <details class="nav-menu" data-nav-menu>
              <summary class="nav-link nav-menu-trigger{% if onTools %} is-active{% endif %}">All Tools <svg class="nav-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg></summary>
              <div class="nav-menu-panel">
                <p class="nav-menu-heading">Popular tools</p>
                <ul class="nav-menu-list">
                  {% for tool in tools | filterPopular(8) %}
                  {% set toolCat = categories | findCategory(tool.category) %}
                  <li>
                    <a href="/tools/{{ tool.slug }}/" class="nav-menu-link"{% if page.url == '/tools/' + tool.slug + '/' %} aria-current="page"{% endif %}>
                      <span class="icon-tile icon-tile-sm" data-color="{{ toolCat.color }}" aria-hidden="true">{{ tool.icon | safe }}</span>
                      <span>{{ tool.name }}</span>
                    </a>
                  </li>
                  {% endfor %}
                </ul>
                <a href="/tools/" class="nav-menu-footer"{% if page.url == '/tools/' %} aria-current="page"{% endif %}>View all tools {{ cards.arrow("") }}</a>
              </div>
            </details>
          </li>
          <li>
            <details class="nav-menu" data-nav-menu>
              <summary class="nav-link nav-menu-trigger{% if onCategory %} is-active{% endif %}">Categories <svg class="nav-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg></summary>
              <div class="nav-menu-panel nav-menu-panel-wide">
                <ul class="nav-menu-list nav-menu-grid">
                  {% for cat in categories %}
                  {% set catCount = (tools | filterByCategory(cat.slug)) | length %}
                  <li>
                    <a href="/category/{{ cat.slug }}/" class="nav-menu-link"{% if page.url == '/category/' + cat.slug + '/' %} aria-current="page"{% endif %}>
                      {{ cards.categoryTile(cat, 18) }}
                      <span class="nav-menu-text"><span>{{ cat.name }}</span><span class="nav-menu-meta">{{ catCount }} {{ "tool" if catCount == 1 else "tools" }}</span></span>
                    </a>
                  </li>
                  {% endfor %}
                </ul>
              </div>
            </details>
          </li>
          <li><a href="/about/" class="nav-link"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a></li>
          <li><a href="/contact/" class="nav-link"{% if page.url == '/contact/' %} aria-current="page"{% endif %}>Contact</a></li>
        </ul>
      </nav>

      <div class="nav-actions">
        <button type="button" class="theme-switch header-theme-btn" id="theme-toggle" aria-label="Toggle dark mode">
          <span class="theme-switch-option theme-switch-light"><svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke-linecap="round"/></svg></span>
          <span class="theme-switch-option theme-switch-dark"><svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></span>
        </button>

        <!-- Search (opens the Ctrl+K palette) -->
        <button type="button" class="icon-btn search-trigger-btn" id="header-search-trigger" aria-label="Search tools (Ctrl+K)" data-search-index="{% searchIndexUrl %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
        <button type="button" class="icon-btn mobile-search-btn" id="mobile-search-trigger" aria-label="Search tools" data-search-index="{% searchIndexUrl %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>

        <button type="button" class="icon-btn mobile-menu-btn" id="mobile-menu-trigger" aria-expanded="false" aria-controls="mobile-drawer" aria-label="Open menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile menu: full-height panel with the same links -->
  <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" hidden></div>
  <div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Menu" hidden>
    <div class="mobile-drawer-header">
      <a href="/" class="site-logo" aria-label="ToolsBuilt Homepage">
        <svg width="32" height="32" viewBox="0 0 100 100" aria-hidden="true">
          <rect width="100" height="100" rx="26" fill="#2563eb"/>
          <path d="M30 30h40v12H56v28H44V42H30V30z" fill="#ffffff"/>
          <circle cx="50" cy="64" r="3" fill="#2563eb"/>
        </svg>
        <span>ToolsBuilt</span>
      </a>
      <button type="button" class="icon-btn drawer-close-btn" id="mobile-drawer-close" aria-label="Close menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="mobile-drawer-body" aria-label="Mobile Navigation">
      <ul class="mobile-menu-list">
        <li><a href="/" class="mobile-drawer-link"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a></li>
        <li><a href="/tools/" class="mobile-drawer-link"{% if page.url == '/tools/' %} aria-current="page"{% endif %}>All Tools</a></li>
      </ul>
      <p class="mobile-menu-heading">Categories</p>
      <ul class="mobile-menu-list">
        {% for cat in categories %}
        {% set catCount = (tools | filterByCategory(cat.slug)) | length %}
        <li>
          <a href="/category/{{ cat.slug }}/" class="mobile-drawer-link mobile-drawer-cat"{% if page.url == '/category/' + cat.slug + '/' %} aria-current="page"{% endif %}>
            {{ cards.categoryTile(cat, 18) }}
            <span class="nav-menu-text"><span>{{ cat.name }}</span><span class="nav-menu-meta">{{ catCount }} {{ "tool" if catCount == 1 else "tools" }}</span></span>
          </a>
        </li>
        {% endfor %}
      </ul>
      <ul class="mobile-menu-list mobile-menu-list-secondary">
        <li><a href="/about/" class="mobile-drawer-link"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a></li>
        <li><a href="/contact/" class="mobile-drawer-link"{% if page.url == '/contact/' %} aria-current="page"{% endif %}>Contact</a></li>
      </ul>
    </nav>

    <div class="mobile-drawer-footer">
      <span>Theme</span>
      <button type="button" class="theme-switch" id="mobile-theme-toggle" aria-label="Toggle dark mode">
        <span class="theme-switch-option theme-switch-light"><svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke-linecap="round"/></svg></span>
        <span class="theme-switch-option theme-switch-dark"><svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></span>
      </button>
    </div>
  </div>

  <!-- Command Palette Search Modal -->
  <div class="search-modal-backdrop" id="search-modal-backdrop" hidden></div>
  <div class="search-modal-dialog" id="search-modal" role="dialog" aria-modal="true" aria-labelledby="palette-title" hidden>
    <div class="search-modal-card">
      <div class="search-modal-header">
        <div id="palette-title" class="visually-hidden">Search Tools</div>
        <svg class="search-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="palette-input"
          class="palette-input"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="palette-results"
          aria-activedescendant=""
          placeholder="Search tools by name, topic, or keyword..."
          autocomplete="off"
          spellcheck="false"
        >
        <button type="button" class="palette-close-btn" id="palette-close-btn" aria-label="Close search dialog">
          <kbd>ESC</kbd>
        </button>
      </div>

      <div class="search-modal-body" id="palette-body">
        <ul id="palette-results" class="palette-results-list" role="listbox" aria-label="Search results"></ul>
        
        <!-- Empty State Container -->
        <div id="palette-empty-state" class="palette-empty-state">
          <div id="palette-recent-section" class="palette-section" hidden>
            <div class="palette-section-header">
              <span class="palette-section-title">Recent Tools</span>
              <button type="button" class="palette-clear-btn" id="palette-clear-recents" aria-label="Clear recent tools">Clear</button>
            </div>
            <ul id="palette-recent-list" class="palette-section-list"></ul>
          </div>

          <div id="palette-popular-section" class="palette-section">
            <div class="palette-section-header">
              <span class="palette-section-title">Popular Tools</span>
            </div>
            <ul id="palette-popular-list" class="palette-section-list">
              {% for t in tools %}
                {% if t.popular %}
                  <li>
                    <a href="/tools/{{ t.slug }}/" class="palette-item-link" data-slug="{{ t.slug }}">
                      <span class="palette-item-cat">{{ t.category }}</span>
                      <span class="palette-item-name">{{ t.name }}</span>
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>

        <!-- No Results Container -->
        <div id="palette-no-results" class="palette-no-results" hidden>
          <p class="no-results-text">No tools found matching your search.</p>
          <p class="no-results-subtext">Missing a calculator? <a href="/contact/" class="suggest-tool-link">Suggest a tool</a> and we'll build it.</p>
        </div>
      </div>

      <div class="search-modal-footer">
        <span class="palette-shortcut-hint"><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
        <span class="palette-shortcut-hint"><kbd>↵</kbd> Select</span>
        <span class="palette-shortcut-hint"><kbd>ESC</kbd> Close</span>
      </div>
    </div>
  </div>
