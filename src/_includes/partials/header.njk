  <!-- Site Header -->
  <header class="site-header" id="site-header">
    <div class="container header-container">
      <a href="/" class="site-logo" aria-label="ToolsBuilt Homepage">
        <svg width="32" height="32" viewBox="0 0 100 100" aria-hidden="true" style="width:32px;height:32px;flex-shrink:0;display:block;">
          <rect width="100" height="100" rx="24" fill="#4f46e5"/>
          <path d="M30 30h40v12H56v28H44V42H30V30z" fill="#ffffff"/>
          <circle cx="50" cy="64" r="3" fill="#4f46e5"/>
        </svg>
        <span>Tools<span class="accent">Built</span></span>
      </a>

      <!-- Desktop Primary Navigation -->
      <nav class="main-nav" id="main-nav" aria-label="Main Navigation">
        <!-- Tools Mega-Menu Dropdown -->
        <div class="nav-item-dropdown" id="tools-mega-menu-wrapper">
          <button type="button" class="nav-link nav-dropdown-btn" id="mega-menu-trigger" aria-expanded="false" aria-controls="tools-mega-menu" aria-haspopup="true">
            <span>Tools</span>
            <svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="mega-menu-panel" id="tools-mega-menu" role="region" aria-label="Tools by Category" hidden>
            <div class="mega-menu-grid">
              {% for cat in categories %}
                <div class="mega-menu-col">
                  <a href="{{ cat.slug | categoryUrl }}" class="mega-menu-cat-header">
                    <span class="mega-menu-cat-title">{{ cat.name }}</span>
                  </a>
                  <p class="mega-menu-cat-desc">{{ cat.description }}</p>
                  <ul class="mega-menu-tool-list">
                    {% set catTools = tools | filterByCategory(cat.slug) %}
                    {% for tool in catTools.slice(0, 6) %}
                      <li>
                        <a href="/tools/{{ tool.slug }}/" class="mega-menu-tool-link{% if page.url == '/tools/' + tool.slug + '/' %} active{% endif %}"{% if page.url == '/tools/' + tool.slug + '/' %} aria-current="page"{% endif %}>
                          {{ tool.shortName or tool.name }}
                        </a>
                      </li>
                    {% endfor %}
                    <li>
                      <a href="{{ cat.slug | categoryUrl }}" class="mega-menu-cat-all-link">
                        View all {{ cat.name }} &rarr;
                      </a>
                    </li>
                  </ul>
                </div>
              {% endfor %}
            </div>
            <div class="mega-menu-footer">
              <a href="/tools/" class="mega-menu-view-all">
                <span>View all tools directory &rarr;</span>
              </a>
            </div>
          </div>
        </div>

        <a href="/about/" class="nav-link{% if page.url == '/about/' %} active{% endif %}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
        <a href="/blog/" class="nav-link{% if page.url and page.url.startsWith('/blog/') %} active{% endif %}"{% if page.url and page.url.startsWith('/blog/') %} aria-current="page"{% endif %}>Blog</a>
      </nav>

      <!-- Header Actions -->
      <div class="nav-actions">
        <!-- Search Trigger Button -->
        <button type="button" class="search-trigger-btn" id="header-search-trigger" data-search-index="{% searchIndexUrl %}">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="search-trigger-text">Search tools...</span>
          <kbd class="search-kbd" id="search-kbd">Ctrl K</kbd>
        </button>

        {% if site.githubUrl or site.repoUrl %}
        <a href="{{ site.githubUrl or site.repoUrl }}" class="nav-icon-link" aria-label="GitHub Repository" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
        {% endif %}

        <!-- Theme Toggle Button -->
        <button type="button" class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle dark mode">
          <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5" />
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke-linecap="round"/>
          </svg>
          <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

        <!-- Mobile Drawer Hamburger Button -->
        <button type="button" class="mobile-menu-btn" id="mobile-menu-trigger" aria-expanded="false" aria-controls="mobile-drawer" aria-label="Open mobile navigation menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" hidden></div>
  <div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation" hidden>
    <div class="mobile-drawer-header">
      <a href="/" class="site-logo" aria-label="ToolsBuilt Homepage">
        <svg width="32" height="32" viewBox="0 0 100 100" aria-hidden="true" style="width:32px;height:32px;flex-shrink:0;display:block;">
          <rect width="100" height="100" rx="24" fill="#4f46e5"/>
          <path d="M30 30h40v12H56v28H44V42H30V30z" fill="#ffffff"/>
          <circle cx="50" cy="64" r="3" fill="#4f46e5"/>
        </svg>
        <span>Tools<span class="accent">Built</span></span>
      </a>
      <button type="button" class="drawer-close-btn" id="mobile-drawer-close" aria-label="Close navigation menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="mobile-drawer-body">
      <!-- Search button inside drawer -->
      <button type="button" class="mobile-drawer-search-btn" id="mobile-search-trigger" aria-label="Search tools" data-search-index="{% searchIndexUrl %}">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>Search tools...</span>
        <kbd class="search-kbd">Ctrl K</kbd>
      </button>

      <!-- Categories Accordion -->
      <nav class="mobile-drawer-nav" aria-label="Mobile Categories Navigation">
        <div class="mobile-accordions">
          {% for cat in categories %}
            <div class="mobile-accordion-item">
              <button type="button" class="mobile-accordion-trigger" id="mobile-cat-btn-{{ cat.slug }}" aria-expanded="false" aria-controls="mobile-cat-panel-{{ cat.slug }}">
                <span>{{ cat.name }}</span>
                <svg class="accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="mobile-accordion-content" id="mobile-cat-panel-{{ cat.slug }}" hidden>
                <ul>
                  {% set catTools = tools | filterByCategory(cat.slug) %}
                  {% for tool in catTools.slice(0, 6) %}
                    <li>
                      <a href="/tools/{{ tool.slug }}/" class="mobile-tool-link{% if page.url == '/tools/' + tool.slug + '/' %} active{% endif %}"{% if page.url == '/tools/' + tool.slug + '/' %} aria-current="page"{% endif %}>
                        {{ tool.shortName or tool.name }}
                      </a>
                    </li>
                  {% endfor %}
                  <li>
                    <a href="{{ cat.slug | categoryUrl }}" class="mobile-cat-all-link">
                      View all {{ cat.name }} &rarr;
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="mobile-drawer-links">
          <a href="/blog/" class="mobile-drawer-link{% if page.url and page.url.startsWith('/blog/') %} active{% endif %}"{% if page.url and page.url.startsWith('/blog/') %} aria-current="page"{% endif %}>Blog</a>
          <a href="/about/" class="mobile-drawer-link{% if page.url == '/about/' %} active{% endif %}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
          <a href="/contact/" class="mobile-drawer-link{% if page.url == '/contact/' %} active{% endif %}"{% if page.url == '/contact/' %} aria-current="page"{% endif %}>Contact</a>
        </div>
      </nav>
    </div>

    <div class="mobile-drawer-footer">
      <div class="mobile-drawer-theme">
        <span>Theme</span>
        <button type="button" class="theme-toggle-btn" id="mobile-theme-toggle" aria-label="Toggle dark mode">
          <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5" />
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke-linecap="round"/>
          </svg>
          <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Command Palette Search Modal -->
  <div class="search-modal-backdrop" id="search-modal-backdrop" hidden></div>
  <div class="search-modal-dialog" id="search-modal" role="dialog" aria-modal="true" aria-labelledby="palette-title" hidden>
    <div class="search-modal-card">
      <div class="search-modal-header">
        <div id="palette-title" class="visually-hidden">Search Tools</div>
        <svg class="search-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="palette-input"
          class="palette-input"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="palette-results"
          aria-activedescendant=""
          placeholder="Search tools by name, topic, or keyword..."
          autocomplete="off"
          spellcheck="false"
        >
        <button type="button" class="palette-close-btn" id="palette-close-btn" aria-label="Close search dialog">
          <kbd>ESC</kbd>
        </button>
      </div>

      <div class="search-modal-body" id="palette-body">
        <ul id="palette-results" class="palette-results-list" role="listbox" aria-label="Search results"></ul>
        
        <!-- Empty State Container -->
        <div id="palette-empty-state" class="palette-empty-state">
          <div id="palette-recent-section" class="palette-section" hidden>
            <div class="palette-section-header">
              <span class="palette-section-title">Recent Tools</span>
              <button type="button" class="palette-clear-btn" id="palette-clear-recents" aria-label="Clear recent tools">Clear</button>
            </div>
            <ul id="palette-recent-list" class="palette-section-list"></ul>
          </div>

          <div id="palette-popular-section" class="palette-section">
            <div class="palette-section-header">
              <span class="palette-section-title">Popular Tools</span>
            </div>
            <ul id="palette-popular-list" class="palette-section-list">
              {% for t in tools %}
                {% if t.popular %}
                  <li>
                    <a href="/tools/{{ t.slug }}/" class="palette-item-link" data-slug="{{ t.slug }}">
                      <span class="palette-item-cat">{{ t.category }}</span>
                      <span class="palette-item-name">{{ t.name }}</span>
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>

        <!-- No Results Container -->
        <div id="palette-no-results" class="palette-no-results" hidden>
          <p class="no-results-text">No tools found matching your search.</p>
          <p class="no-results-subtext">Missing a calculator? <a href="/contact/" class="suggest-tool-link">Suggest a tool</a> and we'll build it.</p>
        </div>
      </div>

      <div class="search-modal-footer">
        <span class="palette-shortcut-hint"><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
        <span class="palette-shortcut-hint"><kbd>↵</kbd> Select</span>
        <span class="palette-shortcut-hint"><kbd>ESC</kbd> Close</span>
      </div>
    </div>
  </div>
