{#
  Shared code formatter UI.
  Usage in a tool page:
    {% from "partials/code-formatter.njk" import codeFormatter %}
    {% call codeFormatter({ language: "Python", importMap: vendor.importMaps.python, engine: "Ruff 0.15.20", sample: "..." }) %}
      ...option <select>s with data-option="<name>"...
    {% endcall %}
  The import map points the engine's package names at the self-hosted files in /assets/vendor/,
  so only this page can load the engine, and only from this site. The page's script.js calls
  ToolsBuilt.codeFormatter.init() from /assets/js/code-formatter.js.
#}
{% macro codeFormatter(cfg) %}
<script type="importmap">{{ cfg.importMap | dump | safe }}</script>
<script src="/assets/js/code-formatter.js"></script>

<section class="tool-container code-formatter" aria-label="{{ cfg.language }} Formatter"{% if cfg.grammarUrl %} data-grammar-url="{{ cfg.grammarUrl }}"{% endif %}>
  <form id="calculator-form" class="code-form" novalidate>
    <div class="form-grid code-options">
      {{ caller() }}
    </div>

    <div class="code-pane">
      <div class="code-pane-head">
        <label for="code-input">Your {{ cfg.language }} code</label>
        <button type="button" class="btn btn-sm btn-ghost" id="sample-btn">Load example</button>
      </div>
      <textarea id="code-input" class="form-control code-textarea" rows="12" wrap="off" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="code-hint">{{ cfg.sample }}</textarea>
    </div>

    <div class="button-group">
      <button type="submit" class="btn btn-primary" id="format-btn">Format code</button>
      <button type="button" class="btn btn-secondary" id="clear-btn">Clear</button>
    </div>
    <p class="form-hint" id="code-hint">Press Ctrl+Enter (⌘+Enter on a Mac) to format. The {{ cfg.engine }} engine is loaded from this site the first time you format, then runs in your browser.</p>
  </form>

  <div id="error-box" class="hidden form-error" role="alert"></div>

  <div class="code-pane code-output-pane">
    <div class="code-pane-head">
      <label for="code-output">Formatted code</label>
      <span class="code-status" id="code-status" role="status" aria-live="polite"></span>
      <button type="button" class="btn btn-sm btn-secondary" id="copy-btn" disabled>Copy</button>
    </div>
    <textarea id="code-output" class="form-control code-textarea" rows="12" wrap="off" spellcheck="false" readonly placeholder="Your formatted code will appear here."></textarea>
  </div>
</section>
<template id="code-sample">{{ cfg.sample }}</template>
{% endmacro %}
