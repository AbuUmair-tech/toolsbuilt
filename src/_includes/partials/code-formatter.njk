{#
  Shared code formatter UI.
  Usage in a tool page:
    {% from "partials/code-formatter.njk" import codeFormatter with context %}
    {% call codeFormatter({ language: "Python", importMap: vendor.importMaps.python, engine: "Ruff 0.15.20", sample: "..." }) %}
      ...option <select>s with data-option="<name>"...
    {% endcall %}
  The import map points the engine's package names at the self-hosted files in /assets/vendor/,
  so only this page can load the engine, and only from this site. The page's script.js calls
  ToolsBuilt.codeFormatter.init() from /assets/js/code-formatter.js.
#}
{% macro codeFormatter(cfg) %}
<script type="importmap">{{ cfg.importMap | dump | safe }}</script>
<script src="/assets/js/code-formatter.js"></script>

<section class="tool-container code-formatter" aria-label="{{ 'codeFormatter.formLabel' | t({ language: cfg.language }) }}"{% if cfg.grammarUrl %} data-grammar-url="{{ cfg.grammarUrl }}"{% endif %}>
  <form id="calculator-form" class="code-form" novalidate>
    <!-- Toolbar: options and actions -->
    <div class="code-toolbar">
      <div class="form-grid code-options">
        {{ caller() }}
      </div>
      <div class="button-group">
        <button type="submit" class="btn btn-primary" id="format-btn">{{ 'codeFormatter.text.format-btn' | t }}</button>
        <button type="button" class="btn btn-secondary" id="clear-btn">{{ 'codeFormatter.text.clear-btn' | t }}</button>
      </div>
      <p class="form-hint" id="code-hint">{{ 'codeFormatter.hint' | t({ engine: cfg.engine }) }}</p>
    </div>
  </form>

  <div id="error-box" class="hidden form-error" role="alert"></div>
  <ul class="code-warnings" id="code-warnings" role="status" hidden></ul>

  <!-- Input and output side by side from 1024px -->
  <div class="code-editors">
    <div class="code-pane">
      <div class="code-pane-head">
        <label for="code-input">{{ 'codeFormatter.inputLabel' | t({ language: cfg.language }) }}</label>
        <button type="button" class="btn btn-sm btn-ghost" id="sample-btn">{{ 'codeFormatter.text.sample-btn' | t }}</button>
      </div>
      <textarea id="code-input" form="calculator-form" class="form-control code-textarea" rows="16" wrap="off" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="code-hint">{{ cfg.sample }}</textarea>
    </div>

    <div class="code-pane code-output-pane">
      <div class="code-pane-head">
        <label for="code-output">{{ 'codeFormatter.label.code-output' | t }}</label>
        <span class="code-status" id="code-status" role="status" aria-live="polite"></span>
        <button type="button" class="btn btn-sm btn-secondary" id="copy-btn" disabled>{{ 'codeFormatter.text.copy-btn' | t }}</button>
      </div>
      <textarea id="code-output" class="form-control code-textarea" rows="16" wrap="off" spellcheck="false" readonly placeholder="{{ 'codeFormatter.placeholder.code-output' | t }}"></textarea>
    </div>
  </div>
</section>
<template id="code-sample">{{ cfg.sample }}</template>
{% endmacro %}
