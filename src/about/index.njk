---
layout: layouts/page.njk
permalink: /about/
updated: 2026-10-24
---
{% block jsonLd %}
  <!-- JSON-LD: ProfilePage for the site's author -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "url": "https://toolsbuilt.com/about/",
    "dateModified": {{ updated | isoDate | jsonStr }},
    "mainEntity": {
      "@type": "Person",
      "name": {{ site.authorName | jsonStr }},
      "url": {{ site.authorUrl | jsonStr }},
      "sameAs": {{ (site.authorSameAs or []) | jsonStr }},
      "description": {{ 'site.authorBio' | t | jsonStr }},
      "knowsAbout": ["Web development", "Calculators"]
    }
  }
  </script>
{% endblock %}
      <h2>{{ 'content.our-mission.heading' | pt }}</h2>
      <p>{{ 'content.our-mission.p1' | pt }}</p>

      <h2>{{ 'content.why-we-started-toolsbuilt.heading' | pt }}</h2>
      <p>{{ 'content.why-we-started-toolsbuilt.p1' | pt }}</p>
      
      <p>{{ 'content.why-we-started-toolsbuilt.p2' | pt }}</p>

      <h2>{{ 'content.our-core-values.heading' | pt }}</h2>
      <ul>
        <li>{{ 'content.our-core-values.li1' | pt }}</li>
        <li>{{ 'content.our-core-values.li2' | pt }}</li>
        <li>{{ 'content.our-core-values.li3' | pt }}</li>
        <li>{{ 'content.our-core-values.li4' | pt }}</li>
      </ul>

      <h2>{{ 'content.creator-maintainer.heading' | pt }}</h2>
      <p>{{ 'content.creator-maintainer.p1' | pt }}</p>
      {% if site.authorSameAs and site.authorSameAs.length %}
      {% set profileLinks %}{% for link in site.authorSameAs %}<a href="{{ link }}" rel="me noopener" target="_blank">{% if "github.com" in link %}GitHub{% elif "linkedin.com" in link %}LinkedIn{% else %}{{ link }}{% endif %}</a>{% if not loop.last %}{% if loop.revindex == 2 %}{{ 'links.lastSeparator' | pt }}{% else %}{{ 'links.separator' | pt }}{% endif %}{% endif %}{% endfor %}{% endset %}
      <p>{{ 'links.findOn' | pt({ author: site.authorName, links: profileLinks | safe }) }}</p>
      {% endif %}

      <h2>{{ 'content.get-in-touch.heading' | pt }}</h2>
      <p>{{ 'content.get-in-touch.p1' | pt }}</p>
