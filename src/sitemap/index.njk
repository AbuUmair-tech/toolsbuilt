---
layout: layouts/page.njk
permalink: /sitemap/
updated: 2026-10-24
---
      <section class="sitemap-section">
        <h2>{{ 'content.main-pages.heading' | pt }}</h2>
        <ul>
          <li>{{ 'content.main-pages.li1' | pt }}</li>
          <li>{{ 'content.main-pages.li2' | pt }}</li>
          <li>{{ 'content.main-pages.li3' | pt }}</li>
          <li>{{ 'content.main-pages.li4' | pt }}</li>
          <li>{{ 'content.main-pages.li5' | pt }}</li>
        </ul>
      </section>

      <section class="sitemap-section">
        <h2>{{ 'content.tool-categories-calculators.heading' | pt }}</h2>
        {% for cat in categories %}
          <h3><a href="{{ cat.slug | categoryUrl }}">{{ cat.name }}</a></h3>
          <p>{{ cat.description }}</p>
          <ul>
            {% set catTools = tools | filterByCategory(cat.slug) %}
            {% for tool in catTools %}
              <li><a href="/tools/{{ tool.slug }}/">{{ tool.name }}</a> - {{ tool.description }}</li>
            {% endfor %}
          </ul>
        {% endfor %}
      </section>

      <section class="sitemap-section">
        <h2>{{ 'content.blog-articles-guides.heading' | pt }}</h2>
        <ul>
          {% for post in collections.post | reverse %}
            {% if not (env.isProduction and post.data.draft) %}
              <li><a href="{{ post.url }}">{{ post.data.title }}</a> - {{ post.data.description }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </section>

      <section class="sitemap-section">
        <h2>{{ 'content.legal-policy-pages.heading' | pt }}</h2>
        <ul>
          <li>{{ 'content.legal-policy-pages.li1' | pt }}</li>
          <li>{{ 'content.legal-policy-pages.li2' | pt }}</li>
          <li>{{ 'content.legal-policy-pages.li3' | pt }}</li>
        </ul>
      </section>
