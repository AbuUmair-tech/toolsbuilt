---
layout: layouts/base.njk
permalink: /404.html
noindex: true
eleventyExcludeFromCollections: true
---

  <!-- Main Content -->
  <main id="main-content">
    <section class="page-hero not-found-hero">
      <div class="container text-center">
        <p class="text-sm font-semibold uppercase text-accent mb-2">{{ 'content.tool.p1' | pt }}</p>
        <h1 class="not-found-title">{{ 'content.tool.heading' | pt }}</h1>
        <p class="text-base text-secondary leading-normal mb-8 not-found-intro">{{ 'content.tool.p2' | pt }}</p>

        <!-- 404 Search Form pointing to /?q= -->
        <form action="/" method="GET" class="hero-search-box not-found-search">
          <svg class="hero-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="search" name="q" class="hero-search-input" placeholder="{{ 'placeholder.tool-input1' | pt }}" aria-label="{{ 'ariaLabel.tool-input2' | pt }}" autocomplete="off">
          <button type="submit" class="btn btn-sm btn-primary">{{ 'content.tool.button1' | pt }}</button>
        </form>
      </div>
    </section>

    <div class="container page-container text-center not-found-body">
      <!-- Quick Category Links -->
      <div class="mb-12">
        <p class="text-sm font-semibold uppercase text-tertiary mb-3">{{ 'content.tool.p3' | pt }}</p>
        <div class="flex flex-wrap justify-center gap-2">
          {% for cat in categories %}
          <a href="{{ cat.slug | categoryUrl }}" class="quick-chip">
            <span class="quick-chip-dot" data-cat="{{ cat.slug }}"></span>
            <span>{{ cat.name }}</span>
          </a>
          {% endfor %}
          <a href="/tools/" class="quick-chip">
            {{ 'content.tool.a1' | pt }}
          </a>
        </div>
      </div>

      <div class="flex justify-center gap-4">
        {{ 'content.tool.div1' | pt }}
      </div>
    </div>
  </main>
