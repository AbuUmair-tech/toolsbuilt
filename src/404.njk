---
layout: layouts/base.njk
title: Page Not Found | ToolsBuilt
description: The page you are looking for could not be found. Search our full directory of free online calculators, date utilities, and text tools.
permalink: /404.html
noindex: true
eleventyExcludeFromCollections: true
---

  <!-- Main Content -->
  <main id="main-content">
    <section class="page-hero not-found-hero">
      <div class="container text-center">
        <p class="text-sm font-semibold uppercase text-accent mb-2">Error 404</p>
        <h1 class="not-found-title">Page Not Found</h1>
        <p class="text-base text-secondary leading-normal mb-8 not-found-intro">The link you followed may be broken, or the page may have been moved. Try searching our collection of free calculators or browse popular tools below.</p>

        <!-- 404 Search Form pointing to /?q= -->
        <form action="/" method="GET" class="hero-search-box not-found-search">
          <svg class="hero-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="search" name="q" class="hero-search-input" placeholder="Search calculators (e.g. Age, Discount, Password)..." aria-label="Search tools" autocomplete="off">
          <button type="submit" class="btn btn-sm btn-primary">Search</button>
        </form>
      </div>
    </section>

    <div class="container page-container text-center not-found-body">
      <!-- Quick Category Links -->
      <div class="mb-12">
        <p class="text-sm font-semibold uppercase text-tertiary mb-3">Browse by Category</p>
        <div class="flex flex-wrap justify-center gap-2">
          {% for cat in categories %}
          <a href="{{ cat.slug | categoryUrl }}" class="quick-chip">
            <span class="quick-chip-dot" data-cat="{{ cat.slug }}"></span>
            <span>{{ cat.name }}</span>
          </a>
          {% endfor %}
          <a href="/tools/" class="quick-chip">
            <span>All Tools Directory &rarr;</span>
          </a>
        </div>
      </div>

      <div class="flex justify-center gap-4">
        <a href="/" class="btn btn-secondary">Return to Homepage</a>
        <a href="/tools/" class="btn btn-ghost">View All Tools</a>
      </div>
    </div>
  </main>
