formula:
  title: "Password Entropy & Strength Formula"
  expression: "Entropy (bits) = Length × log₂(Pool Size)  |  Passphrase Entropy = Word Count × log₂(Wordlist Size)"
  explanation: "Information entropy quantifies brute-force cracking difficulty. A 16-character password drawn from a 94-character ASCII pool provides ~104.9 bits of entropy, which would require trillions of years to guess using modern distributed GPU clusters."
workedExamples:
  - title: "16-Character High-Entropy Password"
    inputs:
      - "Length: 16 characters"
      - "Character Sets: Uppercase (26), Lowercase (26), Numbers (10), Symbols (32)"
      - "Pool Size: 94 printable ASCII characters"
    steps:
      - "Ensure at least 1 character from each selected set"
      - "Draw remaining 12 positions uniformly using rejection sampling"
      - "Shuffle character array using Fisher-Yates algorithm"
      - "Calculate entropy: 16 × log₂(94) = 104.87 bits"
    result: "Entropy: ~104.9 bits (Very Strong — Centuries to crack)"
  - title: "12-Character Alphanumeric Password"
    inputs:
      - "Length: 12 characters"
      - "Character Sets: Uppercase (26), Lowercase (26), Numbers (10)"
      - "Pool Size: 62 alphanumeric characters"
    steps:
      - "Select 12 characters uniformly from 62 possible characters"
      - "Calculate entropy: 12 × log₂(62) = 71.45 bits"
      - "Evaluate brute-force threshold against offline hash tables"
    result: "Entropy: ~71.5 bits (Strong — Decades to crack)"
  - title: "5-Word EFF Diceware Passphrase"
    inputs:
      - "Mode: Memorable Passphrase"
      - "Word Count: 5 words"
      - "Wordlist: EFF Short Wordlist (1,296 words)"
      - "Separator: Hyphen (-)"
    steps:
      - "Sample 5 independent words from 1,296-word curated dictionary"
      - "Calculate passphrase entropy: 5 × log₂(1,296) = 51.70 bits"
      - "Format with title casing and hyphen delimiters"
    result: "Entropy: ~51.7 bits (Moderate — Months to Years to crack)"
commonMistakes:
  - title: "Using Pseudo-Random Math.random()"
    description: "Standard JavaScript Math.random() is deterministic and predictable. Production password generation requires crypto.getRandomValues()."
  - title: "Modulo Bias in Character Selection"
    description: "Taking (randomUint % poolSize) biases character probability toward lower index values. Rejection sampling ensures exact mathematical uniformity."
  - title: "Predictable Leetspeak Substitutions"
    description: "Replacing letters with symbols (e.g., 'E' with '3') adds almost zero entropy because modern password cracking engines test substitution masks automatically."
  - title: "Password Reuse Across Accounts"
    description: "Reusing the same strong password across multiple sites leaves all accounts vulnerable if any single service suffers a credential breach."
sources:
  - name: "NIST Special Publication 800-63B: Digital Identity Guidelines"
    url: "https://pages.nist.gov/800-63-3/sp800-63b.html"
  - name: "W3C Web Cryptography API Specification"
    url: "https://www.w3.org/TR/WebCryptoAPI/"
  - name: "Electronic Frontier Foundation (EFF) Dice-Generated Passphrases"
