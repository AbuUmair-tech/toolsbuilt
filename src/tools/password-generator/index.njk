---
layout: layouts/tool.njk
toolSlug: password-generator
permalink: /tools/password-generator/
extraCss: "/tools/password-generator/style.css"
lastReviewed: "2026-10-24"
---

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      
      <!-- Mode Selection Tabs -->
      <div class="segmented-control flex gap-2 mb-6" role="tablist" aria-label="{{ 'ariaLabel.tool-div1' | pt }}">
        <button type="button" class="btn btn-sm mode-tab-btn active" id="mode-random-btn" role="tab" aria-selected="true">{{ 'text.mode-random-btn' | pt }}</button>
        <button type="button" class="btn btn-sm mode-tab-btn" id="mode-passphrase-btn" role="tab" aria-selected="false">{{ 'text.mode-passphrase-btn' | pt }}</button>
      </div>

      <div class="form-group">
        <label for="password-display" class="row-between">
          {{ 'label.password-display' | pt }}
        </label>
        
        <div class="flex gap-3">
          <input type="text" id="password-display" class="form-control font-mono text-md font-bold bg-muted" readonly>
          <button type="button" class="btn btn-primary" id="copy-btn">{{ 'text.copy-btn' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="generate-btn" title="{{ 'title.generate-btn' | pt }}">{{ 'text.generate-btn' | pt }}</button>
        </div>
      </div>

      <!-- Strength Meter -->
      <div class="strength-meter-container mt-6">
        <div class="flex justify-between items-center text-sm">
          {{ 'content.tool.div1' | pt }}
        </div>
        <div class="strength-bar-bg meter">
          <div id="strength-bar-fill" class="strength-bar-fill meter-fill" data-level="4"></div>
        </div>
      </div>

      <!-- Multiple Passwords List Container -->
      <div id="multi-passwords-container" class="hidden mt-6">
        <h4 class="text-sm mb-2">{{ 'content.tool.heading' | pt }}</h4>
        <div id="multi-passwords-list"></div>
      </div>

      <!-- Controls & Options -->
      <div class="section-divider">
        
        <!-- Batch Count Selector -->
        <div class="form-group flex items-center justify-between mb-4">
          <label for="password-count" class="text-sm font-semibold mb-0">{{ 'label.password-count' | pt }}</label>
          <select id="password-count" class="form-control w-auto">
            <option value="1" selected>{{ 'option.password-count.1' | pt }}</option>
            <option value="3">{{ 'option.password-count.3' | pt }}</option>
            <option value="5">{{ 'option.password-count.5' | pt }}</option>
            <option value="10">{{ 'option.password-count.10' | pt }}</option>
          </select>
        </div>

        <!-- Random Mode Options -->
        <div id="random-options-panel">
          <div class="form-group">
            <label for="length-range" class="flex justify-between">
              {{ 'label.length-range' | pt }}
            </label>
            <input type="range" id="length-range" min="8" max="64" value="16" class="w-full mt-2 cursor-pointer">
          </div>

          <div class="checkbox-grid auto-grid mt-4">
            <label class="checkbox-label option-label">
              {{ 'content.tool.label1' | pt }}
            </label>

            <label class="checkbox-label option-label">
              {{ 'content.tool.label2' | pt }}
            </label>

            <label class="checkbox-label option-label">
              {{ 'content.tool.label3' | pt }}
            </label>

            <label class="checkbox-label option-label">
              {{ 'content.tool.label4' | pt }}
            </label>

            <label class="checkbox-label col-span-full">
              {{ 'content.tool.label5' | pt }}
            </label>
          </div>
        </div>

        <!-- Passphrase Mode Options -->
        <div id="passphrase-options-panel" class="hidden">
          <div class="form-group">
            <label for="words-range" class="flex justify-between">
              {{ 'label.words-range' | pt }}
            </label>
            <input type="range" id="words-range" min="3" max="8" value="4" class="w-full mt-2 cursor-pointer">
          </div>

          <div class="form-grid two-col mt-4">
            <div class="form-group">
              <label for="passphrase-separator">{{ 'label.passphrase-separator' | pt }}</label>
              <select id="passphrase-separator" class="form-control">
                <option value="-" selected>{{ 'option.passphrase-separator.-' | pt }}</option>
                <option value=" ">{{ 'option.passphrase-separator. ' | pt }}</option>
                <option value="_">{{ 'option.passphrase-separator._' | pt }}</option>
                <option value=".">{{ 'option.passphrase-separator..' | pt }}</option>
              </select>
            </div>

            <div class="form-group">
              <label for="passphrase-capitalize">{{ 'label.passphrase-capitalize' | pt }}</label>
              <select id="passphrase-capitalize" class="form-control">
                <option value="title" selected>{{ 'option.passphrase-capitalize.title' | pt }}</option>
                <option value="lower">{{ 'option.passphrase-capitalize.lower' | pt }}</option>
                <option value="upper">{{ 'option.passphrase-capitalize.upper' | pt }}</option>
              </select>
            </div>
          </div>

          <div class="mt-3">
            <label class="checkbox-label option-label">
              {{ 'content.tool.label6' | pt }}
            </label>
          </div>

          <p class="text-sm text-secondary mt-3">
            {{ 'content.tool.p1' | pt }}
          </p>
        </div>

      </div>

      <div id="error-box" class="hidden form-error" role="alert"></div>
    </section>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section">
      <h2>{{ 'content.when-to-use-strong-passwords-vs.heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.when-to-use-strong-passwords-vs.li1' | pt }}</li>
        <li>{{ 'content.when-to-use-strong-passwords-vs.li2' | pt }}</li>
        <li>{{ 'content.when-to-use-strong-passwords-vs.li3' | pt }}</li>
      </ul>
    </section>
