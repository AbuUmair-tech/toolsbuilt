---
layout: layouts/tool.njk
toolSlug: compound-interest-calculator
permalink: /tools/compound-interest-calculator/
extraCss: "/tools/compound-interest-calculator/style.css"
---
{% from "partials/currency-select.njk" import currencySelect, countryData with context %}
{{ countryData(countries) }}

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <form id="calculator-form" novalidate>
        <div class="form-grid two-col">
          
          {{ currencySelect({ id: "currency", param: "cur", selected: "USD" }) }}

          <div class="form-group">
            <label for="principal">{{ 'label.principal' | pt }}</label>
            <input type="number" step="any" min="0" id="principal" data-param="p" class="form-control" placeholder="{{ 'placeholder.principal' | pt }}" required aria-required="true">
          </div>

          <div class="form-group">
            <label for="interest-rate">{{ 'label.interest-rate' | pt }}</label>
            <input type="number" step="0.01" min="0" max="100" id="interest-rate" data-param="r" class="form-control" placeholder="{{ 'placeholder.interest-rate' | pt }}" required aria-required="true">
          </div>

          <div class="form-group">
            <label for="years">{{ 'label.years' | pt }}</label>
            <input type="number" step="1" min="1" max="60" id="years" data-param="y" class="form-control" placeholder="{{ 'placeholder.years' | pt }}" required aria-required="true">
          </div>

          <div class="form-group">
            <label for="compounding-frequency">{{ 'label.compounding-frequency' | pt }}</label>
            <select id="compounding-frequency" data-param="f" class="form-control">
              <option value="daily">{{ 'option.compounding-frequency.daily' | pt }}</option>
              <option value="monthly">{{ 'option.compounding-frequency.monthly' | pt }}</option>
              <option value="quarterly">{{ 'option.compounding-frequency.quarterly' | pt }}</option>
              <option value="annual" selected>{{ 'option.compounding-frequency.annual' | pt }}</option>
            </select>
          </div>

          <div class="form-group col-span-full">
            <label for="regular-contribution">{{ 'label.regular-contribution' | pt }}</label>
            <input type="number" step="any" min="0" id="regular-contribution" data-param="pmt" class="form-control" placeholder="{{ 'placeholder.regular-contribution' | pt }}">
          </div>

        </div>

        <div class="button-group mt-6">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button1' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-btn">{{ 'text.reset-btn' | pt }}</button>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <!-- Result Box -->
      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          <span id="result-header-text">{{ 'text.result-header-text' | pt }}</span>
          <button type="button" class="btn btn-sm btn-ghost" id="copy-result-btn" title="{{ 'title.copy-result-btn' | pt }}" aria-label="{{ 'ariaLabel.copy-result-btn' | pt }}">
            {{ 'text.copy-result-btn' | pt }}
          </button>
        </div>
        <div class="result-primary" id="result-primary-text">{{ 'text.result-primary-text' | pt }}</div>
        
        <div class="result-grid">
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div1' | pt }}</div>
            <div class="result-stat-value text-accent" id="stat-final-balance">$0.00</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div2' | pt }}</div>
            <div class="result-stat-value" id="stat-total-principal">$0.00</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div3' | pt }}</div>
            <div class="result-stat-value text-success" id="stat-total-interest">$0.00</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div4' | pt }}</div>
            <div class="result-stat-value" id="stat-effective-apy">{{ 'text.stat-effective-apy' | pt }}</div>
          </div>
        </div>

        <!-- Inline SVG Growth Chart Card -->
        <div class="chart-card">
          <div class="chart-header">
            <h3 class="chart-title">{{ 'content.balance-growth-over-time.heading' | pt }}</h3>
            <div class="chart-legend">
              {{ 'content.balance-growth-over-time.div1' | pt }}
            </div>
          </div>
          <div class="chart-container-inner" id="growth-chart-container">
            <!-- Lightweight SVG rendered by script.js -->
          </div>
        </div>

        <!-- Yearly Breakdown Table -->
        <div class="chart-card mt-6">
          <h3 class="chart-title">{{ 'content.annual-balance-interest-schedule.heading' | pt }}</h3>
          <div class="compound-scroll-table" tabindex="0" role="region" aria-label="{{ 'ariaLabel.annual-balance-interest-schedule-div1' | pt }}">
            <table class="compound-table" aria-label="{{ 'ariaLabel.annual-balance-interest-schedule-table1' | pt }}">
              <thead>
                <tr>
                  <th>{{ 'content.annual-balance-interest-schedule.th1' | pt }}</th>
                  <th>{{ 'content.annual-balance-interest-schedule.th2' | pt }}</th>
                  <th>{{ 'content.annual-balance-interest-schedule.th3' | pt }}</th>
                  <th>{{ 'content.annual-balance-interest-schedule.th4' | pt }}</th>
                  <th>{{ 'content.annual-balance-interest-schedule.th5' | pt }}</th>
                </tr>
              </thead>
              <tbody id="compound-table-body">
                <!-- Rows injected by script.js -->
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- tool-end -->

    <!-- Reusable Financial Disclaimer -->
    {% include "partials/financial-disclaimer.njk" %}

    <!-- When to Use Section -->
    <section class="content-section" aria-labelledby="how-to-use-heading">
      <h2 id="how-to-use-heading">{{ 'text.how-to-use-heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-compound.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-compound.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-compound.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-compound.li4' | pt }}</li>
      </ul>
    </section>

