---
layout: layouts/tool.njk
toolSlug: random-name-picker
permalink: /tools/random-name-picker/
lastReviewed: "2026-10-24"
---

<div class="tool-container">
  <div class="wheel-layout">
    <div class="wheel-controls-col">
      <div class="form-group">
        <div class="label-row row-between mb-2">
          <label for="namesInput" class="font-semibold mb-0">{{ 'label.namesInput' | pt }}</label>
          <span id="nameCount" class="text-sm text-muted">{{ 'text.nameCount' | pt }}</span>
        </div>
        <textarea id="namesInput" class="form-input code-input" rows="8" placeholder="{{ 'placeholder.namesInput' | pt }}"></textarea>
        <p class="text-sm text-muted mt-2 mb-0">
          {{ 'content.tool.p1' | pt }}
        </p>
      </div>

      <div class="form-group mt-4">
        <label class="checkbox-label option-label">
          {{ 'content.tool.label1' | pt }}
        </label>
      </div>

      <div class="btn-group flex gap-2 flex-wrap mt-4">
        <button type="button" id="spinBtn" class="btn btn-primary flex-full">{{ 'text.spinBtn' | pt }}</button>
        <button type="button" id="shuffleBtn" class="btn btn-secondary">{{ 'text.shuffleBtn' | pt }}</button>
        <button type="button" id="dedupeBtn" class="btn btn-secondary">{{ 'text.dedupeBtn' | pt }}</button>
        <button type="button" id="clearBtn" class="btn btn-ghost">{{ 'text.clearBtn' | pt }}</button>
      </div>
    </div>

    <div class="wheel-canvas-col">
      <div class="canvas-wrapper flex justify-center items-center">
        <canvas id="wheelCanvas" width="400" height="400" aria-label="{{ 'ariaLabel.wheelCanvas' | pt }}"></canvas>
      </div>
    </div>
  </div>

  <!-- Winner Modal -->
  <div id="winnerModal" class="modal-overlay hidden" aria-hidden="true" role="dialog" aria-labelledby="winnerTitle">
    <div class="modal-card text-center panel-card max-w-sm my-8 mx-auto">
      <h2 id="winnerTitle" class="modal-title mt-0 text-accent">{{ 'text.winnerTitle' | pt }}</h2>
      <div id="winnerName" class="winner-display-name text-2xl font-extrabold my-6 mx-0 break-words">---</div>
      <div class="modal-actions flex gap-3 flex-col">
        <button type="button" id="copyWinnerBtn" class="btn btn-outline">{{ 'text.copyWinnerBtn' | pt }}</button>
        <button type="button" id="removeWinnerBtn" class="btn btn-primary">{{ 'text.removeWinnerBtn' | pt }}</button>
        <button type="button" id="closeModalBtn" class="btn btn-secondary">{{ 'text.closeModalBtn' | pt }}</button>
      </div>
    </div>
  </div>
</div>

<!-- tool-end -->

<!-- When to Use Section -->
<section class="content-section" aria-labelledby="when-to-use-heading">
  <h2 id="when-to-use-heading">{{ 'text.when-to-use-heading' | pt }}</h2>
  <ul class="content-list">
    <li>{{ 'content.when-to-use-the-random-name.li1' | pt }}</li>
    <li>{{ 'content.when-to-use-the-random-name.li2' | pt }}</li>
    <li>{{ 'content.when-to-use-the-random-name.li3' | pt }}</li>
    <li>{{ 'content.when-to-use-the-random-name.li4' | pt }}</li>
  </ul>
</section>

<div class="article-content">
  <h2>{{ 'content.why-use-a-digital-random-name.heading' | pt }}</h2>
  <p>{{ 'content.why-use-a-digital-random-name.p1' | pt }}</p>

  <h2>{{ 'content.cryptographically-secure-randomness.heading' | pt }}</h2>
  <p>{{ 'content.cryptographically-secure-randomness.p1' | pt }}</p>
</div>
