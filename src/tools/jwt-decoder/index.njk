  - name: "RFC 7518: JSON Web Algorithms (JWA)"
    url: "https://www.rfc-editor.org/rfc/rfc7518"
  - name: "RFC 8725: JSON Web Token Best Current Practices"
    url: "https://www.rfc-editor.org/rfc/rfc8725"
  - name: "OWASP Cheat Sheet Series: JSON Web Token"
    url: "https://cheatsheetseries.owasp.org/cheatsheets/JSON_Web_Token_Cheat_Sheet.html"
  - name: "OWASP Web Security Testing Guide: Testing JSON Web Tokens"
    url: "https://owasp.org/www-project-web-security-testing-guide/latest/4-Web_Application_Security_Testing/06-Session_Management_Testing/10-Testing_JSON_Web_Tokens"
lastReviewed: "2026-10-31"
