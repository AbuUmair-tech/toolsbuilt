---
layout: layouts/tool.njk
toolSlug: unit-converter
permalink: /tools/unit-converter/
lastReviewed: "2026-10-24"
---

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      
      <!-- Category Tabs -->
      <div class="segmented-control cluster cluster-sm mb-6" role="tablist" aria-label="{{ 'ariaLabel.tool-div1' | pt }}">
        <button type="button" class="btn btn-sm category-tab-btn active" data-cat="length" role="tab" aria-selected="true">{{ 'content.tool.button1' | pt }}</button>
        <button type="button" class="btn btn-sm category-tab-btn" data-cat="weight" role="tab" aria-selected="false">{{ 'content.tool.button2' | pt }}</button>
        <button type="button" class="btn btn-sm category-tab-btn" data-cat="temperature" role="tab" aria-selected="false">{{ 'content.tool.button3' | pt }}</button>
        <button type="button" class="btn btn-sm category-tab-btn" data-cat="area" role="tab" aria-selected="false">{{ 'content.tool.button4' | pt }}</button>
        <button type="button" class="btn btn-sm category-tab-btn" data-cat="volume" role="tab" aria-selected="false">{{ 'content.tool.button5' | pt }}</button>
        <button type="button" class="btn btn-sm category-tab-btn" data-cat="speed" role="tab" aria-selected="false">{{ 'content.tool.button6' | pt }}</button>
      </div>

      <!-- Two-Way Interactive Inputs Grid -->
      <form id="unit-converter-form" novalidate onsubmit="return false;">
        <div class="form-grid two-col items-end gap-4">
          
          <!-- Column A -->
          <div class="content-box">
            <div class="form-group mb-3">
              <label for="unit-select-a" class="font-semibold">{{ 'label.unit-select-a' | pt }}</label>
              <select id="unit-select-a" class="form-control" aria-label="{{ 'ariaLabel.unit-select-a' | pt }}">
                <!-- Populated by script.js -->
              </select>
            </div>
            <div class="form-group mb-0">
              <label for="unit-val-a" class="font-semibold">{{ 'label.unit-val-a' | pt }}</label>
              <input type="number" step="any" id="unit-val-a" class="form-control" placeholder="1" value="1" aria-label="{{ 'ariaLabel.unit-val-a' | pt }}">
            </div>
          </div>

          <!-- Column B -->
          <div class="content-box">
            <div class="form-group mb-3">
              <label for="unit-select-b" class="font-semibold">{{ 'label.unit-select-b' | pt }}</label>
              <select id="unit-select-b" class="form-control" aria-label="{{ 'ariaLabel.unit-select-b' | pt }}">
                <!-- Populated by script.js -->
              </select>
            </div>
            <div class="form-group mb-0">
              <label for="unit-val-b" class="font-semibold">{{ 'label.unit-val-b' | pt }}</label>
              <input type="number" step="any" id="unit-val-b" class="form-control" placeholder="3.28084" aria-label="{{ 'ariaLabel.unit-val-b' | pt }}">
            </div>
          </div>

        </div>

        <div class="button-group mt-6">
          <button type="button" class="btn btn-secondary" id="swap-units-btn">
            {{ 'text.swap-units-btn' | pt }}
          </button>
          <button type="button" class="btn btn-ghost" id="reset-unit-btn">{{ 'text.reset-unit-btn' | pt }}</button>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <!-- Result Box -->
      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          <span id="result-header-text">{{ 'text.result-header-text' | pt }}</span>
          <button type="button" class="btn btn-sm btn-ghost" id="copy-result-btn" title="{{ 'title.copy-result-btn' | pt }}" aria-label="{{ 'ariaLabel.copy-result-btn' | pt }}">
            {{ 'text.copy-result-btn' | pt }}
          </button>
        </div>
        <div class="result-primary" id="result-primary-text">{{ 'text.result-primary-text' | pt }}</div>
        
        <div class="result-grid" id="result-stats-grid">
          <!-- Populated by script.js -->
        </div>

        <div class="formula-box content-panel" id="formula-explanation">
          <!-- Formula details -->
        </div>
      </div>

      <!-- Conversion Reference Table -->
      <div class="mt-8">
        <h3 class="text-md mb-3 text-primary">{{ 'content.equivalent-measurements-table.heading' | pt }}</h3>
        <div class="panel-card overflow-x-auto">
          <table class="table table-min" aria-label="{{ 'ariaLabel.equivalent-measurements-table-table1' | pt }}">
            <thead>
              <tr class="text-left">
                <th scope="col" class="py-2 px-3 text-sm">{{ 'content.equivalent-measurements-table.th1' | pt }}</th>
                <th scope="col" class="py-2 px-3 text-sm text-right">{{ 'content.equivalent-measurements-table.th2' | pt }}</th>
                <th scope="col" class="py-2 px-3 text-sm">{{ 'content.equivalent-measurements-table.th3' | pt }}</th>
              </tr>
            </thead>
            <tbody id="conversion-table-body">
              <!-- Populated by script.js -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section" aria-labelledby="how-to-use-heading">
      <h2 id="how-to-use-heading">{{ 'text.how-to-use-heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-unit.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-unit.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-unit.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-unit.li4' | pt }}</li>
      </ul>
    </section>

