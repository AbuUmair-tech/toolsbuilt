---
layout: layouts/tool.njk
toolSlug: days-until-date-calculator
permalink: /tools/days-until-date-calculator/
lastReviewed: "2026-10-24"
---

    <!-- Tool Card Interface -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <form id="calculator-form" novalidate>
        <div class="form-grid two-col">
          
          <div class="form-group">
            <label for="target-date">{{ 'label.target-date' | pt }}</label>
            <input type="date" id="target-date" data-param="date" class="form-control" required aria-required="true">
          </div>

          <div class="form-group">
            <label for="event-name">{{ 'label.event-name' | pt }}</label>
            <input type="text" id="event-name" class="form-control" placeholder="{{ 'placeholder.event-name' | pt }}">
          </div>

        </div>

        <div class="button-group mt-6">
          <button type="submit" class="btn btn-primary" id="calculate-btn">{{ 'text.calculate-btn' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-btn">{{ 'text.reset-btn' | pt }}</button>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <!-- Result Box -->
      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          {{ 'content.tool.div1' | pt }}
        </div>
        <div class="result-primary" id="result-primary-text">{{ 'text.result-primary-text' | pt }}</div>
        
        <div class="result-grid">
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div2' | pt }}</div>
            <div class="result-stat-value" id="stat-total-days">--</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div3' | pt }}</div>
            <div class="result-stat-value" id="stat-weeks-days">--</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div4' | pt }}</div>
            <div class="result-stat-value" id="stat-months-days">--</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div5' | pt }}</div>
            <div class="result-stat-value" id="stat-weekday">--</div>
          </div>
        </div>
      </div>
    </section>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section">
      <h2>{{ 'content.how-when-to-use-the-days.heading' | pt }}</h2>
      <p>{{ 'content.how-when-to-use-the-days.p1' | pt }}</p>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-days.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-days.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-days.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-days.li4' | pt }}</li>
      </ul>
    </section>
