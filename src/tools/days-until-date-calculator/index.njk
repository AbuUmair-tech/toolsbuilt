formula:
  title: "Calendar Countdown Formula"
  expression: "Days Until = ⌊(Target Date UTC ms - Current Date UTC ms) / 86,400,000 ms⌋"
  explanation: "Both dates are evaluated at midnight UTC to prevent daylight saving clock distortions. Positive values indicate future countdowns, while negative values represent elapsed time since past events."
workedExamples:
  - title: "30-Day Project Deadline"
