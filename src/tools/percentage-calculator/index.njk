---
layout: layouts/tool.njk
toolSlug: percentage-calculator
permalink: /tools/percentage-calculator/
lastReviewed: "2026-10-24"
---

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      
      <!-- Segmented Mode Control Tabs -->
      <div class="segmented-control cluster cluster-sm mb-6" role="tablist" aria-label="{{ 'ariaLabel.tool-div1' | pt }}">
        <button type="button" class="btn btn-sm mode-tab-btn active" data-mode="mode-1" role="tab" aria-selected="true">{{ 'content.tool.button1' | pt }}</button>
        <button type="button" class="btn btn-sm mode-tab-btn" data-mode="mode-2" role="tab" aria-selected="false">{{ 'content.tool.button2' | pt }}</button>
        <button type="button" class="btn btn-sm mode-tab-btn" data-mode="mode-3" role="tab" aria-selected="false">{{ 'content.tool.button3' | pt }}</button>
        <button type="button" class="btn btn-sm mode-tab-btn" data-mode="mode-4" role="tab" aria-selected="false">{{ 'content.tool.button4' | pt }}</button>
      </div>

      <!-- Mode 1: What is X% of Y Form -->
      <form id="mode-1-form" class="calculator-mode-form" novalidate>
        <div class="form-grid two-col">
          <div class="form-group">
            <label for="m1-percent-val">{{ 'label.m1-percent-val' | pt }}</label>
            <input type="number" step="any" id="m1-percent-val" data-param="pct" class="form-control" placeholder="{{ 'placeholder.m1-percent-val' | pt }}" value="15" required aria-required="true">
          </div>
          <div class="form-group">
            <label for="m1-total-val">{{ 'label.m1-total-val' | pt }}</label>
            <input type="number" step="any" id="m1-total-val" data-param="of" class="form-control" placeholder="{{ 'placeholder.m1-total-val' | pt }}" value="200" required aria-required="true">
          </div>
        </div>

        <div class="button-group mt-4">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button5' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-mode-1">{{ 'text.reset-mode-1' | pt }}</button>
        </div>
      </form>

      <!-- Mode 2: X is what % of Y Form -->
      <form id="mode-2-form" class="calculator-mode-form hidden" novalidate>
        <div class="form-grid two-col">
          <div class="form-group">
            <label for="m2-part-val">{{ 'label.m2-part-val' | pt }}</label>
            <input type="number" step="any" id="m2-part-val" data-param="part" class="form-control" placeholder="{{ 'placeholder.m2-part-val' | pt }}" required aria-required="true">
          </div>
          <div class="form-group">
            <label for="m2-whole-val">{{ 'label.m2-whole-val' | pt }}</label>
            <input type="number" step="any" id="m2-whole-val" data-param="whole" class="form-control" placeholder="{{ 'placeholder.m2-whole-val' | pt }}" required aria-required="true">
          </div>
        </div>

        <div class="button-group mt-4">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button6' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-mode-2">{{ 'text.reset-mode-2' | pt }}</button>
        </div>
      </form>

      <!-- Mode 3: Increase/Decrease by X% Form -->
      <form id="mode-3-form" class="calculator-mode-form hidden" novalidate>
        <div class="form-grid">
          <div class="form-group">
            <label for="m3-operation">{{ 'label.m3-operation' | pt }}</label>
            <select id="m3-operation" data-param="op" class="form-control">
              <option value="increase">{{ 'option.m3-operation.increase' | pt }}</option>
              <option value="decrease">{{ 'option.m3-operation.decrease' | pt }}</option>
            </select>
          </div>
          <div class="form-grid two-col">
            <div class="form-group">
              <label for="m3-base-val">{{ 'label.m3-base-val' | pt }}</label>
              <input type="number" step="any" id="m3-base-val" data-param="base" class="form-control" placeholder="{{ 'placeholder.m3-base-val' | pt }}" required aria-required="true">
            </div>
            <div class="form-group">
              <label for="m3-percent-val">{{ 'label.m3-percent-val' | pt }}</label>
              <input type="number" step="any" id="m3-percent-val" data-param="by" class="form-control" placeholder="{{ 'placeholder.m3-percent-val' | pt }}" required aria-required="true">
            </div>
          </div>
        </div>

        <div class="button-group mt-4">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button7' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-mode-3">{{ 'text.reset-mode-3' | pt }}</button>
        </div>
      </form>

      <!-- Mode 4: Find Original Value Form -->
      <form id="mode-4-form" class="calculator-mode-form hidden" novalidate>
        <div class="form-grid">
          <div class="form-group">
            <label for="m4-type">{{ 'label.m4-type' | pt }}</label>
            <select id="m4-type" data-param="type" class="form-control">
              <option value="of">{{ 'option.m4-type.of' | pt }}</option>
              <option value="increase">{{ 'option.m4-type.increase' | pt }}</option>
              <option value="decrease">{{ 'option.m4-type.decrease' | pt }}</option>
            </select>
          </div>
          <div class="form-grid two-col">
            <div class="form-group">
              <label for="m4-val">{{ 'label.m4-val' | pt }}</label>
              <input type="number" step="any" id="m4-val" data-param="known" class="form-control" placeholder="{{ 'placeholder.m4-val' | pt }}" required aria-required="true">
            </div>
            <div class="form-group">
              <label for="m4-percent-val">{{ 'label.m4-percent-val' | pt }}</label>
              <input type="number" step="any" id="m4-percent-val" data-param="rate" class="form-control" placeholder="{{ 'placeholder.m4-percent-val' | pt }}" required aria-required="true">
            </div>
          </div>
        </div>

        <div class="button-group mt-4">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button8' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-mode-4">{{ 'text.reset-mode-4' | pt }}</button>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <!-- Result Box -->
      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          <span id="result-header-text">{{ 'text.result-header-text' | pt }}</span>
          <button type="button" class="btn btn-sm btn-ghost" id="copy-result-btn" title="{{ 'title.copy-result-btn' | pt }}" aria-label="{{ 'ariaLabel.copy-result-btn' | pt }}">
            {{ 'text.copy-result-btn' | pt }}
          </button>
        </div>
        <div class="result-primary" id="result-primary-text">30</div>
        
        <div class="result-grid" id="result-stats-grid">
          <div class="result-stat-card">
            {{ 'content.tool.div1' | pt }}
          </div>
          <div class="result-stat-card">
            {{ 'content.tool.div2' | pt }}
          </div>
          <div class="result-stat-card">
            {{ 'content.tool.div3' | pt }}
          </div>
        </div>

        <div class="formula-box content-panel" id="formula-explanation">
          <strong>{{ 'content.tool.strong1' | pt }}</strong>
          <ul class="mt-2 mb-0 ml-4 p-0">
            <li>{{ 'content.tool.li1' | pt }}</li>
            <li>{{ 'content.tool.li2' | pt }}</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section" aria-labelledby="how-to-use-heading">
      <h2 id="how-to-use-heading">{{ 'text.how-to-use-heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-percentage.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-percentage.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-percentage.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-percentage.li4' | pt }}</li>
      </ul>
    </section>

