      <!-- Slab tables, rendered from logic.js data; the visitor's slab is highlighted by script.js -->
      {% for table in [
        { year: pakistanSalaryTax.taxYear, rows: pakistanSalaryTax.current },
        { year: pakistanSalaryTax.previousTaxYear, rows: pakistanSalaryTax.previous }
      ] %}
      <div class="slab-table-block" data-year="{{ table.year }}"{% if table.year != pakistanSalaryTax.taxYear %} hidden{% endif %}>
        <h2 class="slab-table-title">Salary tax slabs {{ table.year }}</h2>
        <div class="table-wrapper">
          <table class="table slab-table">
            <caption class="visually-hidden">Income tax slabs for salaried individuals, tax year {{ table.year }}</caption>
            <thead>
              <tr>
                <th scope="col">Annual taxable salary</th>
                <th scope="col">Income tax</th>
              </tr>
            </thead>
            <tbody>
              {% for row in table.rows %}
              <tr data-slab="{{ row.index }}">
                <td>{% if row.to %}{{ row.from }} to {{ row.to }}{% else %}Above {{ row.over }}{% endif %}<span class="slab-you"> · your slab</span></td>
                <td>{% if row.isZero %}0%{% elif row.fixed == 0 %}{{ row.rate }} of the amount over {{ row.over }}{% else %}{{ row.fixedText }} + {{ row.rate }} of the amount over {{ row.over }}{% endif %}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% if table.year == pakistanSalaryTax.previousTaxYear and pakistanSalaryTax.previousSurcharge %}
        <p class="slab-table-note">Plus a surcharge of {{ (pakistanSalaryTax.previousSurcharge.rate * 100) | round }}% of the tax when taxable income exceeds Rs 10,000,000.</p>
        {% elif table.year == pakistanSalaryTax.taxYear %}
        <p class="slab-table-note">No surcharge for salaried individuals in {{ table.year }}.</p>
        {% endif %}
      </div>
      {% endfor %}

      <div class="tool-note">
