---
layout: layouts/tool.njk
toolSlug: sip-calculator
permalink: /tools/sip-calculator/
extraCss: "/tools/sip-calculator/style.css"
---
{% from "partials/currency-select.njk" import currencySelect, countryData with context %}
{{ countryData(countries) }}

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <form id="calculator-form" novalidate>
        <div class="form-grid two-col">
          
          {{ currencySelect({ id: "currency", param: "cur", selected: "USD" }) }}

          <div class="form-group">
            <label for="monthly-investment">{{ 'label.monthly-investment' | pt }}</label>
            <input type="number" step="any" min="1" id="monthly-investment" data-param="inv" class="form-control" placeholder="{{ 'placeholder.monthly-investment' | pt }}" required aria-required="true">
          </div>

          <div class="form-group">
            <label for="expected-return">{{ 'label.expected-return' | pt }}</label>
            <input type="number" step="0.1" min="0" max="100" id="expected-return" data-param="ret" class="form-control" placeholder="{{ 'placeholder.expected-return' | pt }}" required aria-required="true">
          </div>

          <div class="form-group">
            <label for="investment-years">{{ 'label.investment-years' | pt }}</label>
            <input type="number" step="1" min="1" max="50" id="investment-years" data-param="yrs" class="form-control" placeholder="{{ 'placeholder.investment-years' | pt }}" required aria-required="true">
          </div>

          <div class="form-group">
            <label for="step-up-percent">{{ 'label.step-up-percent' | pt }}</label>
            <input type="number" step="1" min="0" max="100" id="step-up-percent" data-param="step" class="form-control" placeholder="{{ 'placeholder.step-up-percent' | pt }}">
          </div>

        </div>

        <div class="button-group mt-6">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button1' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-btn">{{ 'text.reset-btn' | pt }}</button>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <!-- Result Box -->
      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          <span id="result-header-text">{{ 'text.result-header-text' | pt }}</span>
          <button type="button" class="btn btn-sm btn-ghost" id="copy-result-btn" title="{{ 'title.copy-result-btn' | pt }}" aria-label="{{ 'ariaLabel.copy-result-btn' | pt }}">
            {{ 'text.copy-result-btn' | pt }}
          </button>
        </div>
        <div class="result-primary" id="result-primary-text">{{ 'text.result-primary-text' | pt }}</div>
        
        <div class="result-grid">
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div1' | pt }}</div>
            <div class="result-stat-value text-accent" id="stat-maturity-value">$0.00</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div2' | pt }}</div>
            <div class="result-stat-value" id="stat-total-invested">$0.00</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div3' | pt }}</div>
            <div class="result-stat-value text-success" id="stat-estimated-returns">$0.00</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div4' | pt }}</div>
            <div class="result-stat-value" id="stat-wealth-multiplier">{{ 'text.stat-wealth-multiplier' | pt }}</div>
          </div>
        </div>

        <div class="assumption-alert">
          {{ 'content.tool.div5' | pt }}
        </div>

        <!-- Yearly Milestone Table -->
        <div class="sip-breakdown-card">
          <h3 class="sip-breakdown-title">{{ 'content.year-by-year-wealth-progression.heading' | pt }}</h3>
          <div class="sip-scroll-table" tabindex="0" role="region" aria-label="{{ 'ariaLabel.year-by-year-wealth-progression-div1' | pt }}">
            <table class="sip-table" aria-label="{{ 'ariaLabel.year-by-year-wealth-progression-table1' | pt }}">
              <thead>
                <tr>
                  <th>{{ 'content.year-by-year-wealth-progression.th1' | pt }}</th>
                  <th>{{ 'content.year-by-year-wealth-progression.th2' | pt }}</th>
                  <th>{{ 'content.year-by-year-wealth-progression.th3' | pt }}</th>
                  <th>{{ 'content.year-by-year-wealth-progression.th4' | pt }}</th>
                  <th>{{ 'content.year-by-year-wealth-progression.th5' | pt }}</th>
                </tr>
              </thead>
              <tbody id="sip-table-body">
                <!-- Rows injected by script.js -->
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- tool-end -->

    <!-- Reusable Financial Disclaimer -->
    {% include "partials/financial-disclaimer.njk" %}

    <!-- When to Use Section -->
    <section class="content-section" aria-labelledby="how-to-use-heading">
      <h2 id="how-to-use-heading">{{ 'text.how-to-use-heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-sip.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-sip.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-sip.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-sip.li4' | pt }}</li>
      </ul>
    </section>

