---
layout: layouts/tool.njk
toolSlug: text-case-converter
permalink: /tools/text-case-converter/
extraCss: "/tools/text-case-converter/style.css"
lastReviewed: "2026-10-24"
---

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <div class="form-group">
        <label for="text-input" class="row-between">
          {{ 'label.text-input' | pt }}
        </label>
        <textarea id="text-input" class="form-control textarea-tall" rows="8" placeholder="{{ 'placeholder.text-input' | pt }}"></textarea>
      </div>

      <!-- Live character / word count bar -->
      <div id="char-stats" class="text-sm text-secondary mt-2" aria-live="polite">
        {{ 'text.char-stats' | pt }}
      </div>

      <div class="mt-6">
        <label class="font-semibold text-sm text-primary">{{ 'content.tool.label1' | pt }}</label>
        <div class="case-btn-grid auto-grid auto-grid-sm mt-3">
          <button type="button" class="btn btn-sm btn-secondary case-btn" data-case="upper">{{ 'content.tool.button1' | pt }}</button>
          <button type="button" class="btn btn-sm btn-secondary case-btn" data-case="lower">{{ 'content.tool.button2' | pt }}</button>
          <button type="button" class="btn btn-sm btn-secondary case-btn" data-case="title">{{ 'content.tool.button3' | pt }}</button>
          <button type="button" class="btn btn-sm btn-secondary case-btn" data-case="sentence">{{ 'content.tool.button4' | pt }}</button>
          <button type="button" class="btn btn-sm btn-secondary case-btn" data-case="capitalize">{{ 'content.tool.button5' | pt }}</button>
          <button type="button" class="btn btn-sm btn-secondary case-btn" data-case="camel">{{ 'content.tool.button6' | pt }}</button>
          <button type="button" class="btn btn-sm btn-secondary case-btn" data-case="pascal">{{ 'content.tool.button7' | pt }}</button>
          <button type="button" class="btn btn-sm btn-secondary case-btn" data-case="snake">{{ 'content.tool.button8' | pt }}</button>
          <button type="button" class="btn btn-sm btn-secondary case-btn" data-case="kebab">{{ 'content.tool.button9' | pt }}</button>
          <button type="button" class="btn btn-sm btn-secondary case-btn" data-case="constant">{{ 'content.tool.button10' | pt }}</button>
          <button type="button" class="btn btn-sm btn-secondary case-btn" data-case="dot">{{ 'content.tool.button11' | pt }}</button>
          <button type="button" class="btn btn-sm btn-secondary case-btn" data-case="alternating">{{ 'content.tool.button12' | pt }}</button>
        </div>
      </div>

      <div class="button-group mt-6">
        <button type="button" class="btn btn-primary" id="copy-btn">{{ 'text.copy-btn' | pt }}</button>
        <button type="button" class="btn btn-secondary" id="undo-btn" disabled>{{ 'text.undo-btn' | pt }}</button>
        <button type="button" class="btn btn-ghost" id="clear-btn">{{ 'text.clear-btn' | pt }}</button>
      </div>
    </section>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section">
      <h2>{{ 'content.how-when-to-use-the-text.heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-text.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-text.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-text.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-text.li4' | pt }}</li>
      </ul>
    </section>

    <!-- Key Facts & Conversion Reference Table -->
