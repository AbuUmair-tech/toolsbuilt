    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="Coin Flip and Dice Roller">
      <div class="segmented-control mb-6" role="tablist" aria-label="Coin or dice">
        <button type="button" class="btn btn-sm mode-tab-btn active" id="tab-coin" data-mode="coin" role="tab" aria-selected="true" aria-controls="calculator-form">Coin flip</button>
        <button type="button" class="btn btn-sm mode-tab-btn" id="tab-dice" data-mode="dice" role="tab" aria-selected="false" aria-controls="calculator-form" tabindex="-1">Dice roller</button>
      </div>

      <form id="calculator-form" role="tabpanel" aria-labelledby="tab-coin" novalidate>
        <input type="hidden" id="mode" data-param="mode" value="coin">
        <div class="form-grid two-col" data-mode-field="coin">
          <div class="form-group">
            <label for="coin-count">Number of coins</label>
            <input type="number" inputmode="numeric" step="1" min="1" max="100" id="coin-count" data-param="coins" class="form-control" value="1">
          </div>
        </div>
        <div class="form-grid two-col" data-mode-field="dice" hidden>
          <div class="form-group">
            <label for="dice-count">Number of dice</label>
