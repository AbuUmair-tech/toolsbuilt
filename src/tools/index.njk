---
layout: layouts/base.njk
title: "All Free Online Calculators & Web Tools - ToolsBuilt"
description: "Browse our complete directory of free online calculators, date utilities, financial tools, text counters, and password generators. 100% free and private."
permalink: /tools/index.html
canonical: https://toolsbuilt.com/tools/
---

{% block jsonLd %}
  <!-- JSON-LD Schema 1: BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://toolsbuilt.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "All Tools",
        "item": "https://toolsbuilt.com/tools/"
      }
    ]
  }
  </script>

  <!-- JSON-LD Schema 2: CollectionPage + ItemList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "All Free Online Calculators & Web Tools",
    "description": "{{ description }}",
    "url": "https://toolsbuilt.com/tools/",
    "mainEntity": {
      "@type": "ItemList",
      "name": "All Tools Built",
      "numberOfItems": {{ tools | length }},
      "itemListElement": [
        {% for t in tools %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": "{{ t.name }}",
          "description": "{{ t.description }}",
          "url": "https://toolsbuilt.com/tools/{{ t.slug }}/"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  }
  </script>
{% endblock %}

  <!-- Main Content -->
  <main class="container page-container" id="main-content">
    
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">All Tools</li>
      </ol>
    </nav>

    <!-- Page Header Hero -->
    <div class="directory-hero-header">
      <h1 class="directory-hero-title">All Calculators &amp; Web Tools</h1>
      <p class="directory-hero-subtitle">Browse our complete directory of {{ tools | length }} free, fast, and privacy-respecting online utilities across {{ categories | length }} categories.</p>
      
      <!-- Live Directory Search Bar -->
      <div class="directory-search-wrapper">
        <svg class="search-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" id="directory-search" class="directory-search-input" placeholder="Search {{ tools | length }} tools by name, topic, or formula..." aria-label="Search all tools">
      </div>

      <!-- Category Filter Chips -->
      <div class="directory-filter-bar" role="toolbar" aria-label="Filter tools by category">
        <button type="button" class="tool-filter-chip is-active" data-category="all">
          All Tools <span class="chip-count">{{ tools | length }}</span>
        </button>
        {% for cat in categories %}
        <button type="button" class="tool-filter-chip" data-category="{{ cat.slug }}">
          <span class="quick-chip-dot" data-cat="{{ cat.slug }}"></span>
          {{ cat.name }} <span class="chip-count">{{ (tools | filterByCategory(cat.slug)) | length }}</span>
        </button>
        {% endfor %}
      </div>
    </div>

    <!-- Grouped by Category View (Default) -->
    <div id="directory-category-view" class="directory-view-container">
      {% for cat in categories %}
      {% set catTools = tools | filterByCategory(cat.slug) %}
      <section class="category-section directory-category-block" id="cat-block-{{ cat.slug }}" data-category="{{ cat.slug }}" aria-labelledby="cat-dir-title-{{ cat.slug }}">
        <div class="category-header">
          <div class="category-header-main">
            <div class="tool-icon-tile category-icon-tile" data-cat="{{ cat.slug }}">
              {% if cat.slug == 'date-time' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              {% elif cat.slug == 'math-finance' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line><path d="M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M8 18h.01M12 18h.01"></path></svg>
              {% elif cat.slug == 'text' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line></svg>
              {% elif cat.slug == 'security' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              {% elif cat.slug == 'fun' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3"></circle><line x1="12" y1="2" x2="12" y2="9"></line><line x1="12" y1="15" x2="12" y2="22"></line><line x1="2" y1="12" x2="9" y2="12"></line><line x1="15" y1="12" x2="22" y2="12"></line></svg>
              {% endif %}
            </div>
            <div>
              <h2 id="cat-dir-title-{{ cat.slug }}" class="category-title">{{ cat.name }}</h2>
              <p class="category-desc">{{ cat.description }}</p>
            </div>
          </div>
          <a href="{{ cat.slug | categoryUrl }}" class="btn btn-sm btn-ghost">View category &rarr;</a>
        </div>

        <div class="tools-grid">
          {% for tool in catTools %}
          <a href="/tools/{{ tool.slug }}/" class="tool-card" data-slug="{{ tool.slug }}" data-category="{{ tool.category }}">
            <div class="tool-card-header">
              <div class="tool-icon-tile" data-cat="{{ tool.category }}">
                {{ tool.icon | safe }}
              </div>
              <span class="tool-category-chip" data-cat="{{ tool.category }}">{{ cat.name }}</span>
            </div>
            <h3 class="tool-title">{{ tool.name }}</h3>
            <p class="tool-desc">{{ tool.description }}</p>
            <div class="tool-card-action">
              <span>Use Tool</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </div>
          </a>
          {% endfor %}
        </div>
      </section>
      {% endfor %}
    </div>

    <!-- No Matching Tools State -->
    <div id="directory-no-results" class="no-results-panel" hidden>
      <div class="no-results-icon" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
      </div>
      <h3 class="no-results-title">No tools match your query</h3>
      <p class="no-results-desc">Can't find the calculator you're looking for? Let us know and we'll build it.</p>
      <a href="/contact/" class="btn btn-secondary">Suggest a Tool</a>
    </div>

  </main>
