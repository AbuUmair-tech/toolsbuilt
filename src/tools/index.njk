---
layout: layouts/base.njk
permalink: /tools/index.html
canonical: https://toolsbuilt.com/tools/
---
{% import "partials/cards.njk" as cards with context %}

{% block jsonLd %}
  <!-- JSON-LD Schema 1: BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://toolsbuilt.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "All Tools",
        "item": "https://toolsbuilt.com/tools/"
      }
    ]
  }
  </script>

  <!-- JSON-LD Schema 2: CollectionPage + ItemList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "All Free Online Calculators & Web Tools",
    "description": "{{ description }}",
    "url": "https://toolsbuilt.com/tools/",
    "mainEntity": {
      "@type": "ItemList",
      "name": "All Tools Built",
      "numberOfItems": {{ tools | length }},
      "itemListElement": [
        {% for t in tools %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": "{{ t.name }}",
          "description": "{{ t.description }}",
          "url": "https://toolsbuilt.com/tools/{{ t.slug }}/"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  }
  </script>
{% endblock %}

  <!-- Main Content -->
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        
        <!-- Breadcrumb Navigation -->
        <nav class="breadcrumb" aria-label="{{ 'ariaLabel.tool-nav1' | pt }}">
          <ol>
            <li>{{ 'content.tool.li1' | pt }}</li>
            <li aria-current="page">{{ 'content.tool.li2' | pt }}</li>
          </ol>
        </nav>
    
        <!-- Page Header -->
        <div class="directory-hero-header">
          <p class="section-label">{{ 'content.tool.p1' | pt }}</p>
          <h1 class="directory-hero-title">{{ 'content.tool.heading' | pt }}</h1>
          <p class="directory-hero-subtitle">{{ 'hero.subtitle' | pt({ tools: tools | length, categories: categories | length }) }}</p>
    
          <!-- Live Directory Filter -->
          <div class="directory-search-wrapper">
            <svg class="search-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="search" id="directory-search" class="directory-search-input" placeholder="{{ 'search.placeholder' | pt({ count: tools | length }) }}" aria-label="{{ 'ariaLabel.directory-search' | pt }}">
          </div>
    
          <!-- Category Filter Chips -->
          <div class="directory-filter-bar" role="toolbar" aria-label="{{ 'ariaLabel.tool-div1' | pt }}">
            <button type="button" class="tool-filter-chip is-active" data-category="all">
              {{ 'content.tool.text1' | pt }} <span class="chip-count">{{ tools | length }}</span>
            </button>
            {% for cat in categories %}
            <button type="button" class="tool-filter-chip" data-category="{{ cat.slug }}">
              {{ cat.name }} <span class="chip-count">{{ (tools | filterByCategory(cat.slug)) | length }}</span>
            </button>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <div class="container page-container">

    <!-- Grouped by Category -->
    <div id="directory-category-view" class="directory-view-container">
      {% for cat in categories %}
      <section class="directory-category-block" id="cat-block-{{ cat.slug }}" data-category="{{ cat.slug }}" aria-labelledby="cat-dir-title-{{ cat.slug }}">
        <div class="directory-category-head">
          {{ cards.categoryTile(cat) }}
          <div>
            <h2 id="cat-dir-title-{{ cat.slug }}" class="directory-category-title"><a href="{{ cat.slug | categoryUrl }}">{{ cat.name }}</a></h2>
            <p class="directory-category-tagline">{{ cat.tagline }}</p>
          </div>
        </div>
        <ul class="tool-grid">
          {% for tool in tools | filterByCategory(cat.slug) %}
          <li>{{ cards.toolCard(tool, cat) }}</li>
          {% endfor %}
        </ul>
      </section>
      {% endfor %}
    </div>

    <!-- No Matching Tools State -->
    <div id="directory-no-results" class="no-results-panel" hidden>
      <h3 class="no-results-title">{{ 'content.no-tools-match-your-query.heading' | pt }}</h3>
      <p class="no-results-desc">{{ 'content.no-tools-match-your-query.p1' | pt }}</p>
      <a href="/contact/" class="btn btn-secondary">{{ 'content.no-tools-match-your-query.a1' | pt }}</a>
    </div>

    </div>
  </main>
