---
layout: layouts/base.njk
title: "All Free Online Calculators & Web Tools | ToolsBuilt"
description: "Browse our complete directory of free online calculators, date utilities, percentage tools, text counters, and password generators. 100% free and private."
permalink: /tools/index.html
canonical: https://toolsbuilt.com/tools/
---

{% block jsonLd %}
  <!-- JSON-LD Schema 1: BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://toolsbuilt.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "All Tools",
        "item": "https://toolsbuilt.com/tools/"
      }
    ]
  }
  </script>

  <!-- JSON-LD Schema 2: CollectionPage + ItemList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "All Free Online Calculators & Web Tools",
    "description": "{{ description }}",
    "url": "https://toolsbuilt.com/tools/",
    "mainEntity": {
      "@type": "ItemList",
      "name": "All Tools Built",
      "numberOfItems": {{ tools | length }},
      "itemListElement": [
        {% for t in tools %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": "{{ t.name }}",
          "description": "{{ t.description }}",
          "url": "https://toolsbuilt.com/tools/{{ t.slug }}/"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  }
  </script>
{% endblock %}

  <!-- Main Content -->
  <main class="container page-container" id="main-content">
    
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">All Tools</li>
      </ol>
    </nav>

    <!-- Page Header -->
    <div class="directory-hero-header">
      <h1 class="directory-hero-title">All Calculators &amp; Web Tools</h1>
      <p class="directory-hero-subtitle">Browse our complete directory of {{ tools | length }} free, fast, and privacy-respecting online utilities across {{ categories | length }} categories.</p>

      <!-- Live Directory Filter -->
      <div class="directory-search-wrapper">
        <svg class="search-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" id="directory-search" class="directory-search-input" placeholder="Filter {{ tools | length }} tools by name or topic" aria-label="Filter all tools">
      </div>

      <!-- Category Filter Chips -->
      <div class="directory-filter-bar" role="toolbar" aria-label="Filter tools by category">
        <button type="button" class="tool-filter-chip is-active" data-category="all">
          All <span class="chip-count">{{ tools | length }}</span>
        </button>
        {% for cat in categories %}
        <button type="button" class="tool-filter-chip" data-category="{{ cat.slug }}">
          {{ cat.name }} <span class="chip-count">{{ (tools | filterByCategory(cat.slug)) | length }}</span>
        </button>
        {% endfor %}
      </div>
    </div>

    <!-- Grouped by Category -->
    <div id="directory-category-view" class="directory-view-container">
      {% for cat in categories %}
      <section class="directory-category-block" id="cat-block-{{ cat.slug }}" data-category="{{ cat.slug }}" aria-labelledby="cat-dir-title-{{ cat.slug }}">
        <h2 id="cat-dir-title-{{ cat.slug }}" class="directory-category-title"><a href="{{ cat.slug | categoryUrl }}">{{ cat.name }}</a></h2>
        <ul class="tool-rows">
          {% for tool in tools | filterByCategory(cat.slug) %}
          <li>
            <a href="/tools/{{ tool.slug }}/" class="tool-row" data-slug="{{ tool.slug }}" data-category="{{ tool.category }}">
              <span class="tool-row-name">{{ tool.name }}</span>
              <span class="tool-row-desc">{{ tool.shortDescription or tool.description }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </section>
      {% endfor %}
    </div>

    <!-- No Matching Tools State -->
    <div id="directory-no-results" class="no-results-panel" hidden>
      <h3 class="no-results-title">No tools match your query</h3>
      <p class="no-results-desc">Can't find the calculator you're looking for? Let us know and we'll build it.</p>
      <a href="/contact/" class="btn btn-secondary">Suggest a Tool</a>
    </div>

  </main>
