---
layout: layouts/tool.njk
toolSlug: url-encoder-decoder
permalink: /tools/url-encoder-decoder/
extraCss: /tools/url-encoder-decoder/style.css
---

    <!-- Main Tool Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <div class="url-controls-bar">
        <div class="mode-radio-group">
          <span class="text-sm font-bold text-secondary uppercase">{{ 'content.tool.span1' | pt }}</span>
          <label class="mode-radio-label">
            {{ 'content.tool.label1' | pt }}
          </label>
          <label class="mode-radio-label">
            {{ 'content.tool.label2' | pt }}
          </label>
        </div>

        <div class="mode-radio-group">
          <span class="text-sm font-bold text-secondary uppercase">{{ 'content.tool.span2' | pt }}</span>
          <label class="mode-radio-label" title="{{ 'title.tool-label1' | pt }}">
            {{ 'content.tool.label3' | pt }}
          </label>
          <label class="mode-radio-label" title="{{ 'title.tool-label2' | pt }}">
            {{ 'content.tool.label4' | pt }}
          </label>
          <button type="button" class="btn btn-ghost btn-sm ml-2" id="clear-btn">{{ 'text.clear-btn' | pt }}</button>
        </div>
      </div>

      <div class="url-editor-grid">
        <div class="form-group mb-0">
          <div class="row-between mb-2">
            <label for="url-input" id="input-label" class="font-semibold">{{ 'label.url-input' | pt }}</label>
            <span id="size-meter" class="text-sm text-secondary">{{ 'text.size-meter' | pt }}</span>
          </div>
          <textarea id="url-input" class="url-textarea" rows="8" placeholder="{{ 'placeholder.url-input' | pt }}"></textarea>
        </div>

        <div class="form-group mb-0">
          <div class="row-between mb-2">
            <label for="url-output" id="output-label" class="font-semibold">{{ 'label.url-output' | pt }}</label>
          </div>
          <textarea id="url-output" class="url-textarea" rows="8" readonly placeholder="{{ 'placeholder.url-output' | pt }}"></textarea>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="button-group cluster mt-4">
        <button type="button" class="btn btn-primary" id="convert-btn">{{ 'text.convert-btn' | pt }}</button>
        <button type="button" class="btn btn-secondary" id="swap-btn">
          {{ 'text.swap-btn' | pt }}
        </button>
        <button type="button" class="btn btn-secondary" id="copy-btn">
          {{ 'text.copy-btn' | pt }}
        </button>
      </div>

      <!-- Live Status & Error Alert Container -->
      <div id="url-status" class="alert-box alert-info" hidden aria-live="polite"></div>

      <!-- Live Query String Parser Table -->
      <div id="query-table-container" class="query-table-wrapper" hidden>
        <div class="row-between mb-2">
          <h3 class="text-base m-0 text-primary">{{ 'content.parsed-query-string-parameters.heading' | pt }}</h3>
          <span id="query-count-badge" class="panel-card text-sm text-accent">{{ 'text.query-count-badge' | pt }}</span>
        </div>
        <div tabindex="0" class="overflow-x-auto">
          <table class="query-table" aria-label="{{ 'ariaLabel.parsed-query-string-parameters-table1' | pt }}">
            <thead>
              <tr>
                <th scope="col" class="w-25p">{{ 'content.parsed-query-string-parameters.th1' | pt }}</th>
                <th scope="col" class="w-35p">{{ 'content.parsed-query-string-parameters.th2' | pt }}</th>
                <th scope="col" class="w-40p">{{ 'content.parsed-query-string-parameters.th3' | pt }}</th>
              </tr>
            </thead>
            <tbody id="query-table-body"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section" aria-labelledby="how-to-use-heading">
      <h2 id="how-to-use-heading">{{ 'text.how-to-use-heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-url.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-url.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-url.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-url.li4' | pt }}</li>
      </ul>
    </section>

    <!-- Worked Examples & Comparison Section -->
    <section class="content-section" aria-labelledby="article-heading">
      <h2 id="article-heading">{{ 'text.article-heading' | pt }}</h2>
      <p class="text-secondary">{{ 'content.url-encoding-specification-mode-comparison.p1' | pt }}</p>

      <div tabindex="0" class="overflow-x-auto mt-4">
        <table class="query-table bg-muted rounded-md p-2" aria-label="{{ 'ariaLabel.url-encoding-specification-mode-comparison-table1' | pt }}">
          <thead>
            <tr>
              <th scope="col">{{ 'content.url-encoding-specification-mode-comparison.th1' | pt }}</th>
              <th scope="col">{{ 'content.url-encoding-specification-mode-comparison.th2' | pt }}</th>
              <th scope="col">{{ 'content.url-encoding-specification-mode-comparison.th3' | pt }}</th>
              <th scope="col">{{ 'content.url-encoding-specification-mode-comparison.th4' | pt }}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td1' | pt }}</td>
              <td><code>%20</code></td>
              <td><code>%20</code></td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td2' | pt }}</td>
            </tr>
            <tr>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td3' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td4' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td5' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td6' | pt }}</td>
            </tr>
            <tr>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td7' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td8' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td9' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td10' | pt }}</td>
            </tr>
            <tr>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td11' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td12' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td13' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td14' | pt }}</td>
            </tr>
            <tr>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td15' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td16' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td17' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td18' | pt }}</td>
            </tr>
            <tr>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td19' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td20' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td21' | pt }}</td>
              <td>{{ 'content.url-encoding-specification-mode-comparison.td22' | pt }}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

