---
layout: layouts/tool.njk
toolSlug: gpa-calculator
permalink: /tools/gpa-calculator/
lastReviewed: "2026-10-24"
---

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <form id="gpa-form" novalidate>
        
        <!-- Global Options: Plus/Minus Toggle & Prior History -->
        <div class="panel-muted mb-6">
          <div class="flex justify-between items-center flex-wrap gap-4 mb-4">
            <div>
              <label for="toggle-plus-minus" class="font-semibold text-sm cursor-pointer flex items-center gap-2">
                {{ 'label.toggle-plus-minus' | pt }}
              </label>
              <span class="text-sm text-secondary block mt-1">{{ 'content.tool.span1' | pt }}</span>
            </div>
          </div>

          <div class="form-grid two-col mt-4 border-t pt-4">
            <div class="form-group">
              <label for="prior-gpa-val">{{ 'label.prior-gpa-val' | pt }}</label>
              <input type="number" step="0.01" min="0" max="4.00" id="prior-gpa-val" class="form-control" placeholder="{{ 'placeholder.prior-gpa-val' | pt }}">
            </div>
            <div class="form-group">
              <label for="prior-credits-val">{{ 'label.prior-credits-val' | pt }}</label>
              <input type="number" step="any" min="0" max="300" id="prior-credits-val" class="form-control" placeholder="{{ 'placeholder.prior-credits-val' | pt }}">
            </div>
          </div>
        </div>

        <!-- Semesters Container -->
        <div id="semesters-container">
          <!-- Populated by script.js -->
        </div>

        <div class="flex gap-3 flex-wrap mb-6">
          <button type="button" class="btn btn-secondary" id="add-semester-btn">
            {{ 'text.add-semester-btn' | pt }}
          </button>
        </div>

        <div class="button-group">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button1' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-gpa-form">{{ 'text.reset-gpa-form' | pt }}</button>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <!-- Result Box -->
      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          <span id="result-header-text">{{ 'text.result-header-text' | pt }}</span>
          <button type="button" class="btn btn-sm btn-ghost" id="copy-result-btn" title="{{ 'title.copy-result-btn' | pt }}" aria-label="{{ 'ariaLabel.copy-result-btn' | pt }}">
            {{ 'text.copy-result-btn' | pt }}
          </button>
        </div>
        <div class="result-primary" id="result-primary-text">3.71 / 4.00</div>
        
        <div class="result-grid" id="result-stats-grid">
          <!-- Dynamic stats -->
        </div>

        <div class="formula-box content-panel" id="formula-explanation">
          <!-- Breakdown -->
        </div>
      </div>
    </section>

    <!-- Important Notice Callout: Different School Scales -->
    <div class="tool-note">
      <h3 class="tool-note-title">{{ 'content.grading-scale-notice.heading' | pt }}</h3>
      <p>{{ 'content.grading-scale-notice.p1' | pt }}</p>
    </div>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section" aria-labelledby="how-to-use-heading">
      <h2 id="how-to-use-heading">{{ 'text.how-to-use-heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-gpa.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-gpa.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-gpa.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-gpa.li4' | pt }}</li>
      </ul>
    </section>

