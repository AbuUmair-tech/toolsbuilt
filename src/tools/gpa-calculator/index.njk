    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="GPA Calculator Form">
      <form id="gpa-form" novalidate>
        
        <!-- Global Options: Plus/Minus Toggle & Prior History -->
        <div style="background: var(--surface-muted); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.5rem;">
