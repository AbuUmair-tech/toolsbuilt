    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="Time Zone Converter">
      <form id="tz-form" novalidate>
        <div class="form-grid tz-source-grid">
          <div class="form-group">
            <label for="tz-date">Date <span class="text-accent">*</span></label>
            <input type="date" id="tz-date" data-param="date" class="form-control" required aria-required="true">
          </div>
          <div class="form-group">
            <label for="tz-time">Time <span class="text-accent">*</span></label>
            <input type="time" id="tz-time" data-param="time" class="form-control" required aria-required="true">
          </div>
          <div class="form-group tz-zone-field">
            <label for="tz-from">In time zone <span class="text-accent">*</span></label>
            <div class="input-with-button">
              <input type="text" id="tz-from" data-param="from" class="form-control tz-zone-input" list="tz-list" autocomplete="off" spellcheck="false" placeholder="City, country or zone" required aria-required="true" aria-describedby="tz-from-hint">
              <button type="button" class="btn btn-secondary" id="tz-now-btn">Now</button>
            </div>
            <p class="form-hint" id="tz-from-hint">Defaults to your own time zone.</p>
          </div>
        </div>

        <fieldset class="tz-fieldset">
          <legend>Convert to (up to 4 zones)</legend>
          <div class="form-grid tz-target-grid">
            {% for i in [1, 2, 3, 4] %}
            <div class="form-group">
              <label for="tz-z{{ i }}">Zone {{ i }}{% if i > 1 %} <span class="label-hint">(optional)</span>{% endif %}</label>
              <input type="text" id="tz-z{{ i }}" data-param="z{{ i }}" class="form-control tz-zone-input tz-target" list="tz-list" autocomplete="off" spellcheck="false" placeholder="e.g. London, Pakistan, PST">
            </div>
            {% endfor %}
          </div>
          <p class="form-hint">Search by city, country, abbreviation (PST, CET) or IANA name such as Asia/Karachi. Leave a box empty to skip it.</p>
        </fieldset>
        <datalist id="tz-list"></datalist>

        <div class="button-group mt-6">
          <button type="submit" class="btn btn-primary">Convert Time</button>
          <button type="button" class="btn btn-secondary" id="tz-swap-btn">Swap first two</button>
          <button type="button" class="btn btn-secondary" id="reset-btn">Reset</button>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          <span id="result-header-text">Converted time</span>
          <button type="button" class="btn btn-sm btn-ghost" id="copy-result-btn" title="Copy result to clipboard" aria-label="Copy result to clipboard">
            <span data-icon="copy"></span> Copy Result
          </button>
        </div>
        <div class="result-primary tz-primary" id="result-primary-text">--</div>
        <p class="form-hint" id="tz-note"></p>
        <ul class="tz-cards" id="tz-cards"></ul>
      </div>

      <h2 class="tz-heading">Working hours overlap</h2>
      <p class="form-hint" id="overlap-summary"></p>
      <div class="table-wrapper tz-strip-wrapper" tabindex="0" role="region" aria-labelledby="overlap-caption">
        <table class="tz-strip" id="tz-strip">
          <caption id="overlap-caption" class="visually-hidden">Local hour in each zone for 24 hours from midnight in the first zone. Shaded cells are 09:00 to 17:00.</caption>
        </table>
      </div>
      <p class="tz-legend">
        <span class="tz-legend-item"><span class="tz-swatch tz-swatch-work" aria-hidden="true"></span> 09:00–17:00 local</span>
        <span class="tz-legend-item"><span class="tz-swatch tz-swatch-overlap" aria-hidden="true"></span> Everyone in working hours</span>
        <span class="tz-legend-item"><span class="tz-swatch tz-swatch-selected" aria-hidden="true"></span> Selected time</span>
      </p>
    </section>

