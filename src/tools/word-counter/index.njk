---
layout: layouts/tool.njk
toolSlug: word-counter
permalink: /tools/word-counter/
lastReviewed: "2026-10-24"
---

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <div class="form-group">
        <label for="text-input" class="row-between">
          {{ 'label.text-input' | pt }}
        </label>
        <textarea id="text-input" class="form-control textarea-tall" rows="8" placeholder="{{ 'placeholder.text-input' | pt }}"></textarea>
      </div>

      <div class="button-group mt-4">
        <button type="button" class="btn btn-primary" id="copy-btn">{{ 'text.copy-btn' | pt }}</button>
        <button type="button" class="btn btn-secondary" id="copy-stats-btn">{{ 'text.copy-stats-btn' | pt }}</button>
        <button type="button" class="btn btn-ghost" id="clear-btn">{{ 'text.clear-btn' | pt }}</button>
      </div>

      <!-- Live Results Cards -->
      <div class="section-divider" aria-live="polite">
        <h3 class="text-md mb-4">{{ 'content.live-text-statistics.heading' | pt }}</h3>
        
        <div class="result-grid">
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.live-text-statistics.div1' | pt }}</div>
            <div class="result-stat-value" id="stat-words">0</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.live-text-statistics.div2' | pt }}</div>
            <div class="result-stat-value" id="stat-chars-space">0</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.live-text-statistics.div3' | pt }}</div>
            <div class="result-stat-value" id="stat-chars-nospace">0</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.live-text-statistics.div4' | pt }}</div>
            <div class="result-stat-value" id="stat-sentences">0</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.live-text-statistics.div5' | pt }}</div>
            <div class="result-stat-value" id="stat-paragraphs">0</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.live-text-statistics.div6' | pt }}</div>
            <div class="result-stat-value" id="stat-reading-time">{{ 'text.stat-reading-time' | pt }}</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.live-text-statistics.div7' | pt }}</div>
            <div class="result-stat-value" id="stat-speaking-time">{{ 'text.stat-speaking-time' | pt }}</div>
          </div>
        </div>

        <div class="panel-muted mt-6">
          <h4 class="text-base mb-3 text-primary">{{ 'content.live-text-statistics.heading-2' | pt }}</h4>
          <ul id="top-words-list" class="list-none p-0 m-0">
            <li class="text-secondary text-sm">{{ 'content.live-text-statistics.li1' | pt }}</li>
          </ul>
        </div>

      </div>
    </section>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section">
      <h2>{{ 'content.how-when-to-use-the-word.heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-word.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-word.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-word.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-word.li4' | pt }}</li>
      </ul>
    </section>
