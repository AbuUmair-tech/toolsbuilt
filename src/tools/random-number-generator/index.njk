            <tr><td>Six-sided die</td><td>1–6</td><td>1 in 6 (16.67%)</td></tr>
            <tr><td>Percentage roll</td><td>1–100</td><td>1 in 100 (1%)</td></tr>
            <tr><td>Day of the year</td><td>1–365</td><td>1 in 365 (0.27%)</td></tr>
            <tr><td>Four-digit PIN</td><td>0–9999</td><td>1 in 10,000 (0.01%)</td></tr>
          </tbody>
