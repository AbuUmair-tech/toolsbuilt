    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="URL Slug Generator">
      <div class="segmented-control mb-6" role="tablist" aria-label="Single or bulk">
        <button type="button" class="btn btn-sm mode-tab-btn active" id="tab-single" data-mode="single" role="tab" aria-selected="true" aria-controls="slug-form">Single title</button>
        <button type="button" class="btn btn-sm mode-tab-btn" id="tab-bulk" data-mode="bulk" role="tab" aria-selected="false" aria-controls="slug-form" tabindex="-1">Bulk (one per line)</button>
      </div>

      <form id="slug-form" role="tabpanel" aria-labelledby="tab-single" novalidate>
        <div class="form-group" data-mode-field="single">
          <label for="slug-input">Title</label>
          <input type="text" id="slug-input" class="form-control" autocomplete="off" value="Héllo, Wörld! 2026">
        </div>
        <div class="form-group" data-mode-field="bulk" hidden>
          <label for="slug-bulk">Titles (one per line)</label>
          <textarea id="slug-bulk" class="form-control slug-textarea" rows="8" spellcheck="false" autocomplete="off">10 Tips for Better Sleep
Café Menu & Prices
How to Write the Best Guide
10 Tips for Better Sleep</textarea>
        </div>

        <div class="form-grid slug-options">
          <div class="form-group">
            <label for="slug-sep">Separator</label>
            <select id="slug-sep" class="form-control">
              <option value="-" selected>Hyphen -</option>
              <option value="_">Underscore _</option>
            </select>
          </div>
          <div class="form-group">
            <label for="slug-max">Max length <span class="label-hint">(0 = no limit)</span></label>
            <input type="number" inputmode="numeric" min="0" max="500" step="1" id="slug-max" class="form-control" value="0">
          </div>
        </div>
        <div class="slug-checks">
          <label class="checkbox-label"><input type="checkbox" id="slug-lower" checked><span>Lowercase</span></label>
          <label class="checkbox-label"><input type="checkbox" id="slug-stop"><span>Remove English stop words</span></label>
          <label class="checkbox-label" data-mode-field="bulk" hidden><input type="checkbox" id="slug-unique" checked><span>Number repeated slugs (-2, -3 …)</span></label>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          <span id="result-header-text">Slug</span>
        </div>
        <div class="result-primary slug-primary" id="result-primary-text">--</div>
        <p class="form-hint" id="slug-note"></p>
        <label for="slug-output" class="slug-output-label" data-mode-field="bulk" hidden>Slugs</label>
        <textarea id="slug-output" class="form-control slug-textarea" rows="8" readonly spellcheck="false" data-mode-field="bulk" hidden></textarea>
        <div class="button-group mt-4">
          <button type="button" class="btn btn-sm btn-secondary" id="copy-slug-btn">Copy</button>
          <button type="button" class="btn btn-sm btn-secondary" id="download-btn" data-mode-field="bulk" hidden>Download .txt</button>
        </div>
      </div>
    </section>

    <!-- tool-end -->

