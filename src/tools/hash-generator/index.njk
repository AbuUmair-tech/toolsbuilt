---
layout: layouts/tool.njk
toolSlug: hash-generator
permalink: /tools/hash-generator/
extraCss: "/tools/hash-generator/style.css"
lastReviewed: "2026-10-24"
---

<div class="tool-container hash-container" aria-label="{{ 'ariaLabel.tool-div1' | pt }}">

  <!-- Prominent Security Advisory Warning -->
  <div class="hash-warning-banner" role="alert">
    <span data-icon="warning" class="shrink-0"></span>
    <div>
      {{ 'content.tool.div1' | pt }}
    </div>
  </div>

  <!-- Text Input Section -->
  <div class="form-group">
    <div class="row-between mb-2">
      <label for="hash-input-text" class="font-semibold mb-0">{{ 'label.hash-input-text' | pt }}</label>
      <div class="flex items-center gap-4">
        <label class="checkbox-label flex items-center gap-2 cursor-pointer text-sm">
          {{ 'content.tool.label1' | pt }}
        </label>
        <button type="button" class="btn btn-secondary btn-sm" id="clear-input-btn">
          {{ 'text.clear-input-btn' | pt }}
        </button>
      </div>
    </div>
    <textarea id="hash-input-text" class="form-control hash-input-area" placeholder="{{ 'placeholder.hash-input-text' | pt }}" aria-label="{{ 'ariaLabel.hash-input-text' | pt }}"></textarea>
    <div class="hash-input-meta">
      {{ 'content.tool.div2' | pt }}
    </div>
  </div>

  <!-- Hash Cards Outputs -->
  <div class="hash-cards-grid">
    
    <!-- SHA-256 Card (Primary) -->
    <div class="hash-card" id="card-sha256">
      <div class="hash-card-header">
        <div class="hash-algo-title">
          {{ 'content.tool.div3' | pt }}
        </div>
        <span class="text-sm text-secondary">{{ 'content.tool.span1' | pt }}</span>
      </div>
      <div class="hash-card-body">
        <div id="hash-sha256-val" class="hash-value-display" aria-label="{{ 'ariaLabel.hash-sha256-val' | pt }}"></div>
        <button type="button" class="btn btn-primary btn-sm" data-copy-hash="SHA-256" aria-label="{{ 'ariaLabel.tool-button1' | pt }}">
          {{ 'content.tool.button1' | pt }}
        </button>
      </div>
    </div>

    <!-- SHA-512 Card -->
    <div class="hash-card" id="card-sha512">
      <div class="hash-card-header">
        <div class="hash-algo-title">
          {{ 'content.tool.div4' | pt }}
        </div>
        <span class="text-sm text-secondary">{{ 'content.tool.span2' | pt }}</span>
      </div>
      <div class="hash-card-body">
        <div id="hash-sha512-val" class="hash-value-display" aria-label="{{ 'ariaLabel.hash-sha512-val' | pt }}"></div>
        <button type="button" class="btn btn-primary btn-sm" data-copy-hash="SHA-512" aria-label="{{ 'ariaLabel.tool-button2' | pt }}">
          {{ 'content.tool.button2' | pt }}
        </button>
      </div>
    </div>

    <!-- SHA-384 Card -->
    <div class="hash-card" id="card-sha384">
      <div class="hash-card-header">
        <div class="hash-algo-title">
          {{ 'content.tool.div5' | pt }}
        </div>
        <span class="text-sm text-secondary">{{ 'content.tool.span3' | pt }}</span>
      </div>
      <div class="hash-card-body">
        <div id="hash-sha384-val" class="hash-value-display" aria-label="{{ 'ariaLabel.hash-sha384-val' | pt }}"></div>
        <button type="button" class="btn btn-secondary btn-sm" data-copy-hash="SHA-384" aria-label="{{ 'ariaLabel.tool-button3' | pt }}">
          {{ 'content.tool.button3' | pt }}
        </button>
      </div>
    </div>

    <!-- SHA-1 Card (Legacy) -->
    <div class="hash-card" id="card-sha1">
      <div class="hash-card-header">
        <div class="hash-algo-title">
          {{ 'content.tool.div6' | pt }}
        </div>
        <span class="text-sm text-secondary">{{ 'content.tool.span4' | pt }}</span>
      </div>
      <div class="hash-card-body">
        <div id="hash-sha1-val" class="hash-value-display" aria-label="{{ 'ariaLabel.hash-sha1-val' | pt }}"></div>
        <button type="button" class="btn btn-secondary btn-sm" data-copy-hash="SHA-1" aria-label="{{ 'ariaLabel.tool-button4' | pt }}">
          {{ 'content.tool.button4' | pt }}
        </button>
      </div>
    </div>

  </div>

  <!-- Compare Two Hashes Section -->
  <div class="hash-compare-section">
    <label for="hash-compare-input" class="font-semibold">{{ 'label.hash-compare-input' | pt }}</label>
    <input type="text" id="hash-compare-input" class="form-control font-mono text-sm" placeholder="{{ 'placeholder.hash-compare-input' | pt }}" aria-label="{{ 'ariaLabel.hash-compare-input' | pt }}">
    <div id="hash-compare-status" class="hash-match-status" aria-live="polite">
      {{ 'text.hash-compare-status' | pt }}
    </div>
  </div>

</div>


<!-- tool-end -->
