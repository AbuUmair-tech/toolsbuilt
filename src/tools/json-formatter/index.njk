---
layout: layouts/tool.njk
toolSlug: json-formatter
permalink: /tools/json-formatter/
extraCss: /tools/json-formatter/style.css
---

    <!-- Main Tool Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <div class="json-controls-bar">
        <div class="json-controls-group">
          <label for="indent-select" class="font-semibold text-sm">{{ 'label.indent-select' | pt }}</label>
          <select id="indent-select" class="form-control w-auto py-1 px-3 text-sm">
            <option value="2">{{ 'option.indent-select.2' | pt }}</option>
            <option value="4">{{ 'option.indent-select.4' | pt }}</option>
            <option value="tab">{{ 'option.indent-select.tab' | pt }}</option>
          </select>

          <label class="inline-flex items-center gap-2 text-sm ml-2 cursor-pointer">
            {{ 'content.tool.label1' | pt }}
          </label>
        </div>

        <div class="json-controls-group">
          <button type="button" class="btn btn-secondary btn-sm" id="sample-btn">{{ 'text.sample-btn' | pt }}</button>
          <button type="button" class="btn btn-ghost btn-sm" id="clear-btn">{{ 'text.clear-btn' | pt }}</button>
        </div>
      </div>

      <div class="json-editor-grid">
        <div class="form-group mb-0">
          <div class="row-between mb-2">
            <label for="json-input" class="font-semibold">{{ 'label.json-input' | pt }}</label>
            <span id="size-meter" class="text-sm text-secondary">{{ 'text.size-meter' | pt }}</span>
          </div>
          <textarea id="json-input" class="json-textarea" rows="12" placeholder='Paste your raw or minified JSON here... e.g. {"name":"example","items":[1,2,3]}'></textarea>
        </div>

        <div class="form-group mb-0">
          <div class="row-between mb-2">
            <label for="json-output" class="font-semibold">{{ 'label.json-output' | pt }}</label>
          </div>
          <textarea id="json-output" class="json-textarea" rows="12" readonly placeholder="{{ 'placeholder.json-output' | pt }}"></textarea>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="button-group cluster mt-4">
        <button type="button" class="btn btn-primary" id="format-btn">
          {{ 'text.format-btn' | pt }}
        </button>
        <button type="button" class="btn btn-secondary" id="minify-btn">{{ 'text.minify-btn' | pt }}</button>
        <button type="button" class="btn btn-secondary" id="validate-btn">{{ 'text.validate-btn' | pt }}</button>
        <button type="button" class="btn btn-secondary" id="copy-btn">
          {{ 'text.copy-btn' | pt }}
        </button>
        <button type="button" class="btn btn-ghost" id="download-btn">
          {{ 'text.download-btn' | pt }}
        </button>
      </div>

      <!-- Live Status & Error Alert Container -->
      <div id="json-status" class="alert-box alert-info" hidden aria-live="polite"></div>
    </section>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section" aria-labelledby="how-to-use-heading">
      <h2 id="how-to-use-heading">{{ 'text.how-to-use-heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-json.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-json.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-json.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-json.li4' | pt }}</li>
      </ul>
    </section>

    <!-- Worked Examples & Standards Section -->
    <section class="content-section" aria-labelledby="article-heading">
      <h2 id="article-heading">{{ 'text.article-heading' | pt }}</h2>
      <p class="text-secondary">{{ 'content.json-formatting-standards-indentation-formulas.p1' | pt }}</p>

      <div class="content-grid">
        <div class="content-box">
          <h3 class="content-box-title">{{ 'content.example-1-unformatted-input.heading' | pt }}</h3>
          <p class="content-note">{{ 'content.example-1-unformatted-input.p1' | pt }}</p>
          <pre tabindex="0" aria-label="{{ 'ariaLabel.example-1-unformatted-input-pre1' | pt }}" class="bg-card p-3 rounded-md text-sm overflow-x-auto"><code>{"id":101,"user":"alex","roles":["admin","editor"]}</code></pre>
        </div>

        <div class="content-box">
          <h3 class="content-box-title">{{ 'content.example-2-formatted-2-spaces.heading' | pt }}</h3>
          <p class="content-note">{{ 'content.example-2-formatted-2-spaces.p1' | pt }}</p>
          <pre tabindex="0" aria-label="{{ 'ariaLabel.example-2-formatted-2-spaces-pre1' | pt }}" class="bg-card p-3 rounded-md text-sm overflow-x-auto"><code>{
  "id": 101,
  "roles": [
    "admin",
    "editor"
  ],
  "user": "alex"
}</code></pre>
        </div>

        <div class="content-box">
          <h3 class="content-box-title">{{ 'content.example-3-key-sorting-comparison.heading' | pt }}</h3>
          <p class="content-note">{{ 'content.example-3-key-sorting-comparison.p1' | pt }}</p>
          <ul class="content-list content-list-sm">
            <li>{{ 'content.example-3-key-sorting-comparison.li1' | pt }}</li>
            <li>{{ 'content.example-3-key-sorting-comparison.li2' | pt }}</li>
            <li>{{ 'content.example-3-key-sorting-comparison.li3' | pt }}</li>
          </ul>
        </div>
      </div>
    </section>

