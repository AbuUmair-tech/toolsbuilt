    <!-- Common Mistakes Section -->
    <section style="margin: 2.5rem 0;" aria-labelledby="mistakes-heading">
      <h2 id="mistakes-heading">Common JSON Syntax Errors &amp; Troubleshooting</h2>
      <ul style="color: var(--text-muted); line-height: 1.8; margin-left: 1.25rem;">
        <li><strong>Trailing Commas:</strong> Adding a comma after the final item in an array (<code>[1, 2, 3,]</code>) or object (<code>{"a": 1,}</code>) is valid in modern JavaScript but throws an immediate syntax error in standard JSON.</li>
        <li><strong>Single Quotes for Strings:</strong> JSON strictly requires double quotation marks (<code>"key": "value"</code>). Using single quotes (<code>'key': 'value'</code>) is rejected by all compliant JSON parsers.</li>
        <li><strong>Unquoted Object Keys:</strong> In JavaScript, keys can omit quotes (<code>{name: "value"}</code>). In JSON, keys must always be enclosed in double quotes.</li>
        <li><strong>Unescaped Control Characters:</strong> Literal unescaped tab characters or raw unescaped newlines inside string values break JSON parsing and must be escaped as <code>\t</code> or <code>\n</code>.</li>
      </ul>
    </section>
