---
layout: layouts/tool.njk
toolSlug: add-days-to-date-calculator
permalink: /tools/add-days-to-date-calculator/
lastReviewed: "2026-10-24"
---

<div class="tool-container">
  <div class="tool-form-grid">
    <div class="form-group">
      <label for="startDate">{{ 'label.startDate' | pt }}</label>
      <div class="input-with-button">
        <input type="date" id="startDate" data-param="start" class="form-input" autocomplete="off">
        <button type="button" id="todayBtn" class="btn btn-secondary btn-sm">{{ 'text.todayBtn' | pt }}</button>
      </div>
    </div>

    <div class="form-group">
      <label for="operation">{{ 'label.operation' | pt }}</label>
      <select id="operation" data-param="op" class="form-input" autocomplete="off">
        <option value="add" selected>{{ 'option.operation.add' | pt }}</option>
        <option value="subtract">{{ 'option.operation.subtract' | pt }}</option>
      </select>
    </div>

    <div class="form-group">
      <label for="amount">{{ 'label.amount' | pt }}</label>
      <input type="number" id="amount" data-param="amount" class="form-input" min="0" value="30" step="1" autocomplete="off">
    </div>

    <div class="form-group">
      <label for="unit">{{ 'label.unit' | pt }}</label>
      <select id="unit" data-param="unit" class="form-input" autocomplete="off">
        <option value="days" selected>{{ 'option.unit.days' | pt }}</option>
        <option value="weeks">{{ 'option.unit.weeks' | pt }}</option>
        <option value="months">{{ 'option.unit.months' | pt }}</option>
        <option value="years">{{ 'option.unit.years' | pt }}</option>
      </select>
    </div>
  </div>

  <div class="form-group mt-4">
    <label class="checkbox-label" id="businessDaysLabel">
      {{ 'text.businessDaysLabel' | pt }}
    </label>
    <p id="businessDaysNote" class="text-sm text-muted mt-2 hidden">{{ 'text.businessDaysNote' | pt }}</p>
  </div>

  <div class="button-group mt-4">
    <button type="button" id="calcBtn" class="btn btn-primary">{{ 'text.calcBtn' | pt }}</button>
    <button type="button" id="resetBtn" class="btn btn-secondary">{{ 'text.resetBtn' | pt }}</button>
  </div>

  <div class="result-box mt-6 is-visible" id="resultBox" aria-live="polite">
    <div class="result-header">
      <span class="result-title">{{ 'content.tool.span1' | pt }}</span>
      <button type="button" id="copyResultBtn" class="btn btn-sm btn-ghost" title="{{ 'title.copyResultBtn' | pt }}" aria-label="{{ 'ariaLabel.copyResultBtn' | pt }}">
        {{ 'text.copyResultBtn' | pt }}
      </button>
    </div>
    <div class="primary-result" id="primaryResult">{{ 'text.primaryResult' | pt }}</div>
    <div id="resultDetails" class="mt-4"></div>
  </div>
</div>

<!-- tool-end -->

<div class="article-content">
  <h2>{{ 'content.why-is-accurate-date-arithmetic-essential.heading' | pt }}</h2>
  <p>{{ 'content.why-is-accurate-date-arithmetic-essential.p1' | pt }}</p>

  <h2>{{ 'content.how-business-day-filtering-works.heading' | pt }}</h2>
  <p>{{ 'content.how-business-day-filtering-works.p1' | pt }}</p>
</div>
