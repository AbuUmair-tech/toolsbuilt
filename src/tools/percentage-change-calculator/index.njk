permalink: /tools/percentage-change-calculator/
h1: "Percentage Change Calculator"
quickAnswer: "To calculate the percentage change between an old number and a new number, subtract the old value from the new value, divide that difference by the absolute value of the old number, and multiply by 100. The tool also supports percent difference, parts of a whole, and direct percentage values."
formula:
  title: "Percentage Change & Difference Formulas"
  expression: "Percentage Change = ((New Value - Old Value) / |Old Value|) × 100"
  explanation: "Subtract the original baseline value (Old) from the ending value (New) to obtain the raw difference. Divide by the absolute value of the old number to preserve direction, then multiply by 100. For comparisons without a baseline, percentage difference divides absolute difference by the mean of both numbers."
workedExamples:
  - title: "Revenue Increase (+50%)"
    inputs:
      - "Old Value: $50,000"
      - "New Value: $75,000"
    steps:
      - "Calculate difference: $75,000 - $50,000 = +$25,000"
      - "Divide by original baseline: $25,000 ÷ $50,000 = 0.50"
      - "Multiply by 100: 0.50 × 100 = +50.00%"
    result: "+50.00% Increase (+$25,000 difference)"
  - title: "Price Reduction (-25%)"
    inputs:
      - "Old Value: $80.00"
      - "New Value: $60.00"
    steps:
      - "Calculate difference: $60.00 - $80.00 = -$20.00"
      - "Divide by original baseline: -$20.00 ÷ 80.00 = -0.25"
      - "Multiply by 100: -0.25 × 100 = -25.00%"
    result: "-25.00% Decrease (-$20.00 difference)"
  - title: "Percent Difference Between Two Lab Measurements"
    inputs:
      - "Measurement A: 100 units"
      - "Measurement B: 120 units"
    steps:
      - "Find absolute difference: |100 - 120| = 20"
      - "Find average of values: (100 + 120) ÷ 2 = 110"
      - "Divide difference by average: 20 ÷ 110 ≈ 0.181818"
      - "Multiply by 100: 0.181818 × 100 ≈ 18.18%"
    result: "18.18% Difference (Average: 110)"
  - title: "What is 25% of 200?"
    inputs:
      - "Percentage: 25%"
      - "Total: 200"
    steps:
      - "Convert percent to decimal: 25 ÷ 100 = 0.25"
      - "Multiply by total: 0.25 × 200 = 50"
    result: "50"
