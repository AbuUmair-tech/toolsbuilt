---
layout: layouts/tool.njk
toolSlug: percentage-change-calculator
permalink: /tools/percentage-change-calculator/
lastReviewed: "2026-10-24"
---

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      
      <!-- Segmented Mode Control Tabs -->
      <div class="segmented-control cluster cluster-sm mb-6" role="tablist" aria-label="{{ 'ariaLabel.tool-div1' | pt }}">
        <button type="button" class="btn btn-sm mode-tab-btn active" data-mode="mode-1" role="tab" aria-selected="true">{{ 'content.tool.button1' | pt }}</button>
        <button type="button" class="btn btn-sm mode-tab-btn" data-mode="mode-2" role="tab" aria-selected="false">{{ 'content.tool.button2' | pt }}</button>
        <button type="button" class="btn btn-sm mode-tab-btn" data-mode="mode-3" role="tab" aria-selected="false">{{ 'content.tool.button3' | pt }}</button>
        <button type="button" class="btn btn-sm mode-tab-btn" data-mode="mode-4" role="tab" aria-selected="false">{{ 'content.tool.button4' | pt }}</button>
      </div>

      <!-- Mode 1: Percentage Change Form -->
      <form id="mode-1-form" class="calculator-mode-form" novalidate>
        <div class="form-grid two-col">
          <div class="form-group">
            <label for="m1-old-val">{{ 'label.m1-old-val' | pt }}</label>
            <input type="number" step="any" id="m1-old-val" data-param="old" class="form-control" placeholder="{{ 'placeholder.m1-old-val' | pt }}" required aria-required="true">
          </div>
          <div class="form-group">
            <label for="m1-new-val">{{ 'label.m1-new-val' | pt }}</label>
            <input type="number" step="any" id="m1-new-val" data-param="new" class="form-control" placeholder="{{ 'placeholder.m1-new-val' | pt }}" required aria-required="true">
          </div>
        </div>

        <div class="button-group mt-4">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button5' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-mode-1">{{ 'text.reset-mode-1' | pt }}</button>
        </div>
      </form>

      <!-- Mode 2: Increase/Decrease Value Form -->
      <form id="mode-2-form" class="calculator-mode-form hidden" novalidate>
        <div class="form-grid">
          <div class="form-group">
            <label for="m2-operation">{{ 'label.m2-operation' | pt }}</label>
            <select id="m2-operation" data-param="op" class="form-control">
              <option value="increase">{{ 'option.m2-operation.increase' | pt }}</option>
              <option value="decrease">{{ 'option.m2-operation.decrease' | pt }}</option>
            </select>
          </div>
          <div class="form-grid two-col">
            <div class="form-group">
              <label for="m2-base-val">{{ 'label.m2-base-val' | pt }}</label>
              <input type="number" step="any" id="m2-base-val" data-param="base" class="form-control" placeholder="{{ 'placeholder.m2-base-val' | pt }}" required aria-required="true">
            </div>
            <div class="form-group">
              <label for="m2-percent-val">{{ 'label.m2-percent-val' | pt }}</label>
              <input type="number" step="any" id="m2-percent-val" data-param="pct" class="form-control" placeholder="{{ 'placeholder.m2-percent-val' | pt }}" required aria-required="true">
            </div>
          </div>
        </div>

        <div class="button-group mt-4">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button6' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-mode-2">{{ 'text.reset-mode-2' | pt }}</button>
        </div>
      </form>

      <!-- Mode 3: What Percent is X of Y Form -->
      <form id="mode-3-form" class="calculator-mode-form hidden" novalidate>
        <div class="form-grid two-col">
          <div class="form-group">
            <label for="m3-x-val">{{ 'label.m3-x-val' | pt }}</label>
            <input type="number" step="any" id="m3-x-val" data-param="x" class="form-control" placeholder="{{ 'placeholder.m3-x-val' | pt }}" required aria-required="true">
          </div>
          <div class="form-group">
            <label for="m3-y-val">{{ 'label.m3-y-val' | pt }}</label>
            <input type="number" step="any" id="m3-y-val" data-param="y" class="form-control" placeholder="{{ 'placeholder.m3-y-val' | pt }}" required aria-required="true">
          </div>
        </div>

        <div class="button-group mt-4">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button7' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-mode-3">{{ 'text.reset-mode-3' | pt }}</button>
        </div>
      </form>

      <!-- Mode 4: Percent Difference Form -->
      <form id="mode-4-form" class="calculator-mode-form hidden" novalidate>
        <div class="form-grid two-col">
          <div class="form-group">
            <label for="m4-a-val">{{ 'label.m4-a-val' | pt }}</label>
            <input type="number" step="any" id="m4-a-val" data-param="a" class="form-control" placeholder="{{ 'placeholder.m4-a-val' | pt }}" required aria-required="true">
          </div>
          <div class="form-group">
            <label for="m4-b-val">{{ 'label.m4-b-val' | pt }}</label>
            <input type="number" step="any" id="m4-b-val" data-param="b" class="form-control" placeholder="{{ 'placeholder.m4-b-val' | pt }}" required aria-required="true">
          </div>
        </div>

        <div class="button-group mt-4">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button8' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-mode-4">{{ 'text.reset-mode-4' | pt }}</button>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <!-- Result Box -->
      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          <span id="result-header-text">{{ 'text.result-header-text' | pt }}</span>
          <button type="button" class="btn btn-sm btn-ghost" id="copy-result-btn" title="{{ 'title.copy-result-btn' | pt }}" aria-label="{{ 'ariaLabel.copy-result-btn' | pt }}">
            {{ 'text.copy-result-btn' | pt }}
          </button>
        </div>
        <div class="result-primary" id="result-primary-text">--%</div>
        
        <div class="result-grid" id="result-stats-grid">
          <!-- Dynamic stat cards inserted by script.js -->
        </div>

        <div class="formula-box content-panel" id="formula-explanation">
          <!-- Step-by-step formula inserted by script.js -->
        </div>
      </div>
    </section>

    <!-- tool-end -->

    <section class="content-section" aria-labelledby="method-heading">
      <h2 id="method-heading">{{ 'text.method-heading' | pt }}</h2>
      <ol class="content-list">
        <li>{{ 'content.how-to-calculate-percentage-change-between.li1' | pt }}</li>
        <li>{{ 'content.how-to-calculate-percentage-change-between.li2' | pt }}</li>
        <li>{{ 'content.how-to-calculate-percentage-change-between.li3' | pt }}</li>
      </ol>
      <p>{{ 'content.how-to-calculate-percentage-change-between.p1' | pt }}</p>
    </section>

    <!-- When to Use Section -->
    <section class="content-section">
      <h2>{{ 'content.how-when-to-use-the-percentage.heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-percentage.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-percentage.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-percentage.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-percentage.li4' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-percentage.li5' | pt }}</li>
      </ul>
    </section>
