        <li>{{ 'content.pep-8-basics.li1' | pt }}</li>
        <li>{{ 'content.pep-8-basics.li2' | pt }}</li>
        <li>{{ 'content.pep-8-basics.li3' | pt }}</li>
        <li>{{ 'content.pep-8-basics.li4' | pt }}</li>
        <li>{{ 'content.pep-8-basics.li5' | pt }}</li>
      </ul>
      <p>{{ 'content.pep-8-basics.p2' | pt }}</p>
    </section>

    <section class="content-section" aria-labelledby="ruff-style-heading">
      <h2 id="ruff-style-heading">{{ 'text.ruff-style-heading' | pt }}</h2>
      <p>{{ 'content.how-ruff-and-black-style-differs.p1' | pt }}</p>
      <ul class="content-list">
        <li>{{ 'content.how-ruff-and-black-style-differs.li1' | pt }}</li>
