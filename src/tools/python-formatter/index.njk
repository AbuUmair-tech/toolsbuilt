---
layout: layouts/tool.njk
toolSlug: python-formatter
permalink: /tools/python-formatter/
lastReviewed: "2026-10-31"
---
{% from "partials/code-formatter.njk" import codeFormatter with context %}

    {% call codeFormatter({ language: "Python", importMap: vendor.importMaps.python, engine: 'value.engine' | pt({ name: vendor.packages.ruff.name, version: vendor.packages.ruff.version }), sample: "import os,sys\ndef  calculate_total( items,tax_rate = 0.18 ) :\n  subtotal=sum( item['price']*item['qty'] for item in items )\n  return subtotal*( 1+tax_rate )\nclass   Account :\n    def __init__(self,owner,balance=0):\n        self.owner=owner;self.balance=balance\n    def deposit(self,amount):\n        if amount<=0: raise ValueError('Deposit must be positive')\n        self.balance+=amount\n        return self.balance\nconfig = {'host':'localhost','port':5432,'database':'inventory','user':'admin','options':{'sslmode':'require','connect_timeout':10}}\n" }) %}
      <div class="form-group">
        <label for="opt-line-length">{{ 'label.opt-line-length' | pt }}</label>
        <select id="opt-line-length" class="form-control" data-option="lineLength">
          <option value="79">{{ 'option.opt-line-length.79' | pt }}</option>
          <option value="88" selected>{{ 'option.opt-line-length.88' | pt }}</option>
          <option value="100">100</option>
          <option value="120">120</option>
        </select>
      </div>
      <div class="form-group">
        <label for="opt-indent">{{ 'label.opt-indent' | pt }}</label>
        <select id="opt-indent" class="form-control" data-option="indentWidth">
          <option value="4" selected>{{ 'option.opt-indent.4' | pt }}</option>
          <option value="2">{{ 'option.opt-indent.2' | pt }}</option>
        </select>
      </div>
      <div class="form-group">
        <label for="opt-quotes">{{ 'label.opt-quotes' | pt }}</label>
        <select id="opt-quotes" class="form-control" data-option="quoteStyle">
          <option value="double" selected>{{ 'option.opt-quotes.double' | pt }}</option>
          <option value="single">{{ 'option.opt-quotes.single' | pt }}</option>
          <option value="preserve">{{ 'option.opt-quotes.preserve' | pt }}</option>
        </select>
      </div>
    {% endcall %}

    <!-- tool-end -->

