---
layout: layouts/tool.njk
toolSlug: uuid-generator
permalink: /tools/uuid-generator/
extraCss: "/tools/uuid-generator/style.css"
lastReviewed: "2026-10-24"
---

<div class="tool-container uuid-container" aria-label="{{ 'ariaLabel.tool-div1' | pt }}">
  
  <!-- Quick Single UUID Section -->
  <div class="uuid-quick-box">
    <label for="quick-uuid-display" class="font-semibold">{{ 'label.quick-uuid-display' | pt }}</label>
    <div class="uuid-quick-row">
      <input type="text" id="quick-uuid-display" class="form-control uuid-display-input" readonly aria-label="{{ 'ariaLabel.quick-uuid-display' | pt }}">
      <button type="button" class="btn btn-primary" id="copy-single-btn" aria-label="{{ 'ariaLabel.copy-single-btn' | pt }}">{{ 'text.copy-single-btn' | pt }}</button>
      <button type="button" class="btn btn-secondary" id="regen-single-btn" aria-label="{{ 'ariaLabel.regen-single-btn' | pt }}">{{ 'text.regen-single-btn' | pt }}</button>
    </div>
  </div>

  <!-- Bulk Generation Controls -->
  <div class="uuid-options-grid">
    <div class="form-group mb-0">
      <label for="uuid-count" class="font-semibold text-sm">{{ 'label.uuid-count' | pt }}</label>
      <input type="number" id="uuid-count" class="form-control" min="1" max="100" value="5" aria-label="{{ 'ariaLabel.uuid-count' | pt }}">
    </div>

    <div class="form-group mb-0 flex flex-col justify-center gap-2">
      <label class="checkbox-label option-label text-sm">
        {{ 'content.tool.label1' | pt }}
      </label>
      <label class="checkbox-label option-label text-sm">
        {{ 'content.tool.label2' | pt }}
      </label>
      <label class="checkbox-label option-label text-sm">
        {{ 'content.tool.label3' | pt }}
      </label>
    </div>

    <div class="flex items-end">
      <button type="button" class="btn btn-primary w-full" id="generate-btn">
        {{ 'text.generate-btn' | pt }}
      </button>
    </div>
  </div>

  <!-- Error Alert Box -->
  <div id="error-box" class="alert alert-danger hidden" role="alert" aria-live="polite"></div>

  <!-- Bulk Output & Actions -->
  <div class="form-group">
    <div class="uuid-actions-row mb-3">
      <div class="flex items-center gap-3">
        <label for="bulk-output" class="font-semibold mb-0">{{ 'label.bulk-output' | pt }}</label>
        <span id="uuid-meta-count" class="uuid-meta-pill">{{ 'text.uuid-meta-count' | pt }}</span>
      </div>
      <div class="uuid-action-buttons">
        <button type="button" class="btn btn-secondary" id="copy-all-btn">
          {{ 'text.copy-all-btn' | pt }}
        </button>
        <button type="button" class="btn btn-secondary" id="download-txt-btn">
          {{ 'text.download-txt-btn' | pt }}
        </button>
      </div>
    </div>

    <textarea id="bulk-output" class="form-control uuid-bulk-output" readonly spellcheck="false" aria-label="{{ 'ariaLabel.bulk-output' | pt }}"></textarea>
  </div>

</div>


<!-- tool-end -->
