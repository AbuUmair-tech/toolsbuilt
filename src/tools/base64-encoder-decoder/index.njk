---
layout: layouts/tool.njk
toolSlug: base64-encoder-decoder
permalink: /tools/base64-encoder-decoder/
extraCss: /tools/base64-encoder-decoder/style.css
---

    <!-- Main Tool Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <div class="base64-controls-bar">
        <div class="mode-radio-group">
          <label class="mode-radio-label">
            {{ 'content.tool.label1' | pt }}
          </label>
          <label class="mode-radio-label">
            {{ 'content.tool.label2' | pt }}
          </label>
        </div>

        <div class="flex items-center gap-4">
          <label class="option-label text-sm">
            {{ 'content.tool.label3' | pt }}
          </label>
          <button type="button" class="btn btn-ghost btn-sm" id="clear-btn">{{ 'text.clear-btn' | pt }}</button>
        </div>
      </div>

      <div class="base64-editor-grid">
        <div class="form-group mb-0">
          <div class="row-between mb-2">
            <label for="base64-input" id="input-label" class="font-semibold">{{ 'label.base64-input' | pt }}</label>
            <span id="size-meter" class="text-sm text-secondary">{{ 'text.size-meter' | pt }}</span>
          </div>
          <textarea id="base64-input" class="base64-textarea" rows="10" placeholder="{{ 'placeholder.base64-input' | pt }}"></textarea>
        </div>

        <div class="form-group mb-0">
          <div class="row-between mb-2">
            <label for="base64-output" id="output-label" class="font-semibold">{{ 'label.base64-output' | pt }}</label>
          </div>
          <textarea id="base64-output" class="base64-textarea" rows="10" readonly placeholder="{{ 'placeholder.base64-output' | pt }}"></textarea>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="button-group cluster mt-4">
        <button type="button" class="btn btn-primary" id="convert-btn">{{ 'text.convert-btn' | pt }}</button>
        <button type="button" class="btn btn-secondary" id="swap-btn">
          {{ 'text.swap-btn' | pt }}
        </button>
        <button type="button" class="btn btn-secondary" id="copy-btn">
          {{ 'text.copy-btn' | pt }}
        </button>
      </div>

      <!-- Live Status & Error Alert Container -->
      <div id="base64-status" class="alert-box alert-info" hidden aria-live="polite"></div>
    </section>

    <!-- Critical Security Notice Callout -->
    <div class="tool-note">
      <h3 class="tool-note-title">
        {{ 'content.important-base64-is-encoding-not-encryption.heading' | pt }}
      </h3>
      <p>{{ 'content.important-base64-is-encoding-not-encryption.p1' | pt }}</p>
    </div>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section" aria-labelledby="how-to-use-heading">
      <h2 id="how-to-use-heading">{{ 'text.how-to-use-heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-base64.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-base64.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-base64.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-base64.li4' | pt }}</li>
      </ul>
    </section>

    <!-- Worked Examples & Standards Section -->
    <section class="content-section" aria-labelledby="article-heading">
      <h2 id="article-heading">{{ 'text.article-heading' | pt }}</h2>
      <p class="text-secondary">{{ 'content.base64-encoding-method-rfc-4648-worked.p1' | pt }}</p>

      <div class="content-grid">
        <div class="content-box">
          <h3 class="content-box-title">{{ 'content.rfc-4648-standard-vector-man.heading' | pt }}</h3>
          <p class="content-note">{{ 'content.rfc-4648-standard-vector-man.p1' | pt }}</p>
          <ul class="content-list content-list-sm">
            <li>{{ 'content.rfc-4648-standard-vector-man.li1' | pt }}</li>
            <li>{{ 'content.rfc-4648-standard-vector-man.li2' | pt }}</li>
            <li>{{ 'content.rfc-4648-standard-vector-man.li3' | pt }}</li>
            <li>{{ 'content.rfc-4648-standard-vector-man.li4' | pt }}</li>
            <li>{{ 'content.rfc-4648-standard-vector-man.li5' | pt }}</li>
          </ul>
        </div>

        <div class="content-box">
          <h3 class="content-box-title">{{ 'content.url-safe-substitution.heading' | pt }}</h3>
          <p class="content-note">{{ 'content.url-safe-substitution.p1' | pt }}</p>
          <ul class="content-list content-list-sm">
            <li>{{ 'content.url-safe-substitution.li1' | pt }}</li>
            <li>{{ 'content.url-safe-substitution.li2' | pt }}</li>
            <li>{{ 'content.url-safe-substitution.li3' | pt }}</li>
            <li>{{ 'content.url-safe-substitution.li4' | pt }}</li>
          </ul>
        </div>

        <div class="content-box">
          <h3 class="content-box-title">{{ 'content.multilingual-utf-8-handling.heading' | pt }}</h3>
          <p class="content-note">{{ 'content.multilingual-utf-8-handling.p1' | pt }}</p>
          <ul class="content-list content-list-sm">
            <li>{{ 'content.multilingual-utf-8-handling.li1' | pt }}</li>
            <li>{{ 'content.multilingual-utf-8-handling.li2' | pt }}</li>
            <li>{{ 'content.multilingual-utf-8-handling.li3' | pt }}</li>
            <li>{{ 'content.multilingual-utf-8-handling.li4' | pt }}</li>
          </ul>
        </div>
      </div>
    </section>

