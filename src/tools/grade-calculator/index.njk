---
layout: layouts/tool.njk
toolSlug: grade-calculator
permalink: /tools/grade-calculator/
lastReviewed: "2026-10-24"
---

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <form id="grade-calc-form" novalidate>
        
        <!-- Weighted Assignments Table -->
        <div class="overflow-x-auto mb-6">
          <table class="table table-min" aria-label="{{ 'ariaLabel.tool-table1' | pt }}">
            <thead>
              <tr class="text-left">
                <th scope="col" class="py-3 px-2 font-semibold text-sm">{{ 'content.tool.th1' | pt }}</th>
                <th scope="col" class="w-col-lg">{{ 'content.tool.th2' | pt }}</th>
                <th scope="col" class="w-col-lg">{{ 'content.tool.th3' | pt }}</th>
                <th scope="col" class="w-col-sm text-center">{{ 'content.tool.th4' | pt }}</th>
              </tr>
            </thead>
            <tbody id="assignments-tbody">
              <tr>
                <td class="table-cell-sm">
                  <input type="text" class="form-control assign-name" placeholder="{{ 'assignments.homework.placeholder' | pt }}" value="{{ 'assignments.homework.name' | pt }}" aria-label="{{ 'assignments.nameLabel' | pt }}">
                </td>
                <td class="table-cell-sm">
                  <input type="number" step="any" min="0" max="200" class="form-control assign-score" placeholder="95" value="95" required aria-label="{{ 'assignments.scoreLabel' | pt }}">
                </td>
                <td class="table-cell-sm">
                  <input type="number" step="any" min="0" max="100" class="form-control assign-weight" placeholder="20" value="20" required aria-label="{{ 'assignments.weightLabel' | pt }}">
                </td>
                <td class="table-cell-sm text-center">
                  <button type="button" class="btn btn-sm btn-ghost remove-row-btn" aria-label="{{ 'ariaLabel.tool-button1' | pt }}" title="{{ 'title.tool-button2' | pt }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </button>
                </td>
              </tr>
              <tr>
                <td class="table-cell-sm">
                  <input type="text" class="form-control assign-name" placeholder="{{ 'assignments.midterm.placeholder' | pt }}" value="{{ 'assignments.midterm.name' | pt }}" aria-label="{{ 'assignments.nameLabel' | pt }}">
                </td>
                <td class="table-cell-sm">
                  <input type="number" step="any" min="0" max="200" class="form-control assign-score" placeholder="82" value="82" required aria-label="{{ 'assignments.scoreLabel' | pt }}">
                </td>
                <td class="table-cell-sm">
                  <input type="number" step="any" min="0" max="100" class="form-control assign-weight" placeholder="25" value="25" required aria-label="{{ 'assignments.weightLabel' | pt }}">
                </td>
                <td class="table-cell-sm text-center">
                  <button type="button" class="btn btn-sm btn-ghost remove-row-btn" aria-label="{{ 'ariaLabel.tool-button3' | pt }}" title="{{ 'title.tool-button4' | pt }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </button>
                </td>
              </tr>
              <tr>
                <td class="table-cell-sm">
                  <input type="text" class="form-control assign-name" placeholder="{{ 'assignments.project.placeholder' | pt }}" value="{{ 'assignments.project.name' | pt }}" aria-label="{{ 'assignments.nameLabel' | pt }}">
                </td>
                <td class="table-cell-sm">
                  <input type="number" step="any" min="0" max="200" class="form-control assign-score" placeholder="90" value="90" required aria-label="{{ 'assignments.scoreLabel' | pt }}">
                </td>
                <td class="table-cell-sm">
                  <input type="number" step="any" min="0" max="100" class="form-control assign-weight" placeholder="15" value="15" required aria-label="{{ 'assignments.weightLabel' | pt }}">
                </td>
                <td class="table-cell-sm text-center">
                  <button type="button" class="btn btn-sm btn-ghost remove-row-btn" aria-label="{{ 'ariaLabel.tool-button5' | pt }}" title="{{ 'title.tool-button6' | pt }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </button>
                </td>
              </tr>
              <tr>
                <td class="table-cell-sm">
                  <input type="text" class="form-control assign-name" placeholder="{{ 'assignments.quizzes.placeholder' | pt }}" value="{{ 'assignments.quizzes.name' | pt }}" aria-label="{{ 'assignments.nameLabel' | pt }}">
                </td>
                <td class="table-cell-sm">
                  <input type="number" step="any" min="0" max="200" class="form-control assign-score" placeholder="88" value="88" required aria-label="{{ 'assignments.scoreLabel' | pt }}">
                </td>
                <td class="table-cell-sm">
                  <input type="number" step="any" min="0" max="100" class="form-control assign-weight" placeholder="10" value="10" required aria-label="{{ 'assignments.weightLabel' | pt }}">
                </td>
                <td class="table-cell-sm text-center">
                  <button type="button" class="btn btn-sm btn-ghost remove-row-btn" aria-label="{{ 'ariaLabel.tool-button7' | pt }}" title="{{ 'title.tool-button8' | pt }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <button type="button" class="btn btn-sm btn-secondary mb-6" id="add-assignment-btn">
          {{ 'text.add-assignment-btn' | pt }}
        </button>

        <!-- Final Exam Target Card -->
        <div class="panel-muted mb-6">
          <h3 class="text-base mt-0 mb-3 text-accent">{{ 'content.final-exam-target-setting.heading' | pt }}</h3>
          <div class="form-grid two-col">
            <div class="form-group">
              <label for="target-grade-val">{{ 'label.target-grade-val' | pt }}</label>
              <input type="number" step="any" min="0" max="100" id="target-grade-val" class="form-control" placeholder="{{ 'placeholder.target-grade-val' | pt }}" value="90" required aria-required="true">
            </div>
            <div class="form-group">
              <label for="final-weight-val">{{ 'label.final-weight-val' | pt }}</label>
              <input type="number" step="any" min="1" max="100" id="final-weight-val" class="form-control" placeholder="{{ 'placeholder.final-weight-val' | pt }}" value="30" required aria-required="true">
            </div>
          </div>
        </div>

        <div class="button-group">
          <button type="submit" class="btn btn-primary">{{ 'content.final-exam-target-setting.button1' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-grade-form">{{ 'text.reset-grade-form' | pt }}</button>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <!-- Result Box -->
      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          <span id="result-header-text">{{ 'text.result-header-text' | pt }}</span>
          <button type="button" class="btn btn-sm btn-ghost" id="copy-result-btn" title="{{ 'title.copy-result-btn' | pt }}" aria-label="{{ 'ariaLabel.copy-result-btn' | pt }}">
            {{ 'text.copy-result-btn' | pt }}
          </button>
        </div>
        <div class="result-primary" id="result-primary-text">{{ 'text.result-primary-text' | pt }}</div>
        
        <div class="result-grid" id="result-stats-grid">
          <!-- Populated by script.js -->
        </div>

        <div class="formula-box content-panel" id="formula-explanation">
          <!-- Populated by script.js -->
        </div>
      </div>
    </section>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section" aria-labelledby="how-to-use-heading">
      <h2 id="how-to-use-heading">{{ 'text.how-to-use-heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-grade.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-grade.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-grade.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-grade.li4' | pt }}</li>
      </ul>
    </section>

