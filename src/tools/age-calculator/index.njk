---
layout: layouts/tool.njk
toolSlug: age-calculator
permalink: /tools/age-calculator/
lastReviewed: "2026-10-24"
---

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <form id="calculator-form" novalidate>
        <div class="form-grid two-col">
          
          <div class="form-group">
            <label for="dob-date">{{ 'label.dob-date' | pt }}</label>
            <input type="date" id="dob-date" class="form-control" required aria-required="true">
          </div>

          <div class="form-group">
            <label for="target-date">{{ 'label.target-date' | pt }}</label>
            <input type="date" id="target-date" class="form-control" required aria-required="true">
          </div>

        </div>

        <fieldset class="mt-4 border rounded-md py-3 px-4">
          <legend class="text-sm font-medium py-0 px-2 text-secondary">{{ 'content.tool.legend1' | pt }}</legend>
          <div class="flex gap-6 flex-wrap mt-1 text-sm">
            <label class="inline-flex items-center gap-2 cursor-pointer">
              {{ 'content.tool.label1' | pt }}
            </label>
            <label class="inline-flex items-center gap-2 cursor-pointer">
              {{ 'content.tool.label2' | pt }}
            </label>
          </div>
        </fieldset>

        <div class="button-group mt-6">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button1' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-btn">{{ 'text.reset-btn' | pt }}</button>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <!-- Result Box -->
      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          <span id="result-header-text">{{ 'text.result-header-text' | pt }}</span>
          <button type="button" class="btn btn-sm btn-ghost" id="copy-result-btn" title="{{ 'title.copy-result-btn' | pt }}" aria-label="{{ 'ariaLabel.copy-result-btn' | pt }}">
            {{ 'text.copy-result-btn' | pt }}
          </button>
        </div>
        <div class="result-primary" id="result-primary-text">{{ 'text.result-primary-text' | pt }}</div>
        
        <div class="result-grid">
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div1' | pt }}</div>
            <div class="result-stat-value" id="stat-years-months-days">--</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div2' | pt }}</div>
            <div class="result-stat-value" id="stat-total-months">--</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div3' | pt }}</div>
            <div class="result-stat-value" id="stat-total-weeks">--</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div4' | pt }}</div>
            <div class="result-stat-value" id="stat-total-days">--</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div5' | pt }}</div>
            <div class="result-stat-value" id="stat-total-hours">--</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div6' | pt }}</div>
            <div class="result-stat-value" id="stat-next-birthday">--</div>
          </div>
        </div>
      </div>
    </section>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section">
      <h2>{{ 'content.how-when-to-use-the-exact.heading' | pt }}</h2>
      <p>{{ 'content.how-when-to-use-the-exact.p1' | pt }}</p>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-exact.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-exact.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-exact.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-exact.li4' | pt }}</li>
      </ul>
    </section>

    <!-- Key Facts & Milestones Reference Table -->
    <section class="content-section">
      <h2>{{ 'content.key-facts-age-milestones-reference.heading' | pt }}</h2>
      
      <div class="content-grid">
        <div>
          <h3>{{ 'content.astronomical-calendar-units.heading' | pt }}</h3>
          <ul class="content-list">
            <li>{{ 'content.astronomical-calendar-units.li1' | pt }}</li>
            <li>{{ 'content.astronomical-calendar-units.li2' | pt }}</li>
            <li>{{ 'content.astronomical-calendar-units.li3' | pt }}</li>
            <li>{{ 'content.astronomical-calendar-units.li4' | pt }}</li>
            <li>{{ 'content.astronomical-calendar-units.li5' | pt }}</li>
          </ul>
        </div>

        <div>
          <h3>{{ 'content.common-legal-age-milestones.heading' | pt }}</h3>
          <table class="w-full mt-2 text-sm">
            <thead>
              <tr class="table-head-row">
                <th class="table-cell-sm">{{ 'content.common-legal-age-milestones.th1' | pt }}</th>
                <th class="table-cell-sm">{{ 'content.common-legal-age-milestones.th2' | pt }}</th>
              </tr>
            </thead>
            <tbody>
              <tr class="row-divider">
                <td class="table-cell-sm font-semibold">{{ 'content.common-legal-age-milestones.td1' | pt }}</td>
                <td class="table-cell-sm">{{ 'content.common-legal-age-milestones.td2' | pt }}</td>
              </tr>
              <tr class="row-divider">
                <td class="table-cell-sm font-semibold">{{ 'content.common-legal-age-milestones.td3' | pt }}</td>
                <td class="table-cell-sm">{{ 'content.common-legal-age-milestones.td4' | pt }}</td>
              </tr>
              <tr class="row-divider">
                <td class="table-cell-sm font-semibold">{{ 'content.common-legal-age-milestones.td5' | pt }}</td>
                <td class="table-cell-sm">{{ 'content.common-legal-age-milestones.td6' | pt }}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
