---
layout: layouts/tool.njk
toolSlug: date-difference-calculator
permalink: /tools/date-difference-calculator/
lastReviewed: "2026-10-24"
---

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <form id="calculator-form" novalidate>
        <div class="form-grid two-col">
          
          <div class="form-group">
            <label for="start-date">{{ 'label.start-date' | pt }}</label>
            <input type="date" id="start-date" data-param="from" data-param-alias="start" class="form-control" required aria-required="true">
          </div>

          <div class="form-group">
            <label for="end-date">{{ 'label.end-date' | pt }}</label>
            <input type="date" id="end-date" data-param="to" data-param-alias="end" class="form-control" required aria-required="true">
          </div>

        </div>

        <div class="mt-6">
          <label class="inline-flex items-center gap-2 cursor-pointer text-base text-primary font-medium">
            {{ 'content.tool.label1' | pt }}
          </label>
        </div>

        <div class="button-group mt-6">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button1' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-btn">{{ 'text.reset-btn' | pt }}</button>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <!-- Result Box -->
      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          <span id="result-header-text">{{ 'text.result-header-text' | pt }}</span>
          <button type="button" class="btn btn-sm btn-ghost" id="copy-result-btn" title="{{ 'title.copy-result-btn' | pt }}" aria-label="{{ 'ariaLabel.copy-result-btn' | pt }}">
            {{ 'text.copy-result-btn' | pt }}
          </button>
        </div>
        <div class="result-primary" id="result-primary-text">{{ 'text.result-primary-text' | pt }}</div>
        
        <div class="result-grid">
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div1' | pt }}</div>
            <div class="result-stat-value" id="stat-total-days">--</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div2' | pt }}</div>
            <div class="result-stat-value" id="stat-business-days">--</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div3' | pt }}</div>
            <div class="result-stat-value" id="stat-ymd">--</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div4' | pt }}</div>
            <div class="result-stat-value" id="stat-weeks-days">--</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div5' | pt }}</div>
            <div class="result-stat-value" id="stat-months-days">--</div>
          </div>
        </div>
      </div>
    </section>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section">
      <h2>{{ 'content.how-when-to-use-the-date.heading' | pt }}</h2>
      <p>{{ 'content.how-when-to-use-the-date.p1' | pt }}</p>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-date.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-date.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-date.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-date.li4' | pt }}</li>
      </ul>
    </section>
