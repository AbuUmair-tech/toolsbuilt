---
layout: layouts/tool.njk
toolSlug: lorem-ipsum-generator
permalink: /tools/lorem-ipsum-generator/
extraCss: /tools/lorem-ipsum-generator/style.css
---

    <!-- Main Tool Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <div class="lorem-controls-bar">
        <div class="flex items-center gap-3">
          <label for="count-input" class="font-semibold">{{ 'label.count-input' | pt }}</label>
          <input type="number" id="count-input" class="form-control w-col-md text-center font-semibold" value="3" min="1" max="50">
        </div>

        <div class="lorem-unit-group">
          <label class="lorem-unit-label">
            {{ 'content.tool.label1' | pt }}
          </label>
          <label class="lorem-unit-label">
            {{ 'content.tool.label2' | pt }}
          </label>
          <label class="lorem-unit-label">
            {{ 'content.tool.label3' | pt }}
          </label>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <label class="option-label text-sm">
            {{ 'content.tool.label4' | pt }}
          </label>
          <label class="option-label text-sm">
            {{ 'content.tool.label5' | pt }}
          </label>
        </div>
      </div>

      <div class="form-group mb-0">
        <label for="lorem-output" class="font-semibold mb-1 block">{{ 'label.lorem-output' | pt }}</label>
        <textarea id="lorem-output" class="lorem-textarea" rows="12" placeholder="{{ 'placeholder.lorem-output' | pt }}"></textarea>
      </div>

      <div class="lorem-stats-bar" aria-live="polite">
        {{ 'content.tool.div1' | pt }}
      </div>

      <!-- Action Buttons -->
      <div class="button-group cluster mt-4">
        <button type="button" class="btn btn-primary" id="generate-btn">
          {{ 'text.generate-btn' | pt }}
        </button>
        <button type="button" class="btn btn-secondary" id="copy-btn">
          {{ 'text.copy-btn' | pt }}
        </button>
        <button type="button" class="btn btn-ghost" id="clear-btn">{{ 'text.clear-btn' | pt }}</button>
      </div>
    </section>

    <!-- tool-end -->

    <!-- When to Use Section -->
    <section class="content-section" aria-labelledby="how-to-use-heading">
      <h2 id="how-to-use-heading">{{ 'text.how-to-use-heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-lorem.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-lorem.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-lorem.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-lorem.li4' | pt }}</li>
      </ul>
    </section>

    <!-- Worked Examples & Origins Section -->
    <section class="content-section" aria-labelledby="article-heading">
      <h2 id="article-heading">{{ 'text.article-heading' | pt }}</h2>
      <p class="text-secondary">{{ 'content.the-origins-meaning-variations-of-lorem.p1' | pt }}</p>

      <div class="content-grid">
        <div class="content-box">
          <h3 class="content-box-title">{{ 'content.canonical-latin-opening.heading' | pt }}</h3>
          <p class="content-note">{{ 'content.canonical-latin-opening.p1' | pt }}</p>
          <p class="text-sm text-secondary leading-normal">{{ 'content.canonical-latin-opening.p2' | pt }}</p>
        </div>

        <div class="content-box">
          <h3 class="content-box-title">{{ 'content.original-cicero-translation.heading' | pt }}</h3>
          <p class="content-note">{{ 'content.original-cicero-translation.p1' | pt }}</p>
          <p class="text-sm text-secondary leading-normal">{{ 'content.original-cicero-translation.p2' | pt }}</p>
        </div>

        <div class="content-box">
          <h3 class="content-box-title">{{ 'content.natural-word-distribution.heading' | pt }}</h3>
          <p class="content-note">{{ 'content.natural-word-distribution.p1' | pt }}</p>
          <ul class="content-list content-list-sm">
            <li>{{ 'content.natural-word-distribution.li1' | pt }}</li>
            <li>{{ 'content.natural-word-distribution.li2' | pt }}</li>
            <li>{{ 'content.natural-word-distribution.li3' | pt }}</li>
          </ul>
        </div>
      </div>
    </section>

