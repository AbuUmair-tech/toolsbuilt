h1: "Loan EMI Calculator"
extraCss: "/tools/loan-emi-calculator/style.css"
howto:
  name: "How to Calculate Loan EMI and Amortization"
  description: "Step-by-step instructions for calculating monthly loan payments, interest charges, and accelerated payoff schedules."
  steps:
    - name: "Select Currency & Loan Amount"
      text: "Choose your currency symbol and enter the total principal borrowed."
    - name: "Enter Annual Interest Rate"
      text: "Input the annual interest rate (APR) charged by your lender."
    - name: "Specify Loan Tenure"
      text: "Enter your repayment duration and toggle between years or months."
