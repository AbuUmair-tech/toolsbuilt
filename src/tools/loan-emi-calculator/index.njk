---
layout: layouts/tool.njk
toolSlug: loan-emi-calculator
permalink: /tools/loan-emi-calculator/
extraCss: "/tools/loan-emi-calculator/style.css"
---
{% from "partials/currency-select.njk" import currencySelect, countryData with context %}
{{ countryData(countries) }}

    <!-- Tool Form Container -->
    <section class="tool-container" aria-label="{{ 'ariaLabel.tool-section1' | pt }}">
      <form id="calculator-form" novalidate>
        <div class="form-grid two-col">
          
          {{ currencySelect({ id: "currency-select", param: "cur", selected: "USD" }) }}

          <div class="form-group">
            <label for="loan-amount">{{ 'label.loan-amount' | pt }}</label>
            <input type="number" step="any" min="1" id="loan-amount" data-param="amount" class="form-control" placeholder="{{ 'placeholder.loan-amount' | pt }}" required aria-required="true">
          </div>

          <div class="form-group">
            <label for="interest-rate">{{ 'label.interest-rate' | pt }}</label>
            <input type="number" step="0.01" min="0" max="100" id="interest-rate" data-param="rate" class="form-control" placeholder="{{ 'placeholder.interest-rate' | pt }}" required aria-required="true">
          </div>

          <div class="form-group">
            <label for="tenure-value">{{ 'label.tenure-value' | pt }}</label>
            <div class="loan-input-row">
              <input type="number" step="1" min="1" max="600" id="tenure-value" data-param="tenure" class="form-control" placeholder="{{ 'placeholder.tenure-value' | pt }}" required aria-required="true">
              <select id="tenure-unit" data-param="unit" class="form-control" aria-label="{{ 'ariaLabel.tenure-unit' | pt }}">
                <option value="years" selected>{{ 'option.tenure-unit.years' | pt }}</option>
                <option value="months">{{ 'option.tenure-unit.months' | pt }}</option>
              </select>
            </div>
          </div>

          <div class="form-group col-span-full">
            <label for="extra-payment">{{ 'label.extra-payment' | pt }}</label>
            <input type="number" step="any" min="0" id="extra-payment" data-param="extra" class="form-control" placeholder="{{ 'placeholder.extra-payment' | pt }}">
          </div>

        </div>

        <div class="button-group mt-6">
          <button type="submit" class="btn btn-primary">{{ 'content.tool.button1' | pt }}</button>
          <button type="button" class="btn btn-secondary" id="reset-btn">{{ 'text.reset-btn' | pt }}</button>
        </div>
      </form>

      <div id="error-box" class="hidden form-error" role="alert"></div>

      <!-- Result Box -->
      <div id="result-box" class="result-box is-visible" aria-live="polite">
        <div class="result-header">
          <span id="result-header-text">{{ 'text.result-header-text' | pt }}</span>
          <button type="button" class="btn btn-sm btn-ghost" id="copy-result-btn" title="{{ 'title.copy-result-btn' | pt }}" aria-label="{{ 'ariaLabel.copy-result-btn' | pt }}">
            {{ 'text.copy-result-btn' | pt }}
          </button>
        </div>
        <div class="result-primary" id="result-primary-text">{{ 'text.result-primary-text' | pt }}</div>
        
        <div class="result-grid">
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div1' | pt }}</div>
            <div class="result-stat-value" id="stat-monthly-emi">$0.00</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div2' | pt }}</div>
            <div class="result-stat-value" id="stat-total-interest">$0.00</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div3' | pt }}</div>
            <div class="result-stat-value" id="stat-total-payment">$0.00</div>
          </div>
          <div class="result-stat-card">
            <div class="result-stat-label">{{ 'content.tool.div4' | pt }}</div>
            <div class="result-stat-value" id="stat-tenure">{{ 'text.stat-tenure' | pt }}</div>
          </div>
        </div>

        <!-- Extra Monthly Payment Accelerated Card -->
        <div id="extra-savings-card" class="hidden panel-muted mt-6">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <h3 class="m-0 text-base text-accent">{{ 'content.extra-payment-payoff-accelerator.heading' | pt }}</h3>
            <span class="extra-savings-badge">
              {{ 'content.extra-payment-payoff-accelerator.span1' | pt }}
            </span>
          </div>
          <div class="result-grid mt-4">
            <div class="result-stat-card">
              <div class="result-stat-label">{{ 'content.extra-payment-payoff-accelerator.div1' | pt }}</div>
              <div class="result-stat-value text-success" id="stat-extra-saved">$0.00</div>
            </div>
            <div class="result-stat-card">
              <div class="result-stat-label">{{ 'content.extra-payment-payoff-accelerator.div2' | pt }}</div>
              <div class="result-stat-value" id="stat-months-saved">{{ 'text.stat-months-saved' | pt }}</div>
            </div>
            <div class="result-stat-card col-span-full">
              <div class="result-stat-label">{{ 'content.extra-payment-payoff-accelerator.div3' | pt }}</div>
              <div class="result-stat-value text-md" id="stat-new-tenure">{{ 'text.stat-new-tenure' | pt }}</div>
            </div>
          </div>
        </div>

        <!-- Full Amortization Table -->
        <div class="amortization-container">
          <div class="amortization-header">
            <div>
              <h3 class="amortization-title">{{ 'content.full-loan-amortization-schedule.heading' | pt }}</h3>
              <p class="mt-1 mb-0 text-sm text-secondary">{{ 'content.full-loan-amortization-schedule.p1' | pt }}</p>
            </div>
            <div class="amortization-actions">
              <button type="button" class="btn btn-sm btn-secondary" id="download-csv-btn">
                {{ 'text.download-csv-btn' | pt }}
              </button>
            </div>
          </div>
          <div class="amortization-scroll" tabindex="0" role="region" aria-label="{{ 'ariaLabel.full-loan-amortization-schedule-div1' | pt }}">
            <table class="amortization-table" aria-label="{{ 'ariaLabel.full-loan-amortization-schedule-table1' | pt }}">
              <thead>
                <tr>
                  <th>{{ 'content.full-loan-amortization-schedule.th1' | pt }}</th>
                  <th>{{ 'content.full-loan-amortization-schedule.th2' | pt }}</th>
                  <th>{{ 'content.full-loan-amortization-schedule.th3' | pt }}</th>
                  <th>{{ 'content.full-loan-amortization-schedule.th4' | pt }}</th>
                  <th>{{ 'content.full-loan-amortization-schedule.th5' | pt }}</th>
                  <th>{{ 'content.full-loan-amortization-schedule.th6' | pt }}</th>
                </tr>
              </thead>
              <tbody id="amortization-table-body">
                <!-- Rows populated by script.js -->
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- tool-end -->

    <!-- Reusable Financial Disclaimer -->
    {% include "partials/financial-disclaimer.njk" %}

    <!-- When to Use Section -->
    <section class="content-section" aria-labelledby="how-to-use-heading">
      <h2 id="how-to-use-heading">{{ 'text.how-to-use-heading' | pt }}</h2>
      <ul class="content-list">
        <li>{{ 'content.how-when-to-use-the-loan.li1' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-loan.li2' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-loan.li3' | pt }}</li>
        <li>{{ 'content.how-when-to-use-the-loan.li4' | pt }}</li>
      </ul>
    </section>

