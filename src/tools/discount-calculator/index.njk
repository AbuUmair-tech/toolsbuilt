            <input type="number" step="any" id="stacked-discount-percent" class="form-control" placeholder="e.g. 10">
          </div>

          <div class="form-group">
            <label for="tax-percent">Sales Tax (%) <span style="font-weight: normal; color: var(--text-muted);">(Optional)</span></label>
